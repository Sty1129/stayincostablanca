        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.7"
        d="M7 10h9.5a2.5 2.5 0 012.5 2.5V14h-4v-1H9v2.25H5V12a2 2 0 012-2z"
      />
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.7"
        d="M17 17.25c-1.15 1.45-1.75 2.35-1.75 3.15a1.75 1.75 0 003.5 0c0-.8-.6-1.7-1.75-3.15z"
      />
    `,
  },

  {
    title: "AER CONDIȚIONAT",
    description:
      "Verificările funcționale periodice pot evidenția schimbări care necesită atenție.",
    // Air conditioning unit + airflow
    icon: `
      <rect
        x="3.5"
        y="4.5"
        width="17"
        height="7.5"
        rx="2"
        stroke-width="1.7"
      />
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.7"
        d="M7 8.25h10"
      />
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.7"
        d="M8 12.25c0 1.1-.7 1.75-1.75 2.5-.95.7-1.5 1.4-1.5 2.5"
      />
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.7"
        d="M12 12.25c0 1.15-.75 1.85-1.75 2.6-.95.7-1.5 1.4-1.5 2.65"
      />
