  },

  {
    title: "VREME SEVERĂ",
    description:
      "Ploile abundente, vântul și furtunile pot afecta terasele, drenajul sau exteriorul proprietății.",
    // Storm cloud + rain + wind
    icon: `
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.7"
        d="M6.5 15.5h10.75a3.25 3.25 0 00.3-6.49A5.2 5.2 0 007.4 7.8 3.75 3.75 0 006.5 15.5z"
