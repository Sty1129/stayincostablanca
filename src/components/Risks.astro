    // Envelope + document
    icon: `
      <rect
        x="3.5"
        y="7"
        width="13.5"
        height="10"
        rx="2"
        stroke-width="1.7"
      />
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.7"
        d="M4.25 8l5.55 4.2a1.5 1.5 0 001.8 0L16.5 8"
      />
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.7"
        d="M14.5 4h4a2 2 0 012 2v9.5"
      />
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.7"
        d="M16.5 7h2M16.5 10h2"
      />
    `,
  },

  {
    title: "INTERVENȚII LOCALE",
    description:
      "Dacă apare o problemă, este important să existe cineva care cunoaște deja proprietatea.",
    // House + key
    icon: `
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.7"
        d="M3.5 11L12 4l8.5 7"
      />
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.7"
        d="M5.5 10v9h8"
      />
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.7"
        d="M9 19v-5h4"
      />
      <circle
        cx="17.25"
        cy="15.75"
        r="2.25"
        stroke-width="1.7"
      />
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.7"
        d="M18.85 17.35L21 19.5M20 18.5l1-1M19 17.5l1-1"
      />
    `,
  },
];
---

<section
  class="py-14 sm:py-16 md:py-20 bg-background font-heading border-b border-border"
>
  <div class="mx-auto max-w-site px-4 sm:px-6">

    <!-- Titlu & introducere -->
    <div class="text-center max-w-4xl mx-auto mb-10 sm:mb-14 md:mb-16">

      <h2
        class="text-[28px] sm:text-4xl lg:text-[42px] font-bold text-[#0E3846] tracking-tight uppercase leading-[1.12]"
      >
        O proprietate nelocuită se poate schimba fără să observi.
      </h2>

      <p
        class="mt-5 sm:mt-6 text-base sm:text-lg text-[#405963] leading-7 sm:leading-8 max-w-3xl mx-auto"
      >
        O scurgere minoră, umiditatea persistentă, o problemă la aerul
        condiționat sau efectele unei furtuni pot rămâne neobservate săptămâni
        întregi atunci când proprietarul este departe.
      </p>

    </div>

    <!-- Grid riscuri -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">

      {risks.map((risk) => (

        <article
          class="
            bg-surface
            p-6 sm:p-7
            rounded-xl
            border border-[#CCD9DE]
            shadow-[0_2px_6px_rgba(14,56,70,0.07)]
            hover:shadow-[0_7px_20px_rgba(14,56,70,0.11)]
            hover:-translate-y-[2px]
            transition-all
            duration-300
          "
        >

          <!-- Icon -->
          <div
            class="
              mb-5
              flex
              items-center
              justify-center
              w-14
              h-14
              rounded-full
              bg-[#EAF4F6]
              border
              border-[#C5DCE3]
            "
          >
            <svg
              class="w-[30px] h-[30px] text-[#0E3846]"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <Fragment set:html={risk.icon} />
            </svg>
          </div>

          <!-- Titlu card -->
          <h3
            class="
              text-lg
              sm:text-xl
              font-bold
              text-[#0E3846]
              tracking-[0.02em]
              leading-snug
              mb-3
            "
          >
            {risk.title}
          </h3>

          <!-- Descriere -->
          <p
            class="
              text-base
              sm:text-[17px]
              text-[#334E59]
              leading-7
              font-normal
            "
          >
            {risk.description}
          </p>

        </article>

      ))}

    </div>

  </div>
</section>
