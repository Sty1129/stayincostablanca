---
// src/components/ReportMockup.astro
//
// Uses the existing logo from:
// public/sicb.png

const currentLang = Astro.currentLocale || 'ro';

const lang =
  currentLang === 'en' || currentLang === 'es'
    ? currentLang
    : 'ro';

const translations = {
  ro: {
    eyebrow: 'Raportare digitală',
    heading: 'Fiecare vizită lasă o urmă digitală.',
    intro:
      'Nu primești doar o confirmare că totul este în regulă. Primești un raport structurat, cu status pentru zonele verificate, fotografii, valori relevante și recomandări clare.',

    points: [
      'Verificare punct cu punct: acces, utilități, climat și exterior',
      'Fotografii documentate la fiecare vizită',
      'Valori și observații comparabile în timp',
      'Recomandări clare atunci când ceva necesită atenție',
    ],

    reportLabel: 'Raport vizită proprietate',
    property: 'Apartament · Orihuela Costa',
    date: '14 august 2026 · 10:42',
    overall: '1 DE MONITORIZAT',

    access: 'Acces & securitate',
    water: 'Apă',
    electricity: 'Electricitate',
    ac: 'Aer condiționat',
    indoorClimate: 'Climat interior',
    exterior: 'Exterior',
    warning: 'ATENȚIE',

    humidity: 'Umiditate relativă',
    before: 'înainte',
    afterVentilation: 'după ventilație',

    waterMeter: 'Contor apă',
    meterNote: 'Fără variații neobișnuite',

    photosAttached: 'Fotografii atașate',
    photosCount: '8 fotografii',

    recommendationLabel: 'Recomandare:',
    recommendation: 'monitorizare la următoarea vizită.',

    digitalReport: 'raport digital',
  },

  en: {
    eyebrow: 'Digital reporting',
    heading: 'Every visit leaves a digital record.',
    intro:
      'You receive more than a simple confirmation that everything is fine. You receive a structured report with the status of the areas checked, photographs, relevant readings and clear recommendations.',

    points: [
      'Point-by-point checks: access, utilities, indoor climate and exterior',
      'Documented photographs at every visit',
      'Readings and observations that can be compared over time',
      'Clear recommendations when something requires attention',
    ],

    reportLabel: 'Property visit report',
    property: 'Apartment · Orihuela Costa',
    date: '14 August 2026 · 10:42',
    overall: '1 TO MONITOR',

    access: 'Access & security',
    water: 'Water',
    electricity: 'Electricity',
    ac: 'Air conditioning',
    indoorClimate: 'Indoor climate',
    exterior: 'Exterior',
    warning: 'ATTENTION',

    humidity: 'Relative humidity',
    before: 'before',
    afterVentilation: 'after ventilation',

    waterMeter: 'Water meter',
    meterNote: 'No unusual variations',

    photosAttached: 'Attached photographs',
    photosCount: '8 photographs',

    recommendationLabel: 'Recommendation:',
    recommendation: 'monitor again at the next visit.',

    digitalReport: 'digital report',
  },

  es: {
    eyebrow: 'Informes digitales',
    heading: 'Cada visita deja un registro digital.',
    intro:
      'No recibes solo una confirmación de que todo está bien. Recibes un informe estructurado con el estado de las zonas revisadas, fotografías, valores relevantes y recomendaciones claras.',

    points: [
      'Revisión punto por punto: acceso, suministros, clima interior y exterior',
      'Fotografías documentadas en cada visita',
      'Valores y observaciones comparables a lo largo del tiempo',
      'Recomendaciones claras cuando algo requiere atención',
    ],

    reportLabel: 'Informe de visita de la propiedad',
    property: 'Apartamento · Orihuela Costa',
    date: '14 de agosto de 2026 · 10:42',
    overall: '1 PARA MONITORIZAR',

    access: 'Acceso y seguridad',
    water: 'Agua',
    electricity: 'Electricidad',
    ac: 'Aire acondicionado',
    indoorClimate: 'Clima interior',
    exterior: 'Exterior',
    warning: 'ATENCIÓN',

    humidity: 'Humedad relativa',
    before: 'antes',
    afterVentilation: 'después de ventilar',

    waterMeter: 'Contador de agua',
    meterNote: 'Sin variaciones inusuales',

    photosAttached: 'Fotografías adjuntas',
    photosCount: '8 fotografías',

    recommendationLabel: 'Recomendación:',
    recommendation: 'monitorizar de nuevo en la próxima visita.',

    digitalReport: 'informe digital',
  },
};

const t = translations[lang];
---

<section id="raport-digital" class="report-section">
  <div class="report-container">

    <!-- =====================================================
         TEXT / EXPLICAȚIE
    ====================================================== -->
    <div class="intro">

      <span class="eyebrow">{t.eyebrow}</span>

      <h2>{t.heading}</h2>

      <p class="intro-copy">
        {t.intro}
      </p>

      <ul class="intro-points">

        <li>
          <span class="dot"></span>
          <span>
            {t.points[0]}
          </span>
        </li>

        <li>
          <span class="dot"></span>
          <span>
            {t.points[1]}
          </span>
        </li>

        <li>
          <span class="dot"></span>
          <span>
            {t.points[2]}
          </span>
        </li>

        <li>
          <span class="dot"></span>
          <span>
            {t.points[3]}
          </span>
        </li>

      </ul>

    </div>


    <!-- =====================================================
         RAPORT
    ====================================================== -->
    <div class="card-wrap">

      <div class="report-card">

        <!-- =================================================
             HEADER RAPORT
        ================================================== -->
        <div class="card-head">

          <div class="report-identification">

            <!-- LOGO REAL -->
            <img
              src="/sicb.png"
              alt="Stay in Costa Blanca"
              class="report-logo"
            />

            <div class="id">
              <span class="mono-label">
                {t.reportLabel}
              </span>

              <h3>{t.property}</h3>

              <span class="meta">
                {t.date}
              </span>
            </div>

          </div>

          <span class="badge-overall">
            {t.overall}
          </span>

        </div>


        <!-- =================================================
             CHECKLIST
        ================================================== -->
        <div class="checklist">

          <div class="row">
            <span class="label">{t.access}</span>
            <span class="status ok">OK</span>
          </div>

          <div class="row">
            <span class="label">{t.water}</span>
            <span class="status ok">OK</span>
          </div>

          <div class="row">
            <span class="label">{t.electricity}</span>
            <span class="status ok">OK</span>
          </div>

          <div class="row">
            <span class="label">{t.ac}</span>
            <span class="status ok">OK</span>
          </div>

          <div class="row">
            <span class="label">{t.indoorClimate}</span>
            <span class="status warn">{t.warning}</span>
          </div>

          <div class="row">
            <span class="label">{t.exterior}</span>
            <span class="status ok">OK</span>
          </div>

        </div>


        <div class="divider"></div>


        <!-- =================================================
             UMIDITATE
        ================================================== -->
        <div class="humidity">

          <div class="block-label">
            {t.humidity}
          </div>

          <div class="humidity-bars">

            <div class="hbar before">

              <span class="val">63%</span>

              <div class="track">
                <div class="fill"></div>
              </div>

              <span class="tag">
                {t.before}
              </span>

            </div>


            <div class="humidity-arrow">
              ↓ 8%
            </div>


            <div class="hbar after">

              <span class="val">55%</span>

              <div class="track">
                <div class="fill"></div>
              </div>

              <span class="tag">
                {t.afterVentilation}
              </span>

            </div>

          </div>

        </div>


        <!-- =================================================
             CONTOR
        ================================================== -->
        <div class="meter-row">

          <span class="meter-icon">

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.7"
                d="M12 3.5c-2.7 3.5-5 6.3-5 9.2a5 5 0 0010 0c0-2.9-2.3-5.7-5-9.2z"
              />
            </svg>

          </span>

          <span class="meter-text">

            <b>{t.waterMeter}</b>

            <span>
              {t.meterNote}
            </span>

          </span>

        </div>


        <!-- =================================================
             FOTOGRAFII
        ================================================== -->
        <div class="photos">

          <div class="block-label">
            {t.photosAttached}
          </div>


          <div class="photo-grid">

            <!-- Living room -->
            <div class="photo-thumb living">
              <span class="window"></span>
              <span class="sofa"></span>
            </div>

            <!-- Kitchen -->
            <div class="photo-thumb kitchen">
              <span class="cabinet"></span>
              <span class="counter"></span>
            </div>

            <!-- Bathroom -->
            <div class="photo-thumb bathroom">
              <span class="mirror"></span>
              <span class="basin"></span>
            </div>

            <!-- Terrace -->
            <div class="photo-thumb terrace">
              <span class="sky"></span>
              <span class="wall"></span>
              <span class="floor"></span>
            </div>

            <!-- Meter -->
            <div class="photo-thumb meter">
              <span class="meterbox"></span>
              <span class="meterdisplay"></span>
            </div>

            <!-- AC -->
            <div class="photo-thumb ac">
              <span class="acunit"></span>
              <span class="acwall"></span>
            </div>

            <!-- Entrance -->
            <div class="photo-thumb entrance">
              <span class="door"></span>
              <span class="entrywall"></span>
            </div>

            <!-- Exterior -->
            <div class="photo-thumb exterior">
              <span class="extsky"></span>
              <span class="building"></span>
              <span class="ground"></span>
            </div>

          </div>


          <div class="photos-count">
            {t.photosCount}
          </div>

        </div>


        <!-- =================================================
             RECOMANDARE
        ================================================== -->
        <div class="recommendation">

          <span class="dot-icon"></span>

          <p>
            <b>{t.recommendationLabel}</b>
            {t.recommendation}
          </p>

        </div>


        <!-- =================================================
             FOOTER RAPORT
        ================================================== -->
        <div class="card-foot">

          <span class="brand">

            <img
              src="/sicb.png"
              alt=""
              class="footer-logo"
            />

            Stay in Costa Blanca

          </span>

          <span class="stamp">
            {t.digitalReport}
          </span>

        </div>

      </div>

    </div>

  </div>
</section>


<style>

  /* =========================================================
     BRAND
  ========================================================= */

  .report-section {
    --dark-ocean: #0E3846;
    --med-blue: #5B9EB5;
    --gold: #D99B26;

    --ok: #5EB984;
    --ok-bg: rgba(94,185,132,.13);
    --ok-border: rgba(94,185,132,.34);

    --warn: #D99B26;
    --warn-bg: rgba(217,155,38,.14);
    --warn-border: rgba(217,155,38,.38);

    --paper: #F7F5EF;
    --paper-2: #F2EFE9;

    --ink: #17343C;
    --ink-soft: #536A71;

    --line: rgba(14,56,70,.13);

    background:
      radial-gradient(
        ellipse 900px 500px at 15% -10%,
        rgba(91,158,181,.28),
        transparent 60%
      ),
      radial-gradient(
        ellipse 700px 500px at 90% 110%,
        rgba(217,155,38,.10),
        transparent 60%
      ),
      linear-gradient(
        160deg,
        #081E25 0%,
        #0E3846 62%,
        #164B5A 100%
      );

    padding: 72px 20px;

    font-family: inherit;

    border-bottom: 1px solid rgba(255,255,255,.08);
  }


  .report-container {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;

    display: grid;
    grid-template-columns: .86fr 1.14fr;
    gap: 64px;

    align-items: center;
  }


  /* =========================================================
     INTRO
  ========================================================= */

  .intro {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }


  .eyebrow {
    font-size: 14px;
    font-weight: 700;

    letter-spacing: .16em;
    text-transform: uppercase;

    color: #F3C76B;

    display: flex;
    align-items: center;
    gap: 11px;
  }


  .eyebrow::before {
    content: '';

    width: 25px;
    height: 2px;

    background: #D99B26;

    display: inline-block;
  }


  .intro h2 {
    font-size: clamp(30px, 3.4vw, 42px);
    font-weight: 700;

    line-height: 1.15;

    margin: 0;

    color: #fff;

    letter-spacing: -.015em;
  }


  .intro-copy {
    font-size: 17px;
    line-height: 1.75;

    color: #D2E2E5;

    margin: 0;

    max-width: 42ch;
  }


  .intro-points {
    list-style: none;

    padding: 0;
    margin: 7px 0 0;

    display: flex;
    flex-direction: column;

    gap: 14px;
  }


  .intro-points li {
    display: flex;

    gap: 12px;

    align-items: flex-start;

    font-size: 16px;

    color: #DCE9EB;

    line-height: 1.6;
  }


  .intro-points .dot {
    flex: none;

    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: #D99B26;

    margin-top: 9px;
  }


  /* =========================================================
     CARD WRAPPER
  ========================================================= */

  .card-wrap {
    position: relative;

    display: flex;
    justify-content: center;

    perspective: 1400px;
  }


  .card-wrap::before {
    content: '';

    position: absolute;

    width: 86%;
    height: 90%;

    top: 6%;

    background:
      radial-gradient(
        ellipse at center,
        rgba(217,155,38,.22),
        transparent 70%
      );

    filter: blur(30px);

    z-index: 0;
  }


  /* =========================================================
     REPORT CARD
  ========================================================= */

  .report-card {
    position: relative;

    z-index: 1;

    width: 100%;
    max-width: 430px;

    background: var(--paper);

    border-radius: 20px;

    padding: 26px 24px 22px;

    box-shadow:
      0 30px 60px -20px rgba(0,0,0,.55),
      0 10px 24px -12px rgba(0,0,0,.4),
      0 0 0 1px rgba(255,255,255,.06);

    transform: rotate(1deg);

    color: var(--ink);
  }


  .report-card::before {
    content: '';

    position: absolute;

    left: 0;
    top: 22px;
    bottom: 22px;

    width: 5px;

    border-radius: 0 4px 4px 0;

    background:
      linear-gradient(
        180deg,
        var(--med-blue),
        var(--gold)
      );
  }


  /* =========================================================
     HEADER
  ========================================================= */

  .card-head {
    display: flex;

    justify-content: space-between;
    align-items: flex-start;

    gap: 12px;

    padding-bottom: 14px;
    margin-bottom: 14px;

    border-bottom: 1px solid var(--line);
  }


  .report-identification {
    display: flex;

    align-items: flex-start;

    gap: 10px;

    min-width: 0;
  }


  .report-logo {
    width: 42px;
    height: 42px;

    object-fit: contain;

    flex: none;
  }


  .id {
    display: flex;
    flex-direction: column;

    gap: 3px;
  }


  .mono-label {
    font-size: 10px;

    font-weight: 700;

    letter-spacing: .1em;

    text-transform: uppercase;

    color: var(--ink-soft);
  }


  .card-head h3 {
    font-size: 16px;

    margin: 0;

    font-weight: 700;

    color: var(--ink);
  }


  .meta {
    font-size: 12px;

    color: var(--ink-soft);

    margin-top: 2px;
  }


  .badge-overall {
    font-size: 10px;

    font-weight: 700;

    padding: 6px 9px;

    border-radius: 100px;

    background: var(--warn-bg);

    color: #80570D;

    border: 1px solid var(--warn-border);

    white-space: nowrap;
  }


  /* =========================================================
     CHECKLIST
  ========================================================= */

  .checklist {
    display: flex;
    flex-direction: column;

    gap: 2px;

    margin-bottom: 16px;
  }


  .row {
    display: flex;

    align-items: center;
    justify-content: space-between;

    padding: 8px 4px;
  }


  .row .label {
    font-size: 13.5px;

    color: var(--ink);

    font-weight: 500;
  }


  .status {
    font-size: 10.5px;

    font-weight: 700;

    letter-spacing: .03em;

    padding: 3px 9px;

    border-radius: 100px;
  }


  .status.ok {
    background: var(--ok-bg);

    color: #23653F;

    border: 1px solid var(--ok-border);
  }


  .status.warn {
    background: var(--warn-bg);

    color: #80570D;

    border: 1px solid var(--warn-border);
  }


  .divider {
    height: 1px;

    background: var(--line);

    margin: 14px 0;
  }


  .block-label {
    font-size: 10.5px;

    font-weight: 700;

    letter-spacing: .08em;

    text-transform: uppercase;

    color: var(--ink-soft);

    margin-bottom: 9px;
  }


  /* =========================================================
     HUMIDITY
  ========================================================= */

  .humidity {
    margin-bottom: 16px;
  }


  .humidity-bars {
    display: flex;

    align-items: flex-end;

    gap: 18px;
  }


  .hbar {
    display: flex;

    flex-direction: column;

    align-items: center;

    gap: 6px;
  }


  .hbar .track {
    width: 26px;
    height: 64px;

    background: var(--paper-2);

    border-radius: 6px;

    display: flex;
    align-items: flex-end;

    overflow: hidden;
  }


  .hbar .fill {
    width: 100%;

    border-radius: 6px 6px 0 0;
  }


  .hbar.before .fill {
    height: 63%;

    background:
      linear-gradient(
        180deg,
        #E5B04B,
        var(--gold)
      );
  }


  .hbar.after .fill {
    height: 55%;

    background:
      linear-gradient(
        180deg,
        #82BFD1,
        var(--med-blue)
      );
  }


  .hbar .val {
    font-size: 12px;

    font-weight: 700;

    color: var(--ink);
  }


  .hbar .tag {
    font-size: 10.5px;

    color: var(--ink-soft);
  }


  .humidity-arrow {
    color: #3B839A;

    font-size: 12px;

    font-weight: 700;

    padding-bottom: 20px;
  }


  /* =========================================================
     METER
  ========================================================= */

  .meter-row {
    display: flex;

    align-items: center;

    gap: 10px;

    margin-bottom: 16px;
  }


  .meter-icon {
    width: 30px;
    height: 30px;

    border-radius: 8px;

    background: #E4EFF2;

    color: var(--dark-ocean);

    display: flex;

    align-items: center;
    justify-content: center;

    flex: none;
  }


  .meter-icon svg {
    width: 18px;
    height: 18px;
  }


  .meter-text {
    display: flex;

    flex-direction: column;

    gap: 1px;
  }


  .meter-text b {
    font-size: 13px;

    font-weight: 700;
  }


  .meter-text span {
    font-size: 11.5px;

    color: var(--ink-soft);
  }


  /* =========================================================
     PHOTO THUMBNAILS
  ========================================================= */

  .photos {
    margin-bottom: 16px;
  }


  .photo-grid {
    display: grid;

    grid-template-columns: repeat(8, 1fr);

    gap: 5px;
  }


  .photo-thumb {
    position: relative;

    aspect-ratio: 1;

    overflow: hidden;

    border-radius: 5px;

    background: #D8E1E2;

    border: 1px solid rgba(14,56,70,.13);

    box-shadow:
      inset 0 0 0 1px rgba(255,255,255,.25);
  }


  /* Living */
  .living {
    background: #ECE8DF;
  }

  .living .window {
    position: absolute;

    left: 12%;
    top: 10%;

    width: 50%;
    height: 38%;

    background: #A9CEDB;

    border: 2px solid #F7F5EF;
  }

  .living .sofa {
    position: absolute;

    left: 16%;
    bottom: 14%;

    width: 68%;
    height: 28%;

    background: #B99C77;

    border-radius: 4px;
  }


  /* Kitchen */
  .kitchen {
    background: #E6E5DF;
  }

  .kitchen .cabinet {
    position: absolute;

    left: 9%;
    top: 12%;

    width: 82%;
    height: 26%;

    background: #D2DFE2;
  }

  .kitchen .counter {
    position: absolute;

    left: 8%;
    bottom: 18%;

    width: 84%;
    height: 23%;

    background: #9EAAA7;

    border-top: 4px solid #5D7378;
  }


  /* Bathroom */
  .bathroom {
    background: #E7E9E6;
  }

  .bathroom .mirror {
    position: absolute;

    left: 18%;
    top: 10%;

    width: 58%;
    height: 38%;

    background: #B5D0D8;

    border: 2px solid white;
  }

  .bathroom .basin {
    position: absolute;

    left: 26%;
    bottom: 16%;

    width: 50%;
    height: 25%;

    background: #F5F3EE;

    border-radius: 50% 50% 4px 4px;
  }


  /* Terrace */
  .terrace {
    background: #C4DCE4;
  }

  .terrace .sky {
    position: absolute;

    inset: 0 0 55% 0;

    background:
      linear-gradient(
        #8FC5D8,
        #CAE1E8
      );
  }

  .terrace .wall {
    position: absolute;

    inset: 45% 0 28% 0;

    background: #EEE9DF;
  }

  .terrace .floor {
    position: absolute;

    inset: 72% 0 0 0;

    background: #C0A77E;
  }


  /* Meter */
  .meter {
    background: #D9DDDC;
  }

  .meter .meterbox {
    position: absolute;

    left: 17%;
    top: 10%;

    width: 66%;
    height: 75%;

    background: #F2F1EB;

    border: 2px solid #7B898B;

    border-radius: 3px;
  }

  .meter .meterdisplay {
    position: absolute;

    left: 30%;
    top: 30%;

    width: 40%;
    height: 22%;

    background: #A9C7CB;

    border-radius: 2px;
  }


  /* AC */
  .ac {
    background: #DEDCD5;
  }

  .ac .acwall {
    position: absolute;

    inset: 0;

    background:
      linear-gradient(
        135deg,
        #ECE8DF,
        #D9D5CB
      );
  }

  .ac .acunit {
    position: absolute;

    left: 14%;
    top: 18%;

    width: 72%;
    height: 27%;

    background: #F8F7F2;

    border: 1px solid #ADB8BA;

    border-radius: 4px;

    z-index: 2;
  }


  /* Entrance */
  .entrance {
    background: #DCD8CF;
  }

  .entrance .entrywall {
    position: absolute;

    inset: 0;

    background: #E8E1D5;
  }

  .entrance .door {
    position: absolute;

    left: 28%;
