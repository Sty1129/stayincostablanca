---

<section
  id="pachete"
  class="py-16 sm:py-20 md:py-24 bg-slate-50 font-heading border-b border-border"
>
  <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8">

    <!-- TITLE & SUBTITLE -->
    <div class="text-center max-w-4xl mx-auto mb-12 sm:mb-16">
      <h2
        class="
          text-[28px]
          sm:text-4xl
          lg:text-[42px]
          font-bold
          text-[#0E3846]
          uppercase
          tracking-tight
          leading-tight
        "
      >
        {t.heading}
      </h2>

      <p
        class="
          mt-5
          text-base
          sm:text-lg
          text-[#405963]
          leading-7
          sm:leading-8
        "
      >
        {t.intro}
      </p>
    </div>

    <!-- PACKAGES -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
      {t.packages.map((pkg) => (
        <article
          class:list={[
            'bg-white p-6 sm:p-8 rounded-2xl flex flex-col justify-between relative',
            pkg.featured
              ? 'border-2 border-[#5B9EB5] shadow-[0_10px_30px_rgba(14,56,70,0.14)] lg:-translate-y-2'
              : 'border border-[#CCD9DE] shadow-[0_3px_10px_rgba(14,56,70,0.07)]'
          ]}
        >
          {pkg.featured && (
            <div
              class="
                absolute
                -top-4
                left-4
                right-4
                z-10
                bg-[#0E3846]
                text-white
                px-4
                py-2
                rounded-full
                text-[11px]
                sm:text-xs
                font-bold
                uppercase
                tracking-[0.06em]
                text-center
                leading-snug
                shadow-md
              "
            >
              {t.recommended}
            </div>
          )}

          <div>
            <div class:list={['mb-5', pkg.featured && 'pt-6']}>
              <h3
                class="
                  text-2xl
                  sm:text-[28px]
                  font-bold
                  text-[#0E3846]
                "
              >
                {pkg.name}
              </h3>

              <p
                class="
                  text-sm
                  font-bold
                  text-[#5B9EB5]
                  uppercase
                  tracking-[0.15em]
                  mt-1
                "
              >
                {pkg.label}
              </p>

              <p
                class="
                  text-base
                  sm:text-[17px]
                  font-semibold
                  text-[#284650]
                  mt-3
                  leading-snug
                "
              >
                {pkg.subtitle}
              </p>
            </div>

            <p
              class="
                text-base
                sm:text-[17px]
                text-[#405963]
                mb-7
                leading-7
              "
            >
              {pkg.description}
            </p>

            <ul
              class:list={[
                'space-y-3.5 text-base text-[#243F49] leading-6 mb-8 border-t pt-6',
                pkg.featured ? 'border-[#C9E0E6]' : 'border-[#D8E1E5]'
              ]}
            >
              {pkg.benefits.map((benefit, index) => (
                <li
                  class:list={[
                    'flex items-start gap-3',
                    pkg.featured && index === 0 && 'font-semibold text-[#0E3846]',
                    pkg.name === 'ECO-PREMIUM' && index === 0 && 'font-semibold text-[#0E3846]'
                  ]}
                >
                  <span class="text-[#5B9EB5] font-bold text-lg leading-6">
                    ✓
                  </span>
                  <span>{benefit}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- PRICE & CTA -->
          <div>
            <div
              class="
                border-t
                border-[#D8E1E5]
                pt-5
                mb-6
              "
            >
              <div class="flex items-baseline gap-2">
                <span class="text-4xl font-bold text-[#0E3846]">
                  {pkg.price}
                </span>

                <span class="text-base text-[#405963] font-medium">
                  {pkg.frequency === 'year' ? t.year : t.month}
                </span>
              </div>

              <p class="text-sm text-[#405963] mt-1.5 font-medium">
                {t[pkg.priceNote]}
              </p>

              {pkg.annualPrice && (
                <p
                  class="
                    text-base
                    text-[#0E3846]
                    font-bold
                    mt-3
                    leading-6
                  "
                >
                  {pkg.annualPrice} {t.annual}

                  <span class="font-medium text-[#405963]">
                    {' '}{t[pkg.saving]}
                  </span>
                </p>
              )}
            </div>

            <a
              href={r.contact}
              class:list={[
                'block w-full text-center text-white font-bold py-3.5 px-5 rounded-xl text-sm sm:text-base transition uppercase tracking-wide',
                pkg.featured
                  ? 'bg-[#5B9EB5] hover:bg-[#478BA3] shadow-md'
                  : 'bg-[#0E3846] hover:bg-[#092A34] shadow-sm'
              ]}
            >
              {t.requestAssessment}
            </a>

            <a
              href={`${r.services}#${pkg.anchor}`}
              class:list={[
                'block w-full text-center mt-3 border-2 font-bold py-3 px-5 rounded-xl text-sm sm:text-base transition uppercase tracking-wide',
                pkg.featured
                  ? 'border-[#5B9EB5] hover:bg-[#EAF4F6] text-[#0E3846]'
                  : 'border-[#0E3846] hover:bg-[#F2EFE9] text-[#0E3846]'
              ]}
            >
              {t.viewIncludes} {pkg.name} →
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- FULL COMPARISON -->
    <div
      class="
        mt-16
        sm:mt-20
        text-center
        border-t
        border-[#CCD9DE]
        pt-10
        max-w-3xl
        mx-auto
      "
    >
      <h3
        class="
          text-xl
          sm:text-2xl
          font-bold
          text-[#0E3846]
        "
      >
        {t.compareTitle}
      </h3>

      <p
        class="
          text-base
          sm:text-lg
          text-[#405963]
          mt-3
          mb-6
          leading-7
        "
      >
        {t.compareText}
      </p>

      <a
        href={r.comparison}
        class="
          inline-block
          bg-white
          border-2
          border-[#0E3846]
          hover:bg-[#0E3846]
          text-[#0E3846]
          hover:text-white
          font-bold
          px-7
          py-3.5
          rounded-xl
          text-sm
          sm:text-base
          transition
          shadow-sm
          uppercase
          tracking-wide
        "
      >
        {t.compareButton}
      </a>

      <p class="text-sm text-[#526B74] mt-4">
        {t.extras}
      </p>
    </div>

  </div>
</section>

<!-- Launch offer remains a shared component and will use the current locale. -->
<LaunchOffer />
