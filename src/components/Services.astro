    : 'ro';

const routes = {
  ro: {
    contact: '/contact',
    services: '/services',
    comparison: '/services#comparatie',
  },
  en: {
    contact: '/en/contact',
    services: '/en/services',
    comparison: '/en/services#comparison',
  },
  es: {
    contact: '/es/contacto',
    services: '/es/servicios',
    comparison: '/es/servicios#comparacion',
