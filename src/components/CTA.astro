---
// src/components/CTA.astro

const currentLang = Astro.currentLocale || "ro";

const lang =
  currentLang === "en" || currentLang === "es"
    ? currentLang
    : "ro";

const translations = {
  ro: {
    topper: "URMĂTORUL PAS",
    heading: "Ai o proprietate în Orihuela Costa sau Torrevieja?",
    description:
      "Spune-ne ce tip de proprietate ai și cât timp rămâne nelocuită. Îți recomandăm nivelul de protecție potrivit, în funcție de nevoile reale ale proprietății.",
    primaryLabel: "SOLICITĂ EVALUAREA PROPRIETĂȚII",
    primaryHref: "/contact",
    secondaryLabel: "VEZI SERVICIILE ȘI PREȚURILE",
    secondaryHref: "/services",
    reassurance1: "Discuție inițială fără obligații",
    reassurance2: "Recomandare adaptată proprietății",
    reassurance3: "Orihuela Costa & Torrevieja",
  },

  en: {
    topper: "NEXT STEP",
    heading: "Do you own a property in Orihuela Costa or Torrevieja?",
    description:
      "Tell us what type of property you own and how long it is usually left unoccupied. We will recommend the level of protection that best matches the property's actual needs.",
    primaryLabel: "REQUEST A PROPERTY ASSESSMENT",
    primaryHref: "/en/contact",
    secondaryLabel: "VIEW SERVICES & PRICING",
    secondaryHref: "/en/services",
    reassurance1: "No-obligation initial discussion",
    reassurance2: "Recommendation tailored to your property",
    reassurance3: "Orihuela Costa & Torrevieja",
  },

  es: {
    topper: "SIGUIENTE PASO",
    heading: "¿Tienes una propiedad en Orihuela Costa o Torrevieja?",
    description:
      "Cuéntanos qué tipo de propiedad tienes y cuánto tiempo suele permanecer desocupada. Te recomendaremos el nivel de protección que mejor se adapte a las necesidades reales de la propiedad.",
    primaryLabel: "SOLICITA LA EVALUACIÓN DE TU PROPIEDAD",
    primaryHref: "/es/contacto",
    secondaryLabel: "VER SERVICIOS Y PRECIOS",
    secondaryHref: "/es/servicios",
    reassurance1: "Primera conversación sin compromiso",
    reassurance2: "Recomendación adaptada a tu propiedad",
    reassurance3: "Orihuela Costa & Torrevieja",
  },
};

const t = translations[lang];
---

<section
  class="
    relative
    overflow-hidden
    bg-[#0E3846]
    py-14
    sm:py-16
    md:py-20
    font-heading
  "
>
  <!-- Decorative background -->
  <div
    class="
      pointer-events-none
      absolute
      -top-32
      -right-24
      h-[360px]
      w-[360px]
      rounded-full
      bg-[#5B9EB5]/20
      blur-3xl
    "
    aria-hidden="true"
  ></div>

  <div
    class="
      pointer-events-none
      absolute
      -bottom-40
      -left-24
      h-[320px]
      w-[320px]
      rounded-full
      bg-[#D99B26]/10
      blur-3xl
    "
    aria-hidden="true"
  ></div>

  <div
    class="
      relative
      mx-auto
      max-w-site
      px-4
      sm:px-6
      lg:px-8
    "
  >
    <div
      class="
        mx-auto
        max-w-5xl
        text-center
      "
    >
      <!-- TOPPER -->
      <p
        class="
          text-xs
          sm:text-sm
          font-bold
          uppercase
          tracking-[0.18em]
          text-[#F3C76B]
        "
      >
        {t.topper}
      </p>

      <!-- HEADING -->
      <h2
        class="
          mx-auto
          mt-4
          max-w-4xl
          text-[30px]
          sm:text-4xl
          lg:text-[48px]
          font-bold
          leading-[1.12]
          tracking-tight
          text-white
        "
      >
        {t.heading}
      </h2>

      <!-- DESCRIPTION -->
      <p
        class="
          mx-auto
          mt-5
          max-w-3xl
          text-base
          sm:text-lg
          leading-7
          sm:leading-8
          text-[#D8E7EB]
        "
      >
        {t.description}
      </p>

      <!-- BUTTONS -->
      <div
        class="
          mt-8
          flex
          flex-col
          sm:flex-row
          sm:justify-center
          gap-3
        "
      >
        <!-- PRIMARY -->
        <a
          href={t.primaryHref}
          class="
            inline-flex
            min-h-[54px]
            items-center
            justify-center
            rounded-xl
            bg-[#D99B26]
            px-7
            py-3.5
            text-sm
            sm:text-[15px]
            font-bold
            uppercase
            tracking-[0.04em]
            text-[#0E3846]
            shadow-[0_8px_24px_rgba(0,0,0,0.18)]
            transition-all
            duration-200
            hover:-translate-y-0.5
            hover:bg-[#E7AA38]
          "
        >
          {t.primaryLabel}
        </a>

        <!-- SECONDARY -->
        <a
          href={t.secondaryHref}
          class="
            inline-flex
            min-h-[54px]
            items-center
            justify-center
            rounded-xl
            border
            border-white/55
            bg-white/5
            px-7
            py-3.5
            text-sm
            sm:text-[15px]
            font-bold
            uppercase
            tracking-[0.04em]
            text-white
            backdrop-blur-sm
            transition-all
            duration-200
            hover:bg-white
            hover:text-[#0E3846]
          "
        >
          {t.secondaryLabel}
        </a>
      </div>

      <!-- REASSURANCE -->
      <div
        class="
          mt-9
          grid
          grid-cols-1
          sm:grid-cols-3
          gap-3
          sm:gap-4
          border-t
          border-white/15
          pt-7
        "
      >
        <!-- ITEM 1 -->
        <div
          class="
            flex
            items-center
            justify-center
            gap-2.5
            text-sm
            font-semibold
            text-[#DCE9EC]
          "
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            class="h-4 w-4 shrink-0 text-[#F3C76B]"
            aria-hidden="true"
          >
            <path
              d="M5 12l4 4L19 6"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>

          <span>{t.reassurance1}</span>
        </div>

        <!-- ITEM 2 -->
        <div
          class="
            flex
            items-center
            justify-center
            gap-2.5
            text-sm
            font-semibold
            text-[#DCE9EC]
          "
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            class="h-4 w-4 shrink-0 text-[#F3C76B]"
            aria-hidden="true"
          >
            <path
              d="M5 12l4 4L19 6"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>

          <span>{t.reassurance2}</span>
        </div>

        <!-- ITEM 3 -->
        <div
          class="
            flex
            items-center
            justify-center
            gap-2.5
            text-sm
            font-semibold
            text-[#DCE9EC]
          "
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            class="h-4 w-4 shrink-0 text-[#F3C76B]"
            aria-hidden="true"
          >
            <path
              d="M12 21s7-5.1 7-11a7 7 0 10-14 0c0 5.9 7 11 7 11z"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <circle
              cx="12"
              cy="10"
              r="2.3"
              stroke-width="1.8"
            />
          </svg>

          <span>{t.reassurance3}</span>
        </div>
      </div>
    </div>
  </div>
</section>
