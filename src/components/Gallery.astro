---
// src/components/Gallery.astro

const currentLang = Astro.currentLocale || 'ro';

const lang =
  currentLang === 'en' || currentLang === 'es'
    ? currentLang
    : 'ro';

const translations = {
  ro: {
    topper: 'CE MONITORIZĂM ÎN PRACTICĂ',
    heading:
      'Detaliile mici pot semnala probleme înainte ca acestea să devină costisitoare.',
    intro:
      'În timpul vizitelor verificăm și documentăm punctele care pot trece ușor neobservate atunci când proprietatea rămâne nelocuită.',

    cards: [
      {
        image: '/door-damage.webp',
        title: 'Acces & securitate',
        text:
          'Inspectăm ușile, încuietorile și punctele de acces pentru modificări, deteriorări sau semne care necesită atenție.',
        alt:
          'Ușă de acces cu deteriorare în zona încuietorii, exemplu de verificare a securității proprietății',
      },
      {
        image: '/bathroom-leak.webp',
        title: 'Apă & scurgeri',
        text:
          'Observăm robinetele, obiectele sanitare și semnele vizibile care pot indica pierderi de apă sau infiltrații.',
        alt:
          'Robinet care picură într-o baie, exemplu de verificare pentru pierderi de apă',
      },
      {
        image: '/ac-filters.webp',
        title: 'Aer condiționat',
        text:
          'Verificăm funcționarea de bază și observăm starea vizibilă a filtrelor și a unității interioare.',
        alt:
          'Unitate de aer condiționat cu capacul ridicat și filtre murdare',
      },
      {
        image: '/kitchen-check.webp',
        title: 'Instalații & zone ascunse',
        text:
          'Inspectăm zonele de sub chiuvete și conexiunile vizibile pentru urme de umezeală, scurgeri sau alte modificări.',
        alt:
          'Spațiu sub chiuvetă cu instalații vizibile și urme de apă',
      },
      {
        image: '/terrace-check.webp',
        title: 'Exterior & terasă',
        text:
          'Verificăm drenajul, acumulările de apă și efectele ploii sau vântului asupra zonelor exterioare.',
        alt:
          'Terasă cu apă acumulată și drenaj parțial blocat de frunze',
      },
      {
        image: '/living-humidity.webp',
        title: 'Umiditate & climat interior',
        text:
          'Urmărim semnele vizibile de umezeală, condens sau mucegai și le comparăm cu observațiile anterioare.',
        alt:
          'Colț interior cu urme vizibile de umezeală și mucegai',
      },
    ],

    reportTitle: 'Fiecare observație este documentată.',
    reportText:
      'Fotografiile, valorile relevante și recomandările din fiecare vizită contribuie la istoricul digital al proprietății.',
    preventionTitle: 'Nu căutăm doar probleme evidente.',
    preventionText:
      'Scopul este să observăm schimbările suficient de devreme pentru ca proprietarul să poată decide ce trebuie făcut.',
  },

  en: {
    topper: 'WHAT WE MONITOR IN PRACTICE',
    heading:
      'Small details can signal problems before they become expensive.',
    intro:
      'During our visits we check and document areas that can easily go unnoticed when a property is left unoccupied.',

    cards: [
      {
        image: '/door-damage.webp',
        title: 'Access & security',
        text:
          'We inspect doors, locks and access points for changes, damage or signs that require attention.',
        alt:
          'Entrance door with damage around the lock, illustrating a property security check',
      },
      {
        image: '/bathroom-leak.webp',
        title: 'Water & leaks',
        text:
          'We observe taps, sanitary fixtures and visible signs that may indicate water loss or infiltration.',
        alt:
          'Dripping bathroom tap illustrating a water-leak check',
      },
      {
        image: '/ac-filters.webp',
        title: 'Air conditioning',
        text:
          'We carry out a basic functional check and observe the visible condition of the filters and indoor unit.',
        alt:
          'Air-conditioning unit with the cover open and visibly dirty filters',
      },
      {
        image: '/kitchen-check.webp',
        title: 'Installations & hidden areas',
        text:
          'We inspect areas beneath sinks and visible connections for signs of moisture, leakage or other changes.',
        alt:
          'Area beneath a sink with visible plumbing and signs of water',
      },
      {
        image: '/terrace-check.webp',
        title: 'Exterior & terrace',
        text:
          'We check drainage, standing water and the effects of rain or wind on exterior areas.',
        alt:
          'Terrace with standing water and drainage partially blocked by leaves',
      },
      {
        image: '/living-humidity.webp',
        title: 'Humidity & indoor climate',
        text:
          'We monitor visible signs of damp, condensation or mould and compare them with previous observations.',
        alt:
          'Interior corner with visible signs of damp and mould',
      },
    ],

    reportTitle: 'Every observation is documented.',
    reportText:
      'Photographs, relevant readings and recommendations from each visit contribute to the property’s digital history.',
    preventionTitle: 'We do not look only for obvious problems.',
    preventionText:
      'The aim is to notice changes early enough for the owner to decide what action should be taken.',
  },

  es: {
    topper: 'QUÉ MONITORIZAMOS EN LA PRÁCTICA',
    heading:
      'Los pequeños detalles pueden señalar problemas antes de que resulten costosos.',
    intro:
      'Durante nuestras visitas revisamos y documentamos zonas que pueden pasar fácilmente desapercibidas cuando una propiedad permanece desocupada.',

    cards: [
      {
        image: '/door-damage.webp',
        title: 'Acceso y seguridad',
        text:
          'Inspeccionamos puertas, cerraduras y puntos de acceso para detectar cambios, daños o señales que requieran atención.',
        alt:
          'Puerta de entrada con daños alrededor de la cerradura, ejemplo de revisión de seguridad',
      },
      {
        image: '/bathroom-leak.webp',
        title: 'Agua y fugas',
        text:
          'Observamos grifos, sanitarios y señales visibles que puedan indicar pérdidas de agua o infiltraciones.',
        alt:
          'Grifo de baño que gotea, ejemplo de revisión de una posible fuga de agua',
      },
      {
        image: '/ac-filters.webp',
        title: 'Aire acondicionado',
        text:
          'Realizamos una comprobación funcional básica y observamos el estado visible de los filtros y de la unidad interior.',
        alt:
          'Unidad de aire acondicionado abierta con filtros visiblemente sucios',
      },
      {
        image: '/kitchen-check.webp',
        title: 'Instalaciones y zonas ocultas',
        text:
          'Inspeccionamos las zonas bajo los fregaderos y las conexiones visibles para detectar humedad, fugas u otros cambios.',
        alt:
          'Zona bajo un fregadero con tuberías visibles y señales de agua',
      },
      {
        image: '/terrace-check.webp',
        title: 'Exterior y terraza',
        text:
          'Revisamos el drenaje, las acumulaciones de agua y los efectos de la lluvia o el viento sobre las zonas exteriores.',
        alt:
          'Terraza con agua acumulada y drenaje parcialmente obstruido por hojas',
      },
      {
        image: '/living-humidity.webp',
        title: 'Humedad y clima interior',
        text:
          'Seguimos las señales visibles de humedad, condensación o moho y las comparamos con observaciones anteriores.',
        alt:
          'Esquina interior con señales visibles de humedad y moho',
      },
    ],

    reportTitle: 'Cada observación queda documentada.',
    reportText:
      'Las fotografías, los valores relevantes y las recomendaciones de cada visita contribuyen al historial digital de la propiedad.',
    preventionTitle: 'No buscamos únicamente problemas evidentes.',
    preventionText:
      'El objetivo es detectar los cambios con suficiente antelación para que el propietario pueda decidir qué medidas tomar.',
  },
};

const t = translations[lang];
---

<section
  id="galerie"
  class="bg-[#F7FAFA] py-14 sm:py-16 md:py-20 font-heading border-b border-[#D8E1E5]"
>
  <div class="mx-auto max-w-site px-4 sm:px-6 lg:px-8">

    <!-- INTRO -->
    <div class="max-w-4xl mb-10 sm:mb-12">
      <p
        class="
          text-sm
          font-bold
          uppercase
          tracking-[0.16em]
          text-[#D99B26]
          mb-3
        "
      >
        {t.topper}
      </p>

      <h2
        class="
          text-[30px]
          sm:text-4xl
          lg:text-[42px]
          font-bold
          text-[#0E3846]
          tracking-tight
          leading-[1.13]
        "
      >
        {t.heading}
      </h2>

      <p
        class="
          mt-5
          max-w-3xl
          text-base
          sm:text-lg
          text-[#526B74]
          leading-7
          sm:leading-8
        "
      >
        {t.intro}
      </p>
    </div>

    <!-- VISUAL GRID -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
      {t.cards.map((card) => (
        <article
          class="
            group
            overflow-hidden
            rounded-2xl
            border
            border-[#D1E0E5]
            bg-white
            shadow-[0_5px_18px_rgba(14,56,70,0.07)]
            transition-all
            duration-300
            hover:-translate-y-1
            hover:shadow-[0_14px_32px_rgba(14,56,70,0.12)]
          "
        >
          <div class="relative overflow-hidden aspect-[4/3] bg-[#EAF1F3]">
            <img
              src={card.image}
              alt={card.alt}
              loading="lazy"
              decoding="async"
              class="
                block
                h-full
                w-full
                object-cover
                transition-transform
                duration-500
                group-hover:scale-[1.025]
              "
            />

            <div
              class="
                absolute
                inset-x-0
                bottom-0
                h-20
                bg-gradient-to-t
                from-[#071F28]/35
                to-transparent
                pointer-events-none
              "
              aria-hidden="true"
            ></div>
          </div>

          <div class="p-5 sm:p-6">
            <div class="mb-3 h-1 w-10 rounded-full bg-[#5B9EB5]"></div>

            <h3
              class="
                text-lg
                sm:text-xl
                font-bold
                text-[#0E3846]
                leading-tight
              "
            >
              {card.title}
            </h3>

            <p
              class="
                mt-3
                text-sm
                sm:text-[15px]
                text-[#526B74]
                leading-6
              "
            >
              {card.text}
            </p>
          </div>
        </article>
      ))}
    </div>

    <!-- BOTTOM MESSAGE -->
    <div
      class="
        mt-8
        sm:mt-10
        grid
        grid-cols-1
        lg:grid-cols-2
        gap-px
        overflow-hidden
        rounded-2xl
        border
        border-[#C9DDE3]
        bg-[#C9DDE3]
      "
    >
      <div class="bg-[#EAF4F6] p-6 sm:p-7">
        <div class="flex items-start gap-4">
          <div
            class="
              flex
              h-11
              w-11
              shrink-0
              items-center
              justify-center
              rounded-full
              bg-white
              text-[#0E3846]
              shadow-sm
            "
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              class="h-5 w-5"
              aria-hidden="true"
            >
              <rect x="5" y="3" width="14" height="18" rx="2" stroke-width="1.8" />
              <path
                d="M8.5 8h7M8.5 12h7M8.5 16h4.5"
                stroke-width="1.8"
                stroke-linecap="round"
              />
            </svg>
          </div>

          <div>
            <h3 class="text-base sm:text-lg font-bold text-[#0E3846]">
              {t.reportTitle}
            </h3>
            <p class="mt-2 text-sm sm:text-[15px] leading-6 text-[#526B74]">
              {t.reportText}
            </p>
          </div>
        </div>
      </div>

      <div class="bg-[#EAF4F6] p-6 sm:p-7">
        <div class="flex items-start gap-4">
          <div
            class="
              flex
              h-11
              w-11
              shrink-0
              items-center
              justify-center
              rounded-full
              bg-white
              text-[#0E3846]
              shadow-sm
            "
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              class="h-5 w-5"
              aria-hidden="true"
            >
              <path
                d="M12 3l7 3v5c0 4.5-2.7 8-7 10-4.3-2-7-5.5-7-10V6l7-3z"
                stroke-width="1.8"
                stroke-linejoin="round"
              />
              <path
                d="M9 12l2 2 4-4"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </div>

          <div>
            <h3 class="text-base sm:text-lg font-bold text-[#0E3846]">
              {t.preventionTitle}
            </h3>
            <p class="mt-2 text-sm sm:text-[15px] leading-6 text-[#526B74]">
              {t.preventionText}
            </p>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
