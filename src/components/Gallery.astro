---
// src/components/Gallery.astro

const areas = [
  {
    src: "/Usa.jpg",
    title: "Acces & securitate",
    label: "UȘĂ / ACCES",
    description:
      "Verificăm ușa de acces, închiderea, ferestrele, obloanele și punctele principale de securitate.",
    alt: "Ușă de acces a unei proprietăți",
    icon: "door",
  },

  {
    src: "/Baie.jpg",
    title: "Baie & umiditate",
    label: "BAIE",
    description:
      "Urmărim semnele vizibile de umezeală, scurgerile, toaleta, sifonul și funcționarea instalațiilor sanitare.",
    alt: "Baie într-o proprietate din Costa Blanca",
    icon: "water",
  },

  {
    src: "/Bucatarie.jpg",
    title: "Bucătărie & apă",
    label: "BUCĂTĂRIE",
    description:
      "Verificăm punctele de apă, chiuveta, robinetele și eventualele semne de scurgere sau deteriorare.",
    alt: "Bucătărie într-o proprietate",
    icon: "kitchen",
  },

  {
    src: "/AC.jpg",
    title: "Climat interior & AC",
    label: "AER CONDIȚIONAT",
    description:
      "Verificăm funcționarea de bază a aerului condiționat și observăm condițiile relevante ale climatului interior.",
    alt: "Cameră cu instalație de aer condiționat",
    icon: "ac",
  },

  {
    src: "/Terasa.jpg",
    title: "Terasă & exterior",
    label: "TERASĂ",
    description:
      "Observăm starea terasei, mobilierului exterior, pergolelor, drenajului și zonelor expuse vremii.",
    alt: "Terasă exterioară a unei proprietăți",
    icon: "terrace",
  },

  {
    src: "/living.jpg",
    title: "Interior & stare generală",
    label: "LIVING",
    description:
      "Urmărim starea generală a încăperilor, mobilierului, ferestrelor și eventualele schimbări vizibile în timp.",
    alt: "Living al unei proprietăți",
    icon: "home",
  },
];
---

<section
  id="ce-verificam"
  class="
    bg-[#F7FAFA]
    py-14
    sm:py-16
    md:py-20
    font-heading
    border-b
    border-[#D8E1E5]
  "
>
  <div
    class="
      mx-auto
      max-w-site
      px-4
      sm:px-6
      lg:px-8
    "
  >

    <!-- =====================================================
         TITLU
    ====================================================== -->

    <div
      class="
        mx-auto
        max-w-4xl
        text-center
        mb-10
        sm:mb-14
      "
    >

      <p
        class="
          text-sm
          font-bold
          uppercase
          tracking-[0.16em]
          text-[#D99B26]
          mb-3
        "
      >
        CE VERIFICĂM ÎN PRACTICĂ
      </p>

      <h2
        class="
          text-[28px]
          sm:text-4xl
          lg:text-[42px]
          font-bold
          text-[#0E3846]
          tracking-tight
          leading-[1.15]
        "
      >
        O proprietate se protejează punct cu punct.
      </h2>

      <p
        class="
          mt-5
          max-w-3xl
          mx-auto
          text-base
          sm:text-lg
          text-[#526B74]
          leading-7
          sm:leading-8
        "
      >
        Fiecare vizită urmărește zone concrete ale proprietății.
        Nu ne limităm la o privire generală, ci documentăm elementele
        care pot indica schimbări, uzură sau situații ce necesită atenție.
      </p>

    </div>


    <!-- =====================================================
         GRID
    ====================================================== -->

    <div
      class="
        grid
        grid-cols-1
        sm:grid-cols-2
        lg:grid-cols-3
        gap-5
        lg:gap-6
      "
    >

      {areas.map((area) => (

        <article
          class="
            group
            overflow-hidden
            rounded-2xl
            bg-white
            border
            border-[#D1E0E5]
            shadow-[0_8px_22px_rgba(14,56,70,0.08)]
            transition-all
            duration-300
            hover:-translate-y-1
            hover:shadow-[0_15px_32px_rgba(14,56,70,0.13)]
          "
        >

          <!-- =================================================
               FOTO
          ================================================== -->

          <div
            class="
              relative
              aspect-[4/3]
              overflow-hidden
              bg-[#E6EFF2]
            "
          >

            <!-- Placeholder vizibil până încarci poza -->
            <div
              class="
                absolute
                inset-0
                flex
                flex-col
                items-center
                justify-center
                bg-[#EAF3F5]
                text-[#5E7A84]
                px-6
                text-center
              "
              data-placeholder
            >

              <!-- ICON PLACEHOLDER -->
              <div
                class="
                  w-14
                  h-14
                  rounded-full
                  bg-white
                  border
                  border-[#CADCE2]
                  flex
                  items-center
                  justify-center
                  text-[#0E3846]
                  shadow-sm
                  mb-3
                "
              >

                {area.icon === "door" && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    class="w-7 h-7"
                    aria-hidden="true"
                  >
                    <path
                      d="M6 21V4a1 1 0 011-1h10a1 1 0 011 1v17"
                      stroke-width="1.7"
                      stroke-linejoin="round"
                    />
                    <path
                      d="M3 21h18"
                      stroke-width="1.7"
                      stroke-linecap="round"
                    />
                    <circle
                      cx="14.5"
                      cy="12"
                      r="1"
                      fill="currentColor"
                      stroke="none"
                    />
                  </svg>
                )}

                {area.icon === "water" && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    class="w-7 h-7"
                    aria-hidden="true"
                  >
                    <path
                      d="M12 3.5c-2.8 3.7-5.2 6.5-5.2 9.5a5.2 5.2 0 0010.4 0c0-3-2.4-5.8-5.2-9.5z"
                      stroke-width="1.7"
                    />
                  </svg>
                )}

                {area.icon === "kitchen" && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    class="w-7 h-7"
                    aria-hidden="true"
                  >
                    <path
                      d="M4 10h16v10H4zM8 10V6h5M13 6h3"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                )}

                {area.icon === "ac" && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    class="w-7 h-7"
                    aria-hidden="true"
                  >
                    <rect
                      x="3"
                      y="5"
                      width="18"
                      height="7"
                      rx="2"
                      stroke-width="1.7"
                    />
                    <path
                      d="M7 16c1 0 2 .7 2 2M12 15c0 1.5 1 2.5 2.5 2.5M17 16c-1 0-2 .7-2 2"
                      stroke-width="1.7"
                      stroke-linecap="round"
                    />
                  </svg>
                )}

                {area.icon === "terrace" && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    class="w-7 h-7"
                    aria-hidden="true"
                  >
                    <path
                      d="M3 12h18M5 12v7M19 12v7M8 8h8l2 4H6l2-4z"
                      stroke-width="1.7"
                      stroke-linejoin="round"
                    />
                  </svg>
                )}

                {area.icon === "home" && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    class="w-7 h-7"
                    aria-hidden="true"
                  >
                    <path
                      d="M3 11l9-7 9 7M5 10v10h14V10M9 20v-6h6v6"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                )}

              </div>

              <p
                class="
                  text-xs
                  font-bold
                  uppercase
                  tracking-[0.12em]
                "
              >
                FOTO {area.label}
              </p>

            </div>


            <!-- Imaginea reală -->
            <img
              src={area.src}
              alt={area.alt}
              loading="lazy"
              decoding="async"
              data-gallery-image
              class="
                relative
                z-10
                w-full
                h-full
                object-cover
                transition-transform
                duration-700
                group-hover:scale-[1.04]
              "
            />


            <!-- LABEL PE FOTO -->
            <div
              class="
                absolute
                z-20
                left-4
                top-4
                rounded-lg
                bg-[#0E3846]/95
                backdrop-blur-sm
                px-3
                py-2
                shadow-sm
              "
            >
              <p
                class="
                  text-[10px]
                  sm:text-[11px]
                  font-bold
                  uppercase
                  tracking-[0.12em]
                  text-white
                "
              >
                {area.label}
              </p>
            </div>

          </div>


          <!-- =================================================
               TEXT
          ================================================== -->

          <div
            class="
              p-5
              sm:p-6
            "
          >

            <h3
              class="
                text-xl
                font-bold
                text-[#0E3846]
                leading-tight
              "
            >
              {area.title}
            </h3>

            <p
              class="
                mt-3
                text-base
                text-[#526B74]
                leading-7
              "
            >
              {area.description}
            </p>

          </div>

        </article>

      ))}

    </div>


    <!-- =====================================================
         CONCLUZIE
    ====================================================== -->

    <div
      class="
        mt-9
        max-w-3xl
        mx-auto
        text-center
      "
    >

      <p
        class="
          text-base
          sm:text-[17px]
          text-[#405963]
          leading-7
        "
      >
        Aceste verificări sunt adaptate nivelului de serviciu contractat și
        caracteristicilor fiecărei proprietăți.
      </p>

    </div>

  </div>
</section>


<!-- =========================================================
     Dacă imaginea încă nu există, păstrăm placeholder-ul
========================================================== -->

<script>
  function initialiseInspectionGallery() {
    document
      .querySelectorAll<HTMLImageElement>("[data-gallery-image]")
      .forEach((img) => {
        const parent = img.parentElement;
        if (!parent) return;

        const placeholder =
          parent.querySelector<HTMLElement>("[data-placeholder]");

        const showImage = () => {
          if (placeholder) {
            placeholder.style.display = "none";
          }

          img.style.display = "block";
        };

        const showPlaceholder = () => {
          img.style.display = "none";

          if (placeholder) {
            placeholder.style.display = "flex";
          }
        };

        if (img.complete) {
          if (img.naturalWidth > 0) {
            showImage();
          } else {
            showPlaceholder();
          }
        } else {
          img.addEventListener("load", showImage, { once: true });
          img.addEventListener("error", showPlaceholder, { once: true });
        }
      });
  }

  initialiseInspectionGallery();

  document.addEventListener(
    "astro:after-swap",
    initialiseInspectionGallery
  );
</script>
