---
// src/components/Gallery.astro

const images = [
  {
    src: 'https://images.unsplash.com/photo-1512917774080-9991f1c4c750?w=1200&q=85',
    alt: 'Proprietate mediteraneană modernă cu piscină',
    label: 'EXTERIOR',
    text: 'Acces, terase și zone exterioare',
    featured: true,
  },
  {
    src: 'https://images.unsplash.com/photo-1560184897-67f4a3f9a7fa?w=900&q=85',
    alt: 'Interior luminos al unei proprietăți',
    label: 'INTERIOR',
    text: 'Starea generală a locuinței',
    featured: false,
  },
  {
    src: 'https://images.unsplash.com/photo-1519449556851-5720b33024e7?w=900&q=85',
    alt: 'Proprietate în stil mediteranean',
    label: 'COSTA BLANCA',
    text: 'Proprietăți de vacanță și locuințe secundare',
    featured: false,
  },
  {
    src: 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?w=1200&q=85',
    alt: 'Casă modernă cu spații exterioare',
    label: 'PROPRIETATE',
    text: 'Monitorizare periodică și prevenție',
    featured: true,
  },
  {
    src: 'https://images.unsplash.com/photo-1493809842364-78817add7ffb?w=900&q=85',
    alt: 'Interior modern al unei locuințe',
    label: 'DETALII',
    text: 'Observații documentate în timp',
    featured: false,
  },
  {
    src: 'https://images.unsplash.com/photo-1613490493576-7fde63acd811?w=900&q=85',
    alt: 'Terasă și zonă exterioară cu piscină',
    label: 'EXTERIOR',
    text: 'Terase, piscine și zone expuse',
    featured: false,
  },
];

interface Props {
  topper?: string;
  heading?: string;
  description?: string;
}

const {
  topper = 'PROPRIETATEA, VĂZUTĂ ÎN ANSAMBLU',
  heading = 'Fiecare zonă spune ceva despre starea proprietății.',
  description =
    'De la acces și spațiile interioare până la terase și exterior, o administrare preventivă înseamnă să urmărești proprietatea ca întreg — nu doar să verifici dacă ușa este încuiată.',
} = Astro.props;
---

<section
  id="galerie"
  class="
    bg-[#F7FAFA]
    py-14
    sm:py-16
    md:py-20
    font-heading
    border-b
    border-[#D8E1E5]
  "
>
  <div
    class="
      mx-auto
      max-w-site
      px-4
      sm:px-6
      lg:px-8
    "
  >

    <!-- =====================================================
         TITLU
    ====================================================== -->

    <div
      class="
        mx-auto
        max-w-4xl
        text-center
        mb-10
        sm:mb-12
      "
    >

      <p
        class="
          text-sm
          font-bold
          uppercase
          tracking-[0.16em]
          text-[#D99B26]
          mb-3
        "
      >
        {topper}
      </p>

      <h2
        class="
          text-[28px]
          sm:text-4xl
          lg:text-[42px]
          font-bold
          text-[#0E3846]
          tracking-tight
          leading-[1.15]
        "
      >
        {heading}
      </h2>

      <p
        class="
          mt-5
          max-w-3xl
          mx-auto
          text-base
          sm:text-lg
          text-[#526B74]
          leading-7
          sm:leading-8
        "
      >
        {description}
      </p>

    </div>


    <!-- =====================================================
         GALERIE
    ====================================================== -->

    <div
      class="
        grid
        grid-cols-1
        sm:grid-cols-2
        lg:grid-cols-3
        gap-4
        lg:gap-5
      "
    >

      {images.map((image, index) => (

        <article
          class:list={[
            "group",
            "relative",
            "overflow-hidden",
            "rounded-2xl",
            "border",
            "border-[#CFDDE2]",
            "bg-[#EAF1F3]",
            "shadow-[0_8px_22px_rgba(14,56,70,0.08)]",
            "transition-all",
            "duration-300",
            "hover:-translate-y-1",
            "hover:shadow-[0_15px_32px_rgba(14,56,70,0.14)]",

            image.featured
              ? "sm:col-span-2 lg:col-span-2"
              : ""
          ]}
        >

          <div
            class:list={[
              "relative",
              "overflow-hidden",

              image.featured
                ? "aspect-[16/8] sm:aspect-[16/7]"
                : "aspect-[4/3]"
            ]}
          >

            <!-- IMAGINE -->
            <img
              src={image.src}
              alt={image.alt}
              loading="lazy"
              decoding="async"
              class="
                absolute
                inset-0
                w-full
                h-full
                object-cover
                transition-transform
                duration-700
                group-hover:scale-[1.04]
              "
            />


            <!-- GRADIENT -->
            <div
              class="
                absolute
                inset-0
                bg-gradient-to-t
                from-[#071F27]/80
                via-[#071F27]/15
                to-transparent
                pointer-events-none
              "
              aria-hidden="true"
            ></div>


            <!-- NUMĂR DISCRET -->
            <div
              class="
                absolute
                top-4
                right-4
                flex
                h-8
                w-8
                items-center
                justify-center
                rounded-full
                bg-white/90
                backdrop-blur-sm
                text-[11px]
                font-bold
                text-[#0E3846]
                shadow-sm
              "
            >
              {String(index + 1).padStart(2, '0')}
            </div>


            <!-- TEXT -->
            <div
              class="
                absolute
                left-0
                right-0
                bottom-0
                p-5
                sm:p-6
              "
            >

              <p
                class="
                  text-[11px]
                  sm:text-xs
                  font-bold
                  uppercase
                  tracking-[0.14em]
                  text-[#F3C76B]
                "
              >
                {image.label}
              </p>

              <p
                class="
                  mt-1.5
                  text-base
                  sm:text-lg
                  font-bold
                  text-white
                  leading-snug
                "
              >
                {image.text}
              </p>

            </div>

          </div>

        </article>

      ))}

    </div>


    <!-- =====================================================
         NOTĂ
    ====================================================== -->

    <div
      class="
        mt-7
        text-center
      "
    >
      <p
        class="
          text-xs
          sm:text-sm
          text-[#748B93]
          leading-6
        "
      >
        Imaginile au rol ilustrativ pentru tipurile de proprietăți și spații
        întâlnite în activitatea de administrare.
      </p>
    </div>

  </div>
</section>
