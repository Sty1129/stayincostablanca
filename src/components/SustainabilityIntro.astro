---
// src/components/SustainabilityIntro.astro

const currentLang = Astro.currentLocale || 'ro';

const lang =
  currentLang === 'en' || currentLang === 'es'
    ? currentLang
    : 'ro';

const routes = {
  ro: {
    sustainability: '/sustenabilitate',
  },
  en: {
    sustainability: '/en/sustainability',
  },
  es: {
    sustainability: '/es/sostenibilidad',
  },
};

const r = routes[lang];

const translations = {
  ro: {
    topper: 'SUSTENABILITATE',
    heading: 'Administrare responsabilă, nu doar monitorizare',
    intro:
      'Folosim principiile dezvoltării durabile pentru a urmări consumul de resurse, a preveni risipa și a contribui la menținerea proprietății într-o stare bună pe termen lung.',

    transversal: 'DIMENSIUNE TRANSVERSALĂ',

    digitalTitle: 'Digitalizare',
    digitalText:
      'Documentăm vizitele, datele și observațiile pentru a crea un istoric digital comparabil al proprietății.',

    partnershipsTitle: 'Parteneriate',
    partnershipsText:
      'Colaborarea cu proprietari, tehnicieni, furnizori și alți actori locali transformă monitorizarea într-o acțiune coordonată.',

    note:
      'Obiectivele de Dezvoltare Durabilă indică domeniile în care activitatea noastră poate contribui la o administrare mai responsabilă a proprietății.',

    ctaText:
      'Vrei să afli cum pot contribui aceste principii la administrarea proprietății tale?',
    ctaButton: 'DESCOPERĂ ABORDAREA NOASTRĂ',

    areas: [
      {
        title: 'APĂ',
        description:
          'Monitorizarea consumului și identificarea variațiilor neobișnuite pot ajuta la detectarea timpurie a situațiilor care necesită atenție.',
        icons: [
          {
            src: '/odd-6-ro.png',
            alt: 'ODD 6 — Apă curată și sanitație',
            anchor: 'sdg6',
          },
        ],
      },
      {
        title: 'ENERGIE',
        description:
          'Urmărirea consumului și verificările funcționale ne ajută să observăm evoluția utilizării energiei în proprietate.',
        icons: [
          {
            src: '/odd-7-ro.png',
            alt: 'ODD 7 — Energie curată și la prețuri accesibile',
            anchor: 'sdg7',
          },
        ],
      },
      {
        title: 'PROPRIETATE & REZILIENȚĂ',
        description:
          'Prevenția, întreținerea responsabilă și verificările după vreme severă contribuie la protejarea proprietății și a resurselor sale.',
        icons: [
          {
            src: '/odd-11-ro.png',
            alt: 'ODD 11 — Orașe și comunități durabile',
            anchor: 'sdg11',
          },
          {
            src: '/odd-12-ro.png',
            alt: 'ODD 12 — Consum și producție responsabile',
            anchor: 'sdg12',
          },
          {
            src: '/odd-13-ro.png',
            alt: 'ODD 13 — Acțiune climatică',
            anchor: 'sdg13',
          },
        ],
      },
    ],

    sdg17: {
      src: '/odd-17-ro.png',
      alt: 'ODD 17 — Parteneriate pentru realizarea obiectivelor',
    },
  },

  en: {
    topper: 'SUSTAINABILITY',
    heading: 'Responsible property management, not just monitoring',
    intro:
      'We apply sustainable development principles to track resource consumption, help prevent waste and support the long-term condition of the property.',

    transversal: 'CROSS-CUTTING DIMENSION',

    digitalTitle: 'Digitalisation',
    digitalText:
      'We document visits, data and observations to build a comparable digital history of the property.',

    partnershipsTitle: 'Partnerships',
    partnershipsText:
      'Collaboration with owners, technicians, suppliers and other local partners turns monitoring into coordinated action.',

    note:
      'The Sustainable Development Goals indicate the areas in which our activity can contribute to more responsible property management.',

    ctaText:
      'Would you like to see how these principles can contribute to the management of your property?',
    ctaButton: 'DISCOVER OUR APPROACH',

    areas: [
      {
        title: 'WATER',
        description:
          'Monitoring consumption and identifying unusual variations can help detect situations that require attention at an early stage.',
        icons: [
          {
            src: '/sdg6.png',
            alt: 'SDG 6 — Clean Water and Sanitation',
            anchor: 'sdg6',
          },
        ],
      },
      {
        title: 'ENERGY',
        description:
          'Tracking consumption and carrying out functional checks helps us observe how energy use evolves within the property.',
        icons: [
          {
            src: '/sdg7.png',
            alt: 'SDG 7 — Affordable and Clean Energy',
            anchor: 'sdg7',
          },
        ],
      },
      {
        title: 'PROPERTY & RESILIENCE',
        description:
          'Prevention, responsible maintenance and checks after severe weather help protect the property and its resources.',
        icons: [
          {
            src: '/sdg11.png',
            alt: 'SDG 11 — Sustainable Cities and Communities',
            anchor: 'sdg11',
          },
          {
            src: '/sdg12.png',
            alt: 'SDG 12 — Responsible Consumption and Production',
            anchor: 'sdg12',
          },
          {
            src: '/sdg13.png',
            alt: 'SDG 13 — Climate Action',
            anchor: 'sdg13',
          },
        ],
      },
    ],

    sdg17: {
      src: '/sdg17.png',
      alt: 'SDG 17 — Partnerships for the Goals',
    },
  },

  es: {
    topper: 'SOSTENIBILIDAD',
    heading: 'Gestión responsable, no solo monitorización',
    intro:
      'Aplicamos los principios del desarrollo sostenible para controlar el consumo de recursos, ayudar a prevenir el desperdicio y contribuir al buen estado de la propiedad a largo plazo.',

    transversal: 'DIMENSIÓN TRANSVERSAL',

    digitalTitle: 'Digitalización',
    digitalText:
      'Documentamos las visitas, los datos y las observaciones para crear un historial digital comparable de la propiedad.',

    partnershipsTitle: 'Alianzas',
    partnershipsText:
      'La colaboración con propietarios, técnicos, proveedores y otros actores locales convierte la monitorización en una actuación coordinada.',

    note:
      'Los Objetivos de Desarrollo Sostenible indican los ámbitos en los que nuestra actividad puede contribuir a una gestión más responsable de la propiedad.',

    ctaText:
      '¿Quieres descubrir cómo pueden contribuir estos principios a la gestión de tu propiedad?',
    ctaButton: 'DESCUBRE NUESTRO ENFOQUE',

    areas: [
      {
        title: 'AGUA',
        description:
          'Monitorizar el consumo e identificar variaciones inusuales puede ayudar a detectar con antelación situaciones que requieren atención.',
        icons: [
          {
            src: '/ods6.png',
            alt: 'ODS 6 — Agua limpia y saneamiento',
            anchor: 'sdg6',
          },
        ],
      },
      {
        title: 'ENERGÍA',
        description:
          'El seguimiento del consumo y las revisiones funcionales nos ayudan a observar la evolución del uso de la energía en la propiedad.',
        icons: [
          {
            src: '/ods7.png',
            alt: 'ODS 7 — Energía asequible y no contaminante',
            anchor: 'sdg7',
          },
        ],
      },
      {
        title: 'PROPIEDAD Y RESILIENCIA',
        description:
          'La prevención, el mantenimiento responsable y las revisiones después de episodios meteorológicos severos ayudan a proteger la propiedad y sus recursos.',
        icons: [
          {
            src: '/ods11.png',
            alt: 'ODS 11 — Ciudades y comunidades sostenibles',
            anchor: 'sdg11',
          },
          {
            src: '/ods12.png',
            alt: 'ODS 12 — Producción y consumo responsables',
            anchor: 'sdg12',
          },
          {
            src: '/ods13.png',
            alt: 'ODS 13 — Acción por el clima',
            anchor: 'sdg13',
          },
        ],
      },
    ],

    sdg17: {
      src: '/ods17.png',
      alt: 'ODS 17 — Alianzas para lograr los objetivos',
    },
  },
};

const t = translations[lang];

const mainAreas = t.areas.map((area) => ({
  ...area,
  icons: area.icons.map((icon) => ({
    ...icon,
    href: `${r.sustainability}#${icon.anchor}`,
  })),
}));

const partnershipHref = `${r.sustainability}#sdg17`;
---

<section
  id="sustenabilitate"
  class="py-14 sm:py-16 md:py-20 bg-white font-heading border-b border-[#D8E1E5]"
>
  <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8">

    <!-- TITLE -->
    <div class="text-center max-w-4xl mx-auto mb-10 sm:mb-14">
      <p
        class="
          text-sm
          font-bold
          uppercase
          tracking-[0.16em]
          text-[#D99B26]
          mb-3
        "
      >
        {t.topper}
      </p>

      <h2
        class="
          text-[28px]
          sm:text-4xl
          lg:text-[42px]
          font-bold
          text-[#0E3846]
          tracking-tight
          leading-tight
        "
      >
        {t.heading}
      </h2>

      <p
        class="
          mt-5
          text-base
          sm:text-lg
          text-[#405963]
          leading-7
          sm:leading-8
          max-w-3xl
          mx-auto
        "
      >
        {t.intro}
      </p>
    </div>

    <!-- THREE MAIN DIRECTIONS -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">

      {mainAreas.map((area) => (
        <article
          class="
            bg-[#F7FAFA]
            border
            border-[#D1E0E5]
            rounded-2xl
            p-7
            h-full
            flex
            flex-col
            transition-all
            duration-300
            hover:-translate-y-1
            hover:shadow-[0_12px_30px_rgba(14,56,70,0.10)]
          "
        >
          <div
            class:list={[
              'mb-6 min-h-[88px] flex items-start',
              area.icons.length === 1
                ? 'justify-start'
                : 'justify-start gap-3 flex-wrap'
            ]}
          >
            {area.icons.map((icon) => (
              <a
                href={icon.href}
                title={icon.alt}
                aria-label={icon.alt}
                class="
                  block
                  rounded-lg
                  overflow-hidden
                  transition
                  duration-200
                  hover:-translate-y-1
                  hover:shadow-lg
                  focus:outline-none
                  focus:ring-2
                  focus:ring-[#0E3846]
                  focus:ring-offset-2
                "
              >
                <img
                  src={icon.src}
                  alt={icon.alt}
                  loading="lazy"
                  class="
                    block
                    w-[88px]
                    h-[88px]
                    object-contain
                  "
                />
              </a>
            ))}
          </div>

          <h3
            class="
              text-xl
              sm:text-[22px]
              font-bold
              text-[#0E3846]
              leading-tight
              min-h-[56px]
            "
          >
            {area.title}
          </h3>

          <p
            class="
              mt-3
              text-base
              sm:text-[17px]
              text-[#405963]
              leading-8
            "
          >
            {area.description}
          </p>
        </article>
      ))}

    </div>

    <!-- CROSS-CUTTING DIMENSIONS -->
    <div class="mt-7 grid grid-cols-1 md:grid-cols-2 gap-5">

      <!-- DIGITALISATION -->
      <div
        class="
          rounded-2xl
          bg-[#0E3846]
          px-6
          sm:px-7
          py-7
          border
          border-[#245463]
        "
      >
        <div class="flex items-start gap-5">
          <div
            class="
              shrink-0
              w-16
              h-16
              rounded-xl
              bg-[#174B5B]
              border
              border-[#347082]
              flex
              items-center
              justify-center
              text-[#DCECEF]
            "
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              class="w-8 h-8"
              aria-hidden="true"
            >
              <rect
                x="4"
                y="3"
                width="16"
                height="18"
                rx="2"
                stroke-width="1.6"
              />
              <path
                d="M8 8h8M8 12h8M8 16h5"
                stroke-width="1.6"
                stroke-linecap="round"
              />
              <circle
                cx="17"
                cy="16"
                r="1.5"
                fill="currentColor"
                stroke="none"
              />
            </svg>
          </div>

          <div>
            <p
              class="
                text-xs
                sm:text-sm
                font-bold
                uppercase
                tracking-[0.12em]
                text-[#A9D1DD]
              "
            >
              {t.transversal}
            </p>

            <h3
              class="
                mt-2
                text-xl
                sm:text-[22px]
                font-bold
                text-white
              "
            >
              {t.digitalTitle}
            </h3>

            <p
              class="
                mt-2
                text-base
                sm:text-[17px]
                text-[#DCECEF]
                leading-7
              "
            >
              {t.digitalText}
            </p>
          </div>
        </div>
      </div>

      <!-- PARTNERSHIPS -->
      <div
        class="
          rounded-2xl
          bg-[#0E3846]
          px-6
          sm:px-7
          py-7
          border
          border-[#245463]
        "
      >
        <div class="flex items-start gap-5">
          <a
            href={partnershipHref}
            title={t.sdg17.alt}
            aria-label={t.sdg17.alt}
            class="
              shrink-0
              block
              rounded-lg
              overflow-hidden
              transition
              duration-200
              hover:-translate-y-1
              hover:shadow-lg
              focus:outline-none
              focus:ring-2
              focus:ring-[#F3C76B]
              focus:ring-offset-2
              focus:ring-offset-[#0E3846]
            "
          >
            <img
              src={t.sdg17.src}
              alt={t.sdg17.alt}
              loading="lazy"
              class="
                block
                w-[88px]
                h-[88px]
                object-contain
              "
            />
          </a>

          <div>
            <p
              class="
                text-xs
                sm:text-sm
                font-bold
                uppercase
                tracking-[0.12em]
                text-[#A9D1DD]
              "
            >
              {t.transversal}
            </p>

            <h3
              class="
                mt-2
                text-xl
                sm:text-[22px]
                font-bold
                text-white
              "
            >
              {t.partnershipsTitle}
            </h3>

            <p
              class="
                mt-2
                text-base
                sm:text-[17px]
                text-[#DCECEF]
                leading-7
              "
            >
              {t.partnershipsText}
            </p>
          </div>
        </div>
      </div>

    </div>

    <!-- SHORT NOTE -->
    <div class="mt-8 max-w-4xl mx-auto text-center">
      <p
        class="
          text-sm
          sm:text-base
          text-[#607983]
          leading-7
        "
      >
        {t.note}
      </p>
    </div>

    <!-- CTA -->
    <div class="mt-8 text-center">
      <p
        class="
          text-base
          sm:text-lg
          text-[#405963]
          leading-7
        "
      >
        {t.ctaText}
      </p>

      <a
        href={r.sustainability}
        class="
          inline-flex
          items-center
          justify-center
          gap-2
          mt-5
          border-2
          border-[#0E3846]
          hover:bg-[#0E3846]
          text-[#0E3846]
          hover:text-white
          font-bold
          px-7
          py-3.5
          rounded-xl
          text-sm
          sm:text-base
          transition
          uppercase
          tracking-wide
        "
      >
        {t.ctaButton}
        <span aria-hidden="true">→</span>
      </a>
    </div>

  </div>
</section>
