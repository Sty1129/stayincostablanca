---
// src/components/SustainabilityIntro.astro

const mainAreas = [
  {
    title: "APĂ",
    description:
      "Monitorizarea consumului și identificarea variațiilor neobișnuite pot ajuta la detectarea timpurie a situațiilor care necesită atenție.",
    icons: [
      {
        src: "/odd-6-ro.png",
        alt: "ODD 6 — Apă curată și sanitație",
        href: "/sustenabilitate#sdg6",
      },
    ],
  },

  {
    title: "ENERGIE",
    description:
      "Urmărirea consumului și verificările funcționale ne ajută să observăm evoluția utilizării energiei în proprietate.",
    icons: [
      {
        src: "/odd-7-ro.png",
        alt: "ODD 7 — Energie curată și la prețuri accesibile",
        href: "/sustenabilitate#sdg7",
      },
    ],
  },

  {
    title: "PROPRIETATE & REZILIENȚĂ",
    description:
      "Prevenția, întreținerea responsabilă și verificările după vreme severă contribuie la protejarea proprietății și a resurselor sale.",
    icons: [
      {
        src: "/odd-11-ro.png",
        alt: "ODD 11 — Orașe și comunități durabile",
        href: "/sustenabilitate#sdg11",
      },
      {
        src: "/odd-12-ro.png",
        alt: "ODD 12 — Consum și producție responsabile",
        href: "/sustenabilitate#sdg12",
      },
      {
        src: "/odd-13-ro.png",
        alt: "ODD 13 — Acțiune climatică",
        href: "/sustenabilitate#sdg13",
      },
    ],
  },
];
---

<section
  id="sustenabilitate"
  class="py-14 sm:py-16 md:py-20 bg-white font-heading border-b border-[#D8E1E5]"
>
  <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8">

    <!-- TITLU -->
    <div class="text-center max-w-4xl mx-auto mb-10 sm:mb-14">
      <p
        class="
          text-sm
          font-bold
          uppercase
          tracking-[0.16em]
          text-[#D99B26]
          mb-3
        "
      >
        SUSTENABILITATE
      </p>

      <h2
        class="
          text-[28px]
          sm:text-4xl
          lg:text-[42px]
          font-bold
          text-[#0E3846]
          tracking-tight
          leading-tight
        "
      >
        Administrare responsabilă, nu doar monitorizare
      </h2>

      <p
        class="
          mt-5
          text-base
          sm:text-lg
          text-[#405963]
          leading-7
          sm:leading-8
          max-w-3xl
          mx-auto
        "
      >
        Folosim principiile dezvoltării durabile pentru a urmări consumul de
        resurse, a preveni risipa și a contribui la menținerea proprietății
        într-o stare bună pe termen lung.
      </p>
    </div>

    <!-- CELE 3 DIRECȚII PRINCIPALE -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">

      {mainAreas.map((area) => (
        <article
          class="
            bg-[#F7FAFA]
            border
            border-[#D1E0E5]
            rounded-2xl
            p-7
            h-full
            flex
            flex-col
            transition-all
            duration-300
            hover:-translate-y-1
            hover:shadow-[0_12px_30px_rgba(14,56,70,0.10)]
          "
        >
          <!-- ZONA ICONIȚE CU ÎNĂLȚIME FIXĂ -->
          <div
            class:list={[
              "mb-6 min-h-[88px] flex items-start",
              area.icons.length === 1
                ? "justify-start"
                : "justify-start gap-3 flex-wrap"
            ]}
          >
            {area.icons.map((icon) => (
              <a
                href={icon.href}
                title={icon.alt}
                aria-label={icon.alt}
                class="
                  block
                  rounded-lg
                  overflow-hidden
                  transition
                  duration-200
                  hover:-translate-y-1
                  hover:shadow-lg
                  focus:outline-none
                  focus:ring-2
                  focus:ring-[#0E3846]
                  focus:ring-offset-2
                "
              >
                <img
                  src={icon.src}
                  alt={icon.alt}
                  loading="lazy"
                  class="
                    block
                    w-[88px]
                    h-[88px]
                    object-contain
                  "
                />
              </a>
            ))}
          </div>

          <!-- TITLU CU ÎNĂLȚIME CONTROLATĂ -->
          <h3
            class="
              text-xl
              sm:text-[22px]
              font-bold
              text-[#0E3846]
              leading-tight
              min-h-[56px]
            "
          >
            {area.title}
          </h3>

          <!-- DESCRIERE -->
          <p
            class="
              mt-3
              text-base
              sm:text-[17px]
              text-[#405963]
              leading-8
            "
          >
            {area.description}
          </p>
        </article>
      ))}

    </div>

    <!-- DIMENSIUNI TRANSVERSALE -->
    <div class="mt-7 grid grid-cols-1 md:grid-cols-2 gap-5">

      <!-- DIGITALIZARE -->
      <div
        class="
          rounded-2xl
          bg-[#0E3846]
          px-6
          sm:px-7
          py-7
          border
          border-[#245463]
        "
      >
        <div class="flex items-start gap-5">
          <div
            class="
              shrink-0
              w-16
              h-16
              rounded-xl
              bg-[#174B5B]
              border
              border-[#347082]
              flex
              items-center
              justify-center
              text-[#DCECEF]
            "
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              class="w-8 h-8"
              aria-hidden="true"
            >
              <rect
                x="4"
                y="3"
                width="16"
                height="18"
                rx="2"
                stroke-width="1.6"
              />
              <path
                d="M8 8h8M8 12h8M8 16h5"
                stroke-width="1.6"
                stroke-linecap="round"
              />
              <circle
                cx="17"
                cy="16"
                r="1.5"
                fill="currentColor"
                stroke="none"
              />
            </svg>
          </div>

          <div>
            <p
              class="
                text-xs
                sm:text-sm
                font-bold
                uppercase
                tracking-[0.12em]
                text-[#A9D1DD]
              "
            >
              DIMENSIUNE TRANSVERSALĂ
            </p>

            <h3
              class="
                mt-2
                text-xl
                sm:text-[22px]
                font-bold
                text-white
              "
            >
              Digitalizare
            </h3>

            <p
              class="
                mt-2
                text-base
                sm:text-[17px]
                text-[#DCECEF]
                leading-7
              "
            >
              Documentăm vizitele, datele și observațiile pentru a crea
              un istoric digital comparabil al proprietății.
            </p>
          </div>
        </div>
      </div>

      <!-- PARTENERIATE -->
      <div
        class="
          rounded-2xl
          bg-[#0E3846]
          px-6
          sm:px-7
          py-7
          border
          border-[#245463]
        "
      >
        <div class="flex items-start gap-5">
          <a
            href="/sustenabilitate#sdg17"
            title="ODD 17 — Parteneriate pentru realizarea obiectivelor"
            aria-label="ODD 17 — Parteneriate pentru realizarea obiectivelor"
            class="
              shrink-0
              block
              rounded-lg
              overflow-hidden
              transition
              duration-200
              hover:-translate-y-1
              hover:shadow-lg
              focus:outline-none
              focus:ring-2
              focus:ring-[#F3C76B]
              focus:ring-offset-2
              focus:ring-offset-[#0E3846]
            "
          >
            <img
              src="/odd-17-ro.png"
              alt="ODD 17 — Parteneriate pentru realizarea obiectivelor"
              loading="lazy"
              class="
                block
                w-[88px]
                h-[88px]
                object-contain
              "
            />
          </a>

          <div>
            <p
              class="
                text-xs
                sm:text-sm
                font-bold
                uppercase
                tracking-[0.12em]
                text-[#A9D1DD]
              "
            >
              DIMENSIUNE TRANSVERSALĂ
            </p>

            <h3
              class="
                mt-2
                text-xl
                sm:text-[22px]
                font-bold
                text-white
              "
            >
              Parteneriate
            </h3>

            <p
              class="
                mt-2
                text-base
                sm:text-[17px]
                text-[#DCECEF]
                leading-7
              "
            >
              Colaborarea cu proprietari, tehnicieni, furnizori și alți actori
              locali transformă monitorizarea într-o acțiune coordonată.
            </p>
          </div>
        </div>
      </div>

    </div>

    <!-- NOTĂ SCURTĂ -->
    <div class="mt-8 max-w-4xl mx-auto text-center">
      <p
        class="
          text-sm
          sm:text-base
          text-[#607983]
          leading-7
        "
      >
        Obiectivele de Dezvoltare Durabilă indică domeniile în care activitatea
        noastră poate contribui la o administrare mai responsabilă a
        proprietății.
      </p>
    </div>

    <!-- CTA -->
    <div class="mt-8 text-center">
      <p
        class="
          text-base
          sm:text-lg
          text-[#405963]
          leading-7
        "
      >
        Vrei să afli cum pot contribui aceste principii la administrarea
        proprietății tale?
      </p>

      <a
        href="/sustenabilitate"
        class="
          inline-flex
          items-center
          justify-center
          gap-2
          mt-5
          border-2
          border-[#0E3846]
          hover:bg-[#0E3846]
          text-[#0E3846]
          hover:text-white
          font-bold
          px-7
          py-3.5
          rounded-xl
          text-sm
          sm:text-base
          transition
          uppercase
          tracking-wide
        "
      >
        DESCOPERĂ ABORDAREA NOASTRĂ
        <span aria-hidden="true">→</span>
      </a>
    </div>

  </div>
</section>
