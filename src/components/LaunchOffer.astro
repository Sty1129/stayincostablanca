---
// src/components/LaunchOffer.astro

const currentLang = Astro.currentLocale || 'ro';

const lang =
  currentLang === 'en' || currentLang === 'es'
    ? currentLang
    : 'ro';

const routes = {
  ro: {
    contact: '/contact',
  },
  en: {
    contact: '/en/contact',
  },
  es: {
    contact: '/es/contacto',
  },
};

const r = routes[lang];

const translations = {
  ro: {
    deadline: '31 octombrie 2026',

    eyebrow: 'OFERTĂ DE LANSARE',
    heading: 'Începem prin a cunoaște proprietatea ta.',

    introBefore:
      'Fiecare colaborare începe cu un',
    introStrong:
      'Property Onboarding & Baseline Assessment',
    introAfter:
      'Documentăm accesul, elementele tehnice esențiale și starea inițială a proprietății, astfel încât monitorizarea ulterioară să pornească de la o bază clară și documentată.',

    includesTitle: 'Evaluarea inițială include:',

    includes: [
      'Înregistrarea proprietății și a accesului',
      'Fotografii inițiale de referință',
      'Citiri inițiale ale contoarelor',
      'Identificarea punctelor tehnice esențiale',
      'Access Route Mapping',
      'Configurarea informațiilor de urgență',
      'Temperatură și umiditate inițială',
      'Registrul securizat al cheilor și accesului',
    ],

    cta: 'SOLICITĂ EVALUAREA PROPRIETĂȚII',

    onboarding: 'ALTA DE LA PROPIEDAD',
    baseline: '& Evaluación de referencia',

    standardValue: 'Valoare standard',
    vatIncluded: 'TVA inclus',

    included: 'INCLUS',
    includedSub: 'fără cost suplimentar',

    contractsBefore: 'Pentru contractele încheiate până la',

    afterDeadline:
      'După această dată se aplică tariful standard de 99 € TVA inclus.',
  },

  en: {
    deadline: '31 October 2026',

    eyebrow: 'LAUNCH OFFER',
    heading: 'We begin by getting to know your property.',

    introBefore:
      'Every new service relationship begins with a',
    introStrong:
      'Property Onboarding & Baseline Assessment',
    introAfter:
      'We document access, essential technical elements and the initial condition of the property so that future monitoring starts from a clear, documented baseline.',

    includesTitle: 'The initial assessment includes:',

    includes: [
      'Property and access registration',
      'Initial reference photographs',
      'Initial meter readings',
      'Identification of essential technical points',
      'Access Route Mapping',
      'Emergency information setup',
      'Initial temperature and humidity readings',
      'Secure key and access register',
    ],

    cta: 'REQUEST A PROPERTY ASSESSMENT',

    onboarding: 'ALTA DE LA PROPIEDAD',
    baseline: '& Evaluación de referencia',

    standardValue: 'Standard price',
    vatIncluded: 'VAT included',

    included: 'INCLUDED',
    includedSub: 'at no additional cost',

    contractsBefore: 'For contracts signed by',

    afterDeadline:
      'After this date, the standard fee of €99 VAT included will apply.',
  },

  es: {
    deadline: '31 de octubre de 2026',

    eyebrow: 'OFERTA DE LANZAMIENTO',
    heading: 'Empezamos por conocer tu propiedad.',

    introBefore:
      'Cada nueva colaboración comienza con un proceso de',
    introStrong:
      'alta de la propiedad y evaluación de referencia',
    introAfter:
      'Documentamos el acceso, los elementos técnicos esenciales y el estado inicial de la propiedad para que la monitorización posterior parta de una base clara y documentada.',

    includesTitle: 'La evaluación inicial incluye:',

    includes: [
      'Registro de la propiedad y de los accesos',
      'Fotografías iniciales de referencia',
      'Lecturas iniciales de los contadores',
      'Identificación de los puntos técnicos esenciales',
      'Mapeo de las rutas de acceso',
      'Configuración de la información de emergencia',
      'Temperatura y humedad iniciales',
      'Registro seguro de llaves y accesos',
    ],

    cta: 'SOLICITA LA EVALUACIÓN DE TU PROPIEDAD',

    onboarding: 'ALTA DE LA PROPIEDAD',
    baseline: '& Evaluación de referencia',

    standardValue: 'Precio estándar',
    vatIncluded: 'IVA incluido',

    included: 'INCLUIDO',
    includedSub: 'sin coste adicional',

    contractsBefore: 'Para contratos formalizados hasta el',

    afterDeadline:
      'Después de esta fecha se aplicará la tarifa estándar de 99 € IVA incluido.',
  },
};

const t = translations[lang];
---

<section
  id="oferta-lansare"
  class="py-14 sm:py-16 md:py-20 bg-white font-heading border-b border-[#D8E1E5]"
>
  <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8">

    <div
      class="
        relative
        overflow-hidden
        rounded-2xl
        border
        border-[#C9DDE3]
        bg-[#F7FAFA]
        shadow-[0_6px_24px_rgba(14,56,70,0.08)]
      "
    >

      <!-- TOP ACCENT -->
      <div class="h-1.5 w-full bg-[#D99B26]"></div>

      <div
        class="
          grid
          grid-cols-1
          lg:grid-cols-[1.45fr_0.75fr]
          gap-0
        "
      >

        <!-- =====================================================
             LEFT: EXPLANATION
        ====================================================== -->
        <div class="p-7 sm:p-9 lg:p-11">

          <p
            class="
              text-sm
              font-bold
              uppercase
              tracking-[0.16em]
              text-[#D99B26]
              mb-3
            "
          >
            {t.eyebrow}
          </p>

          <h2
            class="
              text-[28px]
              sm:text-3xl
              lg:text-[38px]
              font-bold
              text-[#0E3846]
              leading-tight
              tracking-tight
            "
          >
            {t.heading}
          </h2>

          <p
            class="
              mt-5
              text-base
              sm:text-lg
              text-[#405963]
              leading-7
              sm:leading-8
              max-w-2xl
            "
          >
            {t.introBefore}{' '}
            <strong class="text-[#0E3846]">
              {t.introStrong}
            </strong>.
            {' '}{t.introAfter}
          </p>

          <div class="mt-7">

            <p
              class="
                text-base
                sm:text-lg
                font-bold
                text-[#0E3846]
                mb-4
              "
            >
              {t.includesTitle}
            </p>

            <div
              class="
                grid
                grid-cols-1
                sm:grid-cols-2
                gap-x-8
                gap-y-3
                text-base
                text-[#294650]
              "
            >
              {t.includes.map((item) => (
                <div class="flex items-start gap-3">
                  <span class="text-[#5B9EB5] font-bold text-lg">✓</span>
                  <span>{item}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="mt-8">
            <a
              href={r.contact}
              class="
                inline-block
                w-full
                sm:w-auto
                text-center
                bg-[#0E3846]
                hover:bg-[#092A34]
                text-white
                font-bold
                py-3.5
                px-7
                rounded-xl
                text-sm
                sm:text-base
                uppercase
                tracking-wide
                transition
                shadow-sm
              "
            >
              {t.cta}
            </a>
          </div>

        </div>

        <!-- =====================================================
             RIGHT: OFFER
        ====================================================== -->
        <div
          class="
            bg-[#0E3846]
            text-white
            p-7
            sm:p-9
            lg:p-10
            flex
            flex-col
            justify-center
            items-center
            text-center
          "
        >

          <p
            class="
              text-sm
              font-bold
              uppercase
              tracking-[0.14em]
              text-[#A9D1DD]
            "
          >
            {t.onboarding}
          </p>

          <p
            class="
              mt-2
              text-sm
              sm:text-base
              text-[#DCECEF]
              leading-6
            "
          >
            {t.baseline}
          </p>

          <div class="mt-7">
            <p
              class="
                text-sm
                uppercase
                tracking-wider
                text-[#BCD7DE]
              "
            >
              {t.standardValue}
            </p>

            <div class="mt-1 flex justify-center items-baseline gap-2">
              <span
                class="
                  text-3xl
                  sm:text-4xl
                  font-bold
                  text-[#DCECEF]
                  line-through
                  decoration-[#D99B26]
                  decoration-2
                "
              >
                99 €
              </span>
            </div>

            <p class="text-sm text-[#BCD7DE] mt-1">
              {t.vatIncluded}
            </p>
          </div>

          <div
            class="
              mt-7
              w-full
              rounded-xl
              bg-white/10
              border
              border-white/20
              px-5
              py-5
            "
          >
            <p
              class="
                text-[26px]
                sm:text-3xl
                font-bold
                text-white
                leading-tight
              "
            >
              {t.included}
            </p>

            <p
              class="
                mt-1
                text-base
                sm:text-lg
                font-semibold
                text-[#DCECEF]
              "
            >
              {t.includedSub}
            </p>
          </div>

          <div class="mt-7">
            <p
              class="
                text-sm
                sm:text-base
                text-[#E7F1F3]
                leading-6
              "
            >
              {t.contractsBefore}
            </p>

            <p
              class="
                mt-1
                text-lg
                sm:text-xl
                font-bold
                text-[#F3C76B]
              "
            >
              {t.deadline}
            </p>
          </div>

          <p
            class="
              mt-6
              text-xs
              sm:text-sm
              text-[#AFCBD2]
              leading-5
              max-w-xs
            "
          >
            {t.afterDeadline}
          </p>

        </div>

      </div>

    </div>

  </div>
</section>
