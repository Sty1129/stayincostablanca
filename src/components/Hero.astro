---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { client } from '../data/client';
import { heroImage as localHeroImage } from '../config/images';

// Detecție limbă
const currentLang = Astro.currentLocale || 'ro';

const translations = {
  ro: {
    topper: 'Verificări Preventive · Dovezi Documentate · Coordonare Locală',
    heading: 'Casa ta din Costa Blanca, monitorizată profesionist când tu nu ești aici.',
    description: 'Nu ne limităm la o simplă vizită. Urmărim starea proprietății, documentăm schimbările și identificăm din timp situațiile care necesită atenție.',
    ctaLabel: 'DESCOPERĂ CUM ÎȚI PROTEJĂM PROPRIETATEA',
    ctaHref: '#cum-lucram',
    secondaryLabel: 'Vezi toate serviciile',
    secondaryHref: '/services',
    processBadge: 'Măsurăm · Comparăm · Documentăm · Detectăm · Acționăm',
    imageAlt: 'Monitorizare proprietăți în Costa Blanca Spania'
  },
  en: {
    topper: 'Local Expertise & Reliability',
    heading: 'Your Spanish home, in safe hands.',
    description: 'Full property management, car maintenance, and legal protection in Torrevieja and Orihuela Costa. We look after your home, so you can just enjoy the sun.',
    ctaLabel: 'Quote via WhatsApp',
    ctaHref: `https://wa.me/${client.phoneForTel.replace(/-/g, '')}?text=${encodeURIComponent('Hi Stelian! I would like to discuss property management for my home in Costa Blanca.')}`,
    secondaryLabel: 'Service Packages',
    secondaryHref: '/en/services',
    processBadge: '',
    imageAlt: 'Luxury villa in Costa Blanca Spain'
  }
};

const t = translations[currentLang] || translations.ro;

const PLACEHOLDER = 'https://images.unsplash.com/photo-1512917774080-9991f1c4c750?w=1200&q=80';

interface Props {
  topper?: string;
  heading?: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  imageSrc?: ImageMetadata | string;
  imageAlt?: string;
}

const {
  topper = t.topper,
  heading = t.heading,
  description = t.description,
  ctaLabel = t.ctaLabel,
  ctaHref = t.ctaHref,
  secondaryLabel = t.secondaryLabel,
  secondaryHref = t.secondaryHref,
  imageSrc = localHeroImage ?? PLACEHOLDER,
  imageAlt = t.imageAlt,
} = Astro.props;
---

<section class="relative overflow-hidden bg-background py-8 sm:py-12 md:py-16 font-heading">
  <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-6 px-4 sm:px-6 lg:grid-cols-2 lg:gap-10">

    <!-- Coloană Text / Stânga -->
    <div class="order-2 space-y-4 lg:order-1">
      {topper && (
        <span class="inline-block rounded-md bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700 border border-emerald-200/60">
          {topper}
        </span>
      )}

      <h1
        class="font-heading text-2xl sm:text-3xl lg:text-4xl font-bold leading-tight tracking-tight text-text"
        transition:name="hero-heading"
      >
        {heading}
      </h1>

      <p class="max-w-lg text-sm sm:text-base text-text-muted leading-relaxed">
        {description}
      </p>

      <!-- Butoane de acțiune cu verde -->
      <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:items-center">
        <a
          href={ctaHref}
          class="inline-flex min-h-[44px] items-center justify-center rounded-md bg-emerald-600 px-5 py-2.5 text-xs sm:text-sm font-bold text-white shadow-md transition-all hover:bg-emerald-700 text-center"
        >
          {ctaLabel}
        </a>
        <a
          href={secondaryHref}
          class="inline-flex min-h-[44px] items-center justify-center rounded-md border border-slate-300 bg-white px-5 py-2.5 text-xs sm:text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50 text-center"
        >
          {secondaryLabel}
        </a>
      </div>

      {t.processBadge && (
        <div class="pt-1">
          <p class="text-[11px] sm:text-xs font-semibold tracking-wide text-slate-400">
            {t.processBadge}
          </p>
        </div>
      )}
    </div>

    <!-- Coloană Imagine / Dreapta -->
    <div
      class="relative order-1 overflow-hidden rounded-xl shadow-lg aspect-4/3 lg:order-2"
      transition:name="hero-image"
    >
      <Image
        src={imageSrc}
        alt={imageAlt}
        width={800}
        height={600}
        loading="eager"
        decoding="async"
        class="size-full object-cover"
      />
    </div>
  </div>
</section>
