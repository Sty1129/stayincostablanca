---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { client } from '../data/client';
import { heroImage as localHeroImage } from '../config/images';

// Detectare limbă
const currentLang = Astro.currentLocale || 'ro';

const translations = {
  ro: {
    serviceLabel: 'KEY HOLDING & PROPERTY MANAGEMENT',
    location: 'Orihuela Costa & Torrevieja',
    heading: 'Proprietatea ta din Costa Blanca, verificată și administrată când tu nu ești aici.',
    description:
      'Păstrăm cheile în siguranță, verificăm periodic proprietatea, documentăm starea ei și te informăm atunci când ceva necesită atenție.',
    audience:
      'Pentru proprietarii care nu locuiesc permanent în Costa Blanca.',
    ctaLabel: 'DESCOPERĂ CUM ÎȚI PROTEJĂM PROPRIETATEA',
    ctaHref: '#cum-lucram',
    secondaryLabel: 'VEZI SERVICIILE ȘI PREȚURILE',
    secondaryHref: '/services',
    processBadge: 'MĂSURĂM · COMPARĂM · DOCUMENTĂM · DETECTĂM · ACȚIONĂM',
    imageAltPrimary: 'Proprietate modernă în Costa Blanca',
    imageAltSecondary: 'Vilă mediteraneană luminoasă',
    captionPrimaryTop: 'STAY IN COSTA BLANCA',
    captionPrimaryBottom: 'Key Holding & Property Management',
    captionSecondaryTop: 'PREZENȚĂ LOCALĂ',
    captionSecondaryBottom: 'Monitorizare responsabilă',
  },
  en: {
    serviceLabel: 'KEY HOLDING & PROPERTY MANAGEMENT',
    location: 'Orihuela Costa & Torrevieja',
    heading: 'Your Costa Blanca property, checked and managed while you are away.',
    description:
      'We keep your keys safe, inspect the property regularly, document its condition and inform you whenever something needs attention.',
    audience:
      'For owners who do not live permanently in Costa Blanca.',
    ctaLabel: 'DISCOVER HOW WE PROTECT YOUR PROPERTY',
    ctaHref: '#how-we-work',
    secondaryLabel: 'VIEW SERVICES & PRICING',
    secondaryHref: '/en/services',
    processBadge: 'MEASURE · COMPARE · DOCUMENT · DETECT · ACT',
    imageAltPrimary: 'Modern property in Costa Blanca',
    imageAltSecondary: 'Bright Mediterranean villa',
    captionPrimaryTop: 'STAY IN COSTA BLANCA',
    captionPrimaryBottom: 'Key Holding & Property Management',
    captionSecondaryTop: 'LOCAL PRESENCE',
    captionSecondaryBottom: 'Responsible monitoring',
  },
};

const t = translations[currentLang] || translations.ro;

// imaginea ta principală
const PRIMARY_PLACEHOLDER =
  'https://images.unsplash.com/photo-1512917774080-9991f1c4c750?w=1200&q=80';

// imagine secundară - recomand local în /public/hero-secondary.jpg
const secondaryImageSrc = '/hero-secondary.jpg';

interface Props {
  serviceLabel?: string;
  location?: string;
  heading?: string;
  description?: string;
  audience?: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  processBadge?: string;
  imageSrc?: ImageMetadata | string;
  imageAltPrimary?: string;
  imageAltSecondary?: string;
}

const {
  serviceLabel = t.serviceLabel,
  location = t.location,
  heading = t.heading,
  description = t.description,
  audience = t.audience,
  ctaLabel = t.ctaLabel,
  ctaHref = t.ctaHref,
  secondaryLabel = t.secondaryLabel,
  secondaryHref = t.secondaryHref,
  processBadge = t.processBadge,
  imageSrc = localHeroImage ?? PRIMARY_PLACEHOLDER,
  imageAltPrimary = t.imageAltPrimary,
  imageAltSecondary = t.imageAltSecondary,
} = Astro.props;
---

<section class="relative overflow-hidden bg-background py-12 sm:py-16 md:py-20 font-heading border-b border-border">
  <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-12">

    <!-- TEXT -->
    <div class="order-1">
      <div class="inline-flex w-full max-w-[420px] flex-col rounded-2xl bg-[#0E3846] px-5 py-4 shadow-lg">
        <div class="flex items-center gap-3">
          <span class="h-2.5 w-2.5 rounded-full bg-[#D99B26]"></span>
          <span class="text-sm font-extrabold uppercase tracking-[0.08em] text-white sm:text-base">
            {serviceLabel}
          </span>
        </div>

        <div class="mt-3 flex items-center gap-2 text-[#F3C76B]">
          <svg
            class="h-4 w-4 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21s-6-4.35-6-10a6 6 0 1112 0c0 5.65-6 10-6 10z" />
            <circle cx="12" cy="11" r="2.5" />
          </svg>
          <span class="text-sm font-bold text-white sm:text-base">
            {location}
          </span>
        </div>
      </div>

      <h1
        class="mt-6 max-w-[12ch] text-4xl font-bold leading-[0.95] tracking-tight text-[#0E3846] sm:text-5xl lg:text-6xl"
        transition:name="hero-heading"
      >
        {heading}
      </h1>

      <p class="mt-6 max-w-xl text-base leading-8 text-[#405963] sm:text-lg">
        {description}
      </p>

      <div class="mt-5 flex items-start gap-3 rounded-xl bg-[#F7FAFA] px-4 py-4 border border-[#D8E1E5] max-w-xl">
        <div class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#EAF4F6] text-[#5B9EB5]">
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21s-6-4.35-6-10a6 6 0 1112 0c0 5.65-6 10-6 10z" />
            <circle cx="12" cy="11" r="2.5" />
          </svg>
        </div>
        <p class="text-sm font-semibold leading-6 text-[#0E3846] sm:text-base">
          {audience}
        </p>
      </div>

      <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href={ctaHref}
          class="inline-flex min-h-[52px] items-center justify-center rounded-xl bg-[#0E3846] px-6 py-3 text-center text-sm font-extrabold uppercase tracking-wide text-white shadow-md transition hover:bg-[#12495C] sm:text-base"
        >
          {ctaLabel}
        </a>

        <a
          href={secondaryHref}
          class="inline-flex min-h-[52px] items-center justify-center rounded-xl border-2 border-[#0E3846] bg-white px-6 py-3 text-center text-sm font-extrabold uppercase tracking-wide text-[#0E3846] transition hover:bg-[#0E3846] hover:text-white sm:text-base"
        >
          {secondaryLabel}
        </a>
      </div>

      {processBadge && (
        <div class="mt-6 border-t border-[#D8E1E5] pt-5">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#6B8792] sm:text-sm">
            {processBadge}
          </p>
        </div>
      )}
    </div>

    <!-- IMAGINI -->
    <div
      class="order-2"
      transition:name="hero-image"
    >
      <div class="overflow-hidden rounded-2xl border border-[#D8E1E5] bg-white shadow-xl">
        <div class="grid grid-cols-1">
          <!-- imaginea 1 -->
          <div class="relative h-[230px] sm:h-[270px] lg:h-[280px]">
            {typeof imageSrc === 'string' ? (
              <img
                src={imageSrc}
                alt={imageAltPrimary}
                loading="eager"
                class="h-full w-full object-cover"
              />
            ) : (
              <Image
                src={imageSrc}
                alt={imageAltPrimary}
                width={1200}
                height={800}
                loading="eager"
                decoding="async"
                class="h-full w-full object-cover"
              />
            )}

            <div class="absolute bottom-4 left-4 rounded-xl bg-white/95 px-4 py-3 shadow-lg backdrop-blur-sm">
              <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[#D99B26]">
                {t.captionPrimaryTop}
              </p>
              <p class="mt-1 text-sm font-extrabold text-[#0E3846] sm:text-base">
                {t.captionPrimaryBottom}
              </p>
            </div>
          </div>

          <!-- separator -->
          <div class="h-1.5 bg-gradient-to-r from-[#D99B26] via-[#0E3846] to-[#5B9EB5]"></div>

          <!-- imaginea 2 -->
          <div class="relative h-[230px] sm:h-[270px] lg:h-[280px]">
            <img
              src={secondaryImageSrc}
              alt={imageAltSecondary}
              loading="lazy"
              class="h-full w-full object-cover"
            />

            <div class="absolute bottom-4 left-4 rounded-xl bg-white/95 px-4 py-3 shadow-lg backdrop-blur-sm">
              <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[#D99B26]">
                {t.captionSecondaryTop}
              </p>
              <p class="mt-1 text-sm font-extrabold text-[#0E3846] sm:text-base">
                {t.captionSecondaryBottom}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
