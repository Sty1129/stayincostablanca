---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { client } from '../data/client';
import { heroImage as localHeroImage } from '../config/images';

// Limbă curentă
const currentLang = Astro.currentLocale || 'ro';

const translations = {
  ro: {
    serviceType: 'KEY HOLDING & PROPERTY MANAGEMENT',
    location: 'Orihuela Costa & Torrevieja',

    heading:
      'Proprietatea ta din Costa Blanca, verificată și administrată când tu nu ești aici.',

    description:
      'Păstrăm cheile în siguranță, verificăm periodic proprietatea, documentăm starea ei și te informăm atunci când ceva necesită atenție.',

    reassurance:
      'Pentru proprietarii care nu locuiesc permanent în Costa Blanca.',

    ctaLabel: 'DESCOPERĂ CUM ÎȚI PROTEJĂM PROPRIETATEA',
    ctaHref: '#cum-lucram',

    secondaryLabel: 'VEZI SERVICIILE ȘI PREȚURILE',
    secondaryHref: '/services',

    processBadge:
      'Măsurăm · Comparăm · Documentăm · Detectăm · Acționăm',

    imageAlt:
      'Servicii de key holding și property management în Costa Blanca'
  },

  en: {
    serviceType: 'KEY HOLDING & PROPERTY MANAGEMENT',
    location: 'Orihuela Costa & Torrevieja',

    heading:
      'Your Costa Blanca property, professionally looked after while you are away.',

    description:
      'We securely hold your keys, carry out scheduled property checks, document its condition and keep you informed when something needs attention.',

    reassurance:
      'For owners who do not live permanently in Costa Blanca.',

    ctaLabel: 'SEE HOW WE PROTECT YOUR PROPERTY',
    ctaHref: '#cum-lucram',

    secondaryLabel: 'VIEW SERVICES & PRICES',
    secondaryHref: '/en/services',

    processBadge:
      'Measure · Compare · Document · Detect · Act',

    imageAlt:
      'Key holding and property management services in Costa Blanca'
  }
};

const t = translations[currentLang] || translations.ro;

const PLACEHOLDER =
  'https://images.unsplash.com/photo-1512917774080-9991f1c4c750?w=1200&q=80';

interface Props {
  serviceType?: string;
  location?: string;
  heading?: string;
  description?: string;
  reassurance?: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  processBadge?: string;
  imageSrc?: ImageMetadata | string;
  imageAlt?: string;
}

const {
  serviceType = t.serviceType,
  location = t.location,
  heading = t.heading,
  description = t.description,
  reassurance = t.reassurance,
  ctaLabel = t.ctaLabel,
  ctaHref = t.ctaHref,
  secondaryLabel = t.secondaryLabel,
  secondaryHref = t.secondaryHref,
  processBadge = t.processBadge,
  imageSrc = localHeroImage ?? PLACEHOLDER,
  imageAlt = t.imageAlt,
} = Astro.props;
---

<section
  class="
    relative
    overflow-hidden
    bg-[#F7FAFA]
    font-heading
    border-b
    border-[#D8E1E5]
  "
>
  <!-- Accent discret de fundal -->
  <div
    class="
      pointer-events-none
      absolute
      -top-32
      -left-32
      w-[420px]
      h-[420px]
      rounded-full
      bg-[#5B9EB5]/10
      blur-3xl
    "
    aria-hidden="true"
  ></div>

  <div
    class="
      relative
      mx-auto
      max-w-site
      px-4
      sm:px-6
      lg:px-8
      py-9
      sm:py-12
      md:py-16
      lg:py-20
    "
  >
    <div
      class="
        grid
        grid-cols-1
        lg:grid-cols-2
        items-center
        gap-9
        lg:gap-14
      "
    >

      <!-- =====================================================
           TEXT
           IMPORTANT: apare PRIMUL pe mobil
      ====================================================== -->

      <div class="order-1">

        <!-- IDENTIFICAREA SERVICIULUI -->
        <div class="mb-5">

          <div
            class="
              inline-flex
              items-center
              gap-2
              rounded-lg
              bg-[#0E3846]
              px-4
              py-2.5
              shadow-sm
            "
          >
            <span
              class="
                block
                w-2
                h-2
                rounded-full
                bg-[#D99B26]
                shrink-0
              "
              aria-hidden="true"
            ></span>

            <span
              class="
                text-[13px]
                sm:text-sm
                font-bold
                uppercase
                tracking-[0.12em]
                text-white
              "
            >
              {serviceType}
            </span>
          </div>


          <!-- LOCAȚIE -->
          <p
            class="
              mt-3
              text-sm
              sm:text-base
              font-semibold
              text-[#5B7882]
            "
          >
            {location}
          </p>

        </div>


        <!-- TITLU PRINCIPAL -->
        <h1
          class="
            max-w-2xl
            text-[32px]
            sm:text-[40px]
            lg:text-[48px]
            xl:text-[52px]
            font-bold
            leading-[1.1]
            tracking-tight
            text-[#0E3846]
          "
          transition:name="hero-heading"
        >
          {heading}
        </h1>


        <!-- DESCRIERE FOARTE CLARĂ -->
        <p
          class="
            mt-5
            max-w-2xl
            text-[17px]
            sm:text-lg
            text-[#405963]
            leading-7
            sm:leading-8
          "
        >
          {description}
        </p>


        <!-- CLARIFICARE PENTRU CINE ESTE SERVICIUL -->
        <div
          class="
            mt-5
            flex
            items-start
            gap-3
            max-w-xl
          "
        >
          <div
            class="
              mt-0.5
              flex
              items-center
              justify-center
              w-7
              h-7
              shrink-0
              rounded-full
              bg-[#E2F0F4]
              text-[#0E3846]
            "
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              class="w-4 h-4"
              aria-hidden="true"
            >
              <path
                d="M12 21s7-5.1 7-11a7 7 0 10-14 0c0 5.9 7 11 7 11z"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />

              <circle
                cx="12"
                cy="10"
                r="2.3"
                stroke-width="1.8"
              />
            </svg>
          </div>

          <p
            class="
              text-[15px]
              sm:text-base
              font-semibold
              text-[#294A55]
              leading-7
            "
          >
            {reassurance}
          </p>
        </div>


        <!-- =================================================
             CTA
        ================================================== -->

        <div
          class="
            mt-7
            flex
            flex-col
            sm:flex-row
            sm:items-center
            gap-3
          "
        >

          <!-- CTA PRINCIPAL -->
          <a
            href={ctaHref}
            class="
              inline-flex
              min-h-[52px]
              items-center
              justify-center
              rounded-xl
              bg-[#0E3846]
              px-6
              py-3.5
              text-sm
              sm:text-[15px]
              font-bold
              text-white
              shadow-[0_7px_18px_rgba(14,56,70,0.18)]
              transition-all
              duration-200
              hover:bg-[#164D5D]
              hover:-translate-y-0.5
              text-center
              uppercase
              tracking-[0.04em]
            "
          >
            {ctaLabel}
          </a>


          <!-- CTA SECUNDAR -->
          <a
            href={secondaryHref}
            class="
              inline-flex
              min-h-[52px]
              items-center
              justify-center
              rounded-xl
              border-2
              border-[#0E3846]
              bg-white
              px-6
              py-3.5
              text-sm
              sm:text-[15px]
              font-bold
              text-[#0E3846]
              transition-all
              duration-200
              hover:bg-[#EAF4F6]
              text-center
              uppercase
              tracking-[0.04em]
            "
          >
            {secondaryLabel}
          </a>

        </div>


        <!-- PROCES -->
        {processBadge && (
          <div
            class="
              mt-6
              pt-5
              border-t
              border-[#D3E1E5]
              max-w-2xl
            "
          >
            <p
              class="
                text-xs
                sm:text-[13px]
                font-bold
                uppercase
                tracking-[0.09em]
                text-[#6A838C]
                leading-6
              "
            >
              {processBadge}
            </p>
          </div>
        )}

      </div>


      <!-- =====================================================
           IMAGINE
           PE MOBIL VINE DUPĂ TEXT
      ====================================================== -->

      <div
        class="
          relative
          order-2
          overflow-hidden
          rounded-2xl
          shadow-[0_16px_35px_rgba(14,56,70,0.16)]
          aspect-[4/3]
          border
          border-[#D2E1E5]
        "
        transition:name="hero-image"
      >

        <Image
          src={imageSrc}
          alt={imageAlt}
          width={800}
          height={600}
          loading="eager"
          decoding="async"
          class="
            size-full
            object-cover
          "
        />


        <!-- Overlay foarte discret -->
        <div
          class="
            absolute
            inset-0
            bg-gradient-to-t
            from-[#0E3846]/20
            via-transparent
            to-transparent
            pointer-events-none
          "
          aria-hidden="true"
        ></div>


        <!-- IDENTIFICARE PE IMAGINE -->
        <div
          class="
            absolute
            left-4
            right-4
            bottom-4
            sm:left-5
            sm:right-auto
            sm:bottom-5
            bg-white/95
            backdrop-blur-sm
            rounded-xl
            px-4
            py-3
            shadow-lg
            border
            border-white/70
          "
        >
          <p
            class="
              text-[11px]
              font-bold
              uppercase
              tracking-[0.12em]
              text-[#D99B26]
            "
          >
            Stay in Costa Blanca
          </p>

          <p
            class="
              mt-0.5
              text-sm
              font-bold
              text-[#0E3846]
            "
          >
            Key Holding & Property Management
          </p>
        </div>

      </div>

    </div>
  </div>
</section>
