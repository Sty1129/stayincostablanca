---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { client } from '../data/client';
import { heroImage as localHeroImage } from '../config/images';

// Detecție limbă
const currentLang = Astro.currentLocale || 'ro';

const translations = {
  ro: {
    topper: 'Verificări Preventive · Dovezi Documentate · Coordonare Locală',
    heading: 'Casa ta din Costa Blanca, monitorizată profesionist când tu nu ești aici.',
    description: 'Nu ne limităm la o simplă vizită. Urmărim starea proprietății, documentăm schimbările și identificăm din timp situațiile care necesită atenție.',
    ctaLabel: 'DESCOPERĂ CUM ÎȚI PROTEJĂM PROPRIETATEA',
    ctaHref: '#pachete',
    secondaryLabel: 'VEZI TOATE SERVICIILE',
    secondaryHref: '/services',
    processBadge: 'Măsurăm · Comparăm · Documentăm · Detectăm · Acționăm',
    imageAlt: 'Monitorizare proprietăți în Costa Blanca Spania'
  },
  en: {
    topper: 'Local Expertise & Reliability',
    heading: 'Your Spanish home, in safe hands.',
    description: 'Full property management, car maintenance, and legal protection in Torrevieja and Orihuela Costa. We look after your home, so you can just enjoy the sun.',
    ctaLabel: 'Quote via WhatsApp',
    ctaHref: `https://wa.me/${client.phoneForTel.replace(/-/g, '')}?text=${encodeURIComponent('Hi Stelian! I would like to discuss property management for my home in Costa Blanca.')}`,
    secondaryLabel: 'Service Packages',
    secondaryHref: '/en/services',
    processBadge: '',
    imageAlt: 'Luxury villa in Costa Blanca Spain'
  }
};

const t = translations[currentLang] || translations.ro;

const PLACEHOLDER = 'https://images.unsplash.com/photo-1512917774080-9991f1c4c750?w=1200&q=80';

interface Props {
  topper?: string;
  heading?: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  imageSrc?: ImageMetadata | string;
  imageAlt?: string;
}

const {
  topper = t.topper,
  heading = t.heading,
  description = t.description,
  ctaLabel = t.ctaLabel,
  ctaHref = t.ctaHref,
  secondaryLabel = t.secondaryLabel,
  secondaryHref = t.secondaryHref,
  imageSrc = localHeroImage ?? PLACEHOLDER,
  imageAlt = t.imageAlt,
} = Astro.props;
---

<section class="relative overflow-hidden bg-background py-12 sm:py-16 md:py-20 lg:py-24 font-heading">
  <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-12">

    <div class="order-2 space-y-5 lg:order-1 lg:space-y-6">
      {topper && (
        <span class="inline-block rounded-full bg-accent/10 px-4 py-1.5 text-topper font-bold uppercase tracking-widest text-accent">
          {topper}
        </span>
      )}

      <h1
        class="font-heading text-display font-bold uppercase leading-tight tracking-tight text-text"
        transition:name="hero-heading"
      >
        {heading}
      </h1>

      <p class="max-w-lg text-lead text-text-muted leading-relaxed">
        {description}
      </p>

      <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:items-center sm:gap-4">
        <a
          href={ctaHref}
          class="inline-flex min-h-[44px] items-center justify-center rounded-md bg-blue-600 px-6 py-3 text-base font-bold text-white shadow-lg transition-all hover:bg-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent text-center"
        >
          {ctaLabel}
        </a>
        <a
          href={secondaryHref}
          class="inline-flex min-h-[44px] items-center justify-center rounded-md border-2 border-slate-900 px-6 py-3 text-base font-bold text-slate-900 transition-colors hover:bg-slate-900 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary text-center"
        >
          {secondaryLabel}
        </a>
      </div>

      {t.processBadge && (
        <div class="pt-2">
          <p class="text-xs sm:text-sm font-bold uppercase tracking-wider text-slate-500">
            {t.processBadge}
          </p>
        </div>
      )}
    </div>

    <div
      class="relative order-1 overflow-hidden rounded-2xl shadow-2xl aspect-4/3 lg:order-2"
      transition:name="hero-image"
    >
      <Image
        src={imageSrc}
        alt={imageAlt}
        width={800}
        height={600}
        loading="eager"
        decoding="async"
        class="size-full object-cover"
      />
    </div>
  </div>
</section>
