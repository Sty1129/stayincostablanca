---
// src/components/Hero.astro

const currentLang = Astro.currentLocale || "ro";

const translations = {
  ro: {
    serviceType: "KEY HOLDING & PROPERTY MANAGEMENT",
    location: "Orihuela Costa & Torrevieja",

    heading:
      "Proprietatea ta din Costa Blanca, verificată și administrată când tu nu ești aici.",

    description:
      "Păstrăm cheile în siguranță, verificăm periodic proprietatea, documentăm starea ei și te informăm atunci când ceva necesită atenție.",

    reassurance:
      "Pentru proprietarii care nu locuiesc permanent în Costa Blanca.",

    ctaLabel:
      "DESCOPERĂ CUM ÎȚI PROTEJĂM PROPRIETATEA",

    ctaHref:
      "#cum-lucram",

    secondaryLabel:
      "VEZI SERVICIILE ȘI PREȚURILE",

    secondaryHref:
      "/services",

    processBadge:
      "MĂSURĂM · COMPARĂM · DOCUMENTĂM · DETECTĂM · ACȚIONĂM",

    imageAlt:
      "Proprietate cu piscină în Costa Blanca",
  },

  en: {
    serviceType:
      "KEY HOLDING & PROPERTY MANAGEMENT",

    location:
      "Orihuela Costa & Torrevieja",

    heading:
      "Your Costa Blanca property, checked and managed while you are away.",

    description:
      "We keep your keys safe, inspect the property regularly, document its condition and inform you whenever something needs attention.",

    reassurance:
      "For owners who do not live permanently in Costa Blanca.",

    ctaLabel:
      "DISCOVER HOW WE PROTECT YOUR PROPERTY",

    ctaHref:
      "#how-we-work",

    secondaryLabel:
      "VIEW SERVICES & PRICING",

    secondaryHref:
      "/en/services",

    processBadge:
      "MEASURE · COMPARE · DOCUMENT · DETECT · ACT",

    imageAlt:
      "Property with swimming pool in Costa Blanca",
  },

  es: {
    serviceType:
      "KEY HOLDING & PROPERTY MANAGEMENT",

    location:
      "Orihuela Costa & Torrevieja",

    heading:
      "Tu propiedad en Costa Blanca, revisada y gestionada cuando no estás aquí.",

    description:
      "Custodiamos tus llaves de forma segura, revisamos periódicamente la propiedad, documentamos su estado y te informamos cuando algo requiere atención.",

    reassurance:
      "Para propietarios que no residen permanentemente en Costa Blanca.",

    ctaLabel:
      "DESCUBRE CÓMO PROTEGEMOS TU PROPIEDAD",

    ctaHref:
      "#como-trabajamos",

    secondaryLabel:
      "VER SERVICIOS Y PRECIOS",

    secondaryHref:
      "/es/services",

    processBadge:
      "MEDIMOS · COMPARAMOS · DOCUMENTAMOS · DETECTAMOS · ACTUAMOS",

    imageAlt:
      "Propiedad con piscina en Costa Blanca",
  },
};

const lang =
  currentLang === "en" || currentLang === "es"
    ? currentLang
    : "ro";

const t = translations[lang];
---

<section
  class="
    relative
    overflow-hidden
    bg-[#F7FAFA]
    font-heading
    border-b
    border-[#D8E1E5]
  "
>

  <!-- FUNDAL DISCRET -->

  <div
    class="
      pointer-events-none
      absolute
      -top-32
      -left-32
      h-[420px]
      w-[420px]
      rounded-full
      bg-[#5B9EB5]/10
      blur-3xl
    "
    aria-hidden="true"
  ></div>


  <div
    class="
      relative
      mx-auto
      max-w-site
      px-4
      sm:px-6
      lg:px-8
      py-10
      sm:py-12
      md:py-16
      lg:py-20
    "
  >

    <!-- =====================================================
         GRID PRINCIPAL
    ====================================================== -->

    <div
      class="
        grid
        grid-cols-1
        lg:grid-cols-2
        gap-10
        lg:gap-14
        xl:gap-16
        lg:items-stretch
      "
    >

      <!-- ===================================================
           STÂNGA
      ==================================================== -->

      <div
        class="
          order-1
          flex
          flex-col
          justify-center
          w-full
        "
      >

        <!-- =================================================
             CASSETĂ SERVICIU
             
             IMPORTANT:
             w-full = aceeași lățime ca rândul butoanelor
        ================================================== -->

        <div
          class="
            w-full
            rounded-xl
            bg-[#0E3846]
            px-5
            sm:px-6
            py-4
            shadow-[0_10px_24px_rgba(14,56,70,0.18)]
            border
            border-[#1C5161]
          "
        >

          <div
            class="
              flex
              items-center
              gap-3
            "
          >

            <span
              class="
                h-2.5
                w-2.5
                shrink-0
                rounded-full
                bg-[#D99B26]
              "
              aria-hidden="true"
            ></span>

            <span
              class="
                text-[13px]
                sm:text-[15px]
                font-bold
                uppercase
                tracking-[0.1em]
                leading-5
                text-white
              "
            >
              {t.serviceType}
            </span>

          </div>


          <div
            class="
              mt-3
              flex
              items-center
              gap-3
            "
          >

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              class="
                h-4
                w-4
                shrink-0
                text-[#D99B26]
              "
              aria-hidden="true"
            >
              <path
                d="M12 21s7-5.1 7-11a7 7 0 10-14 0c0 5.9 7 11 7 11z"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />

              <circle
                cx="12"
                cy="10"
                r="2.3"
                stroke-width="1.8"
              />
            </svg>

            <span
              class="
                text-sm
                sm:text-[15px]
                font-semibold
                text-white
              "
            >
              {t.location}
            </span>

          </div>

        </div>


        <!-- =================================================
             TITLU
             
             CENTRAT
        ================================================== -->

        <h1
          class="
            mt-7
            w-full

            text-center

            text-[36px]
            sm:text-[42px]
            lg:text-[46px]
            xl:text-[50px]

            font-bold

            leading-[1.08]
            tracking-tight

            text-[#0E3846]
          "
          transition:name="hero-heading"
        >
          {t.heading}
        </h1>


        <!-- =================================================
             DESCRIERE
        ================================================== -->

        <p
          class="
            mt-6
            w-full
            text-[16px]
            sm:text-[17px]
            leading-7
            sm:leading-8
            text-[#405963]
          "
        >
          {t.description}
        </p>


        <!-- =================================================
             REASSURANCE
        ================================================== -->

        <div
          class="
            mt-5
            flex
            items-center
            gap-3
            w-full
          "
        >

          <div
            class="
              flex
              h-8
              w-8
              shrink-0
              items-center
              justify-center
              rounded-full
              bg-[#E2F0F4]
              text-[#0E3846]
            "
          >

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              class="
                h-4
                w-4
              "
              aria-hidden="true"
            >
              <path
                d="M12 21s7-5.1 7-11a7 7 0 10-14 0c0 5.9 7 11 7 11z"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />

              <circle
                cx="12"
                cy="10"
                r="2.3"
                stroke-width="1.8"
              />
            </svg>

          </div>


          <p
            class="
              text-[14px]
              sm:text-[15px]
              font-bold
              leading-6
              text-[#294A55]
            "
          >
            {t.reassurance}
          </p>

        </div>


        <!-- =================================================
             BUTOANE
             
             GRID = împreună ocupă exact 100% din lățime
        ================================================== -->

        <div
          class="
            mt-7
            grid
            grid-cols-1
            sm:grid-cols-[1.35fr_0.95fr]
            gap-3
            w-full
          "
        >

          <!-- PRINCIPAL -->

          <a
            href={t.ctaHref}
            class="
              flex
              min-h-[60px]
              items-center
              justify-center

              rounded-xl

              bg-[#0E3846]

              px-5
              py-3.5

              text-center

              text-[13px]
              sm:text-[14px]

              font-bold
              uppercase
              tracking-[0.03em]
              leading-5

              text-white

              shadow-[0_7px_18px_rgba(14,56,70,0.18)]

              transition-all
              duration-200

              hover:bg-[#164D5D]
              hover:-translate-y-0.5
            "
          >
            {t.ctaLabel}
          </a>


          <!-- SECUNDAR -->

          <a
            href={t.secondaryHref}
            class="
              flex
              min-h-[60px]
              items-center
              justify-center

              rounded-xl

              border-2
              border-[#0E3846]

              bg-white

              px-5
              py-3.5

              text-center

              text-[13px]
              sm:text-[14px]

              font-bold
              uppercase
              tracking-[0.03em]
              leading-5

              text-[#0E3846]

              transition-all
              duration-200

              hover:bg-[#EAF4F6]
            "
          >
            {t.secondaryLabel}
          </a>

        </div>


        <!-- =================================================
             PROCES
        ================================================== -->

        <div
          class="
            mt-6
            pt-5
            border-t
            border-[#D3E1E5]
            w-full
          "
        >

          <p
            class="
              text-center
              text-[11px]
              sm:text-[12px]
              xl:text-[13px]
              font-bold
              uppercase
              tracking-[0.08em]
              leading-6
              text-[#6A838C]
            "
          >
            {t.processBadge}
          </p>

        </div>

      </div>


      <!-- ===================================================
           DREAPTA - IMAGINE
      ==================================================== -->

      <div
        class="
          order-2
          relative
          overflow-hidden

          rounded-2xl

          border
          border-[#D2E1E5]

          bg-[#EAF2F4]

          shadow-[0_18px_40px_rgba(14,56,70,0.16)]

          aspect-[4/5]

          lg:aspect-auto
          lg:h-full
          lg:min-h-[100%]
        "
        transition:name="hero-image"
      >

        <!-- FOTOGRAFIE -->

        <img
          src="/hero-secondary.jpg"
          alt={t.imageAlt}
          loading="eager"
          decoding="async"
          class="
            absolute
            inset-0
            h-full
            w-full
            object-cover
            object-center
          "
        />


        <!-- Gradient foarte discret -->

        <div
          class="
            absolute
            inset-0
            bg-gradient-to-t
            from-[#0E3846]/10
            via-transparent
            to-transparent
            pointer-events-none
          "
          aria-hidden="true"
        ></div>


        <!-- =================================================
             LOGO COLORAT PESTE FOTOGRAFIE
             
             FĂRĂ CASETĂ ALBĂ
        ================================================== -->

        <div
          class="
            absolute

            left-5
            bottom-5

            sm:left-6
            sm:bottom-6

            lg:left-7
            lg:bottom-7

            z-20

            pointer-events-none
          "
        >

          <img
            src="/sicb-symbol.png"
            alt=""
            aria-hidden="true"
            class="
              w-[125px]
              sm:w-[145px]
              lg:w-[155px]
              xl:w-[170px]

              h-auto

              opacity-90

              drop-shadow-[0_5px_10px_rgba(0,0,0,0.20)]
            "
          />

        </div>

      </div>

    </div>

  </div>

</section>
