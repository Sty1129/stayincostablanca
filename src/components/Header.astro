---
import { brand } from '../config/brand';

// 1. Detectare limbă & Selector extins (EN, ES, FR, DE, RO)
const url = new URL(Astro.request.url);
const pathname = url.pathname;

let currentLang = 'ro';
if (pathname.startsWith('/en')) currentLang = 'en';
else if (pathname.startsWith('/es')) currentLang = 'es';
else if (pathname.startsWith('/fr')) currentLang = 'fr';
else if (pathname.startsWith('/de')) currentLang = 'de';

const base = currentLang === 'en' ? '/en' : (currentLang === 'ro' ? '' : `/${currentLang}`);

const translations = {
  ro: { home: 'Acasă', about: 'Despre noi', services: 'Servicii', reviews: 'Recenzii', blog: 'Blog', contact: 'Contact', cta: 'Cere Ofertă' },
  en: { home: 'Home', about: 'About Us', services: 'Services', reviews: 'Reviews', blog: 'Blog', contact: 'Contact', cta: 'Get a Quote' },
  es: { home: 'Inicio', about: 'Sobre nosotros', services: 'Servicios', reviews: 'Reseñas', blog: 'Blog', contact: 'Contacto', cta: 'Pedir Oferta' },
  fr: { home: 'Accueil', about: 'À propos', services: 'Services', reviews: 'Avis', blog: 'Blog', contact: 'Contact', cta: 'Obtenir un devis' },
  de: { home: 'Startseite', about: 'Über uns', services: 'Leistungen', reviews: 'Bewertungen', blog: 'Blog', contact: 'Kontakt', cta: 'Angebot anfordern' }
};

const t = translations[currentLang] || translations.ro;

const phoneFormatted = "+34 624 110 656";
const phoneForTel = "34624110656";
const waMessage = encodeURIComponent("Bună ziua! Doresc mai multe informații despre serviciile de administrare.");
const waLink = `https://wa.me/${phoneForTel}?text=${waMessage}`;

const nav = [
  { label: t.home,     href: currentLang === 'en' ? '/en/' : (currentLang === 'ro' ? '/' : `/${currentLang}/`) },
  { label: t.about,    href: `${base}/about` },
  { label: t.services, href: `${base}/services` },
  { label: t.reviews,  href: `${base}/reviews` },
  { label: t.blog,     href: `${base}/blog` },
  { label: t.contact,  href: `${base}/contact` },
];

const languages = [
  { code: 'en', label: 'EN', href: '/en/' },
  { code: 'es', label: 'ES', href: '/es/' },
  { code: 'fr', label: 'FR', href: '/fr/' },
  { code: 'de', label: 'DE', href: '/de/' },
  { code: 'ro', label: 'RO', href: '/' }
];
---

<header class="sticky top-0 z-50 w-full border-b border-emerald-100 bg-white/95 backdrop-blur-sm font-heading">
  <div class="mx-auto flex max-w-site items-center justify-between px-4 py-2 sm:px-6">
    
    {/* Logo + Nume Brand */}
    <a href={currentLang === 'en' ? '/en/' : (currentLang === 'ro' ? '/' : `/${currentLang}/`)} class="flex items-center gap-3 transition-opacity hover:opacity-90">
      <img src="/SICB logo.webp" alt="Stay in Costa Blanca Logo" class="h-12 w-auto object-contain" />
      <span class="font-heading text-lg font-black uppercase tracking-tight text-emerald-950 hidden sm:inline-block">
        {brand.name}
      </span>
    </a>

    {/* Navigare Desktop */}
    <nav class="hidden items-center gap-1 xl:flex">
      {nav.map(({ label, href }) => {
        const isActive = pathname === href || (href !== '/' && href !== '/en/' && pathname.startsWith(href));
        return (
          <a
            href={href}
            class:list={[
              'rounded-md px-3 py-2 text-sm font-bold transition-all duration-200',
              isActive ? 'bg-emerald-700 text-white shadow-md' : 'text-slate-700 hover:text-emerald-700 hover:bg-emerald-50',
            ]}
          >
            {label}
          </a>
        );
      })}
    </nav>

    {/* Limbi + Telefon + CTA Desktop */}
    <div class="hidden items-center gap-4 lg:flex">
      {/* Selector Limbi EN, ES, FR, DE, RO */}
      <div class="flex items-center bg-slate-100 p-1 rounded-full border border-slate-200">
        {languages.map((lang) => (
          <a
            href={lang.href}
            class:list={[
              "px-2.5 py-1 rounded-full text-[10px] font-black transition-all",
              currentLang === lang.code ? "bg-emerald-700 text-white shadow-md" : "text-slate-600 hover:text-emerald-800"
            ]}
          >
            {lang.label}
          </a>
        ))}
      </div>

      {/* Telefon Direct */}
      <a href={`tel:${phoneForTel}`} class="text-xs font-bold text-slate-800 hover:text-emerald-700 transition-colors flex items-center gap-1.5">
        <svg class="size-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
          <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        {phoneFormatted}
      </a>
      
      {/* CTA Cere Ofertă - Galben cu hover Verde */}
      <a 
        href={waLink} 
        target="_blank" 
        class="inline-flex h-10 items-center rounded-lg bg-amber-400 px-5 text-xs font-black uppercase text-slate-900 shadow-md transition-all duration-300 hover:bg-emerald-600 hover:text-white hover:shadow-lg"
      >
        {t.cta}
      </a>
    </div>

    {/* Limbi & Meniu Mobil */}
    <div class="flex items-center gap-2 lg:hidden">
      <div class="flex items-center bg-slate-100 p-0.5 rounded-full border border-slate-200">
        {languages.map((lang) => (
          <a
            href={lang.href}
            class:list={[
              "px-2 py-0.5 rounded-full text-[9px] font-black",
              currentLang === lang.code ? "bg-emerald-700 text-white shadow-sm" : "text-slate-600"
            ]}
          >
            {lang.label}
          </a>
        ))}
      </div>

      <button id="menu-toggle" class="p-2 text-slate-900 bg-slate-50 rounded-lg border border-slate-200">
        <svg id="menu-icon-open" class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path d="M4 6h16M4 12h16M4 18h16" stroke-width="2.5"/>
        </svg>
      </button>
    </div>
  </div>

  {/* Dropdown Meniu Mobil */}
  <div id="mobile-menu" class="hidden border-t border-slate-100 bg-white px-4 pb-8 pt-4 lg:hidden shadow-2xl">
    <nav class="flex flex-col gap-2">
      {nav.map(({ label, href }) => (
        <a href={href} class="rounded-xl px-4 py-3 text-base font-black text-slate-900 hover:bg-emerald-50 hover:text-emerald-700 transition-colors">
          {label}
        </a>
      ))}
      <a 
        href={waLink} 
        target="_blank" 
        class="mt-4 block w-full text-center rounded-xl bg-amber-400 py-4 text-sm font-black uppercase text-slate-900 shadow-lg hover:bg-emerald-600 hover:text-white transition-all"
      >
        {t.cta}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  toggleBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>
