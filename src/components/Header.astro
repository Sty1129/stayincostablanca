---
import { getCollection } from 'astro:content';

// src/components/Header.astro

const currentLang = Astro.currentLocale || "ro";
const pathname = Astro.url.pathname;


/* =========================================================
   ROUTES
========================================================= */

const routes = {
  ro: {
    home: "/",
    services: "/services",
    sustainability: "/sustenabilitate",
    about: "/about",
    blog: "/blog",
    contact: "/contact",
  },

  en: {
    home: "/en/",
    services: "/en/services",
    sustainability: "/en/sustainability",
    about: "/en/about",
    blog: "/en/blog",
    contact: "/en/contact",
  },

  es: {
    home: "/es/",
    services: "/es/servicios",
    sustainability: "/es/sostenibilidad",
    about: "/es/sobre-nosotros",
    blog: "/es/blog",
    contact: "/es/contacto",
  },
};


/* =========================================================
   TRANSLATIONS
========================================================= */

const translations = {
  ro: {
    home: "Acasă",
    services: "Servicii",
    sustainability: "Sustenabilitate",
    about: "Despre noi",
    blog: "Blog",
    contact: "Contact",

    phoneLabel: "Sună-ne",

    cta: "SOLICITĂ EVALUAREA",

    menu: "Meniu",
  },

  en: {
    home: "Home",
    services: "Services",
    sustainability: "Sustainability",
    about: "About us",
    blog: "Blog",
    contact: "Contact",

    phoneLabel: "Call us",

    cta: "REQUEST ASSESSMENT",

    menu: "Menu",
  },

  es: {
    home: "Inicio",
    services: "Servicios",
    sustainability: "Sostenibilidad",
    about: "Sobre nosotros",
    blog: "Blog",
    contact: "Contacto",

    phoneLabel: "Llámanos",

    cta: "SOLICITAR EVALUACIÓN",

    menu: "Menú",
  },
};


/* =========================================================
   CURRENT LANGUAGE
========================================================= */

const lang =
  currentLang === "en" || currentLang === "es"
    ? currentLang
    : "ro";

const t = translations[lang];
const r = routes[lang];


/* =========================================================
   NAVIGATION
========================================================= */

const navigation = [
  {
    label: t.home,
    href: r.home,
    key: "home",
  },

  {
    label: t.services,
    href: r.services,
    key: "services",
  },

  {
    label: t.sustainability,
    href: r.sustainability,
    key: "sustainability",
  },

  {
    label: t.about,
    href: r.about,
    key: "about",
  },

  {
    label: t.blog,
    href: r.blog,
    key: "blog",
  },

  {
    label: t.contact,
    href: r.contact,
    key: "contact",
  },
];


/* =========================================================
   CURRENT PAGE
========================================================= */

function getCurrentPageKey() {
  const cleanPath =
    pathname.length > 1 && pathname.endsWith("/")
      ? pathname.slice(0, -1)
      : pathname;

  if (
    cleanPath === "" ||
    cleanPath === "/" ||
    cleanPath === "/en" ||
    cleanPath === "/es"
  ) {
    return "home";
  }

  if (
    cleanPath.includes("/services") ||
    cleanPath.includes("/servicios")
  ) {
    return "services";
  }

  if (
    cleanPath.includes("/sustenabilitate") ||
    cleanPath.includes("/sustainability") ||
    cleanPath.includes("/sostenibilidad")
  ) {
    return "sustainability";
  }

  if (
    cleanPath.includes("/about") ||
    cleanPath.includes("/sobre-nosotros")
  ) {
    return "about";
  }

  if (cleanPath.includes("/blog")) {
    return "blog";
  }

  if (
    cleanPath.includes("/contact") ||
    cleanPath.includes("/contacto")
  ) {
    return "contact";
  }

  return "home";
}

const currentPageKey = getCurrentPageKey();


/* =========================================================
   DEFAULT LANGUAGE LINKS
========================================================= */

const defaultLanguageLinks = {
  ro: routes.ro[currentPageKey as keyof typeof routes.ro],
  en: routes.en[currentPageKey as keyof typeof routes.en],
  es: routes.es[currentPageKey as keyof typeof routes.es],
};


/* =========================================================
   BLOG ARTICLE DETECTION
========================================================= */

function getCurrentBlogSlug() {
  if (lang === "ro" && pathname.startsWith("/blog/")) {
    return pathname
      .replace(/^\/blog\//, "")
      .replace(/\/$/, "");
  }

  if (lang === "en" && pathname.startsWith("/en/blog/")) {
    return pathname
      .replace(/^\/en\/blog\//, "")
      .replace(/\/$/, "");
  }

  if (lang === "es" && pathname.startsWith("/es/blog/")) {
    return pathname
      .replace(/^\/es\/blog\//, "")
      .replace(/\/$/, "");
  }

  return null;
}

const currentBlogSlug = getCurrentBlogSlug();


/* =========================================================
   ARTICLE PUBLIC URL
========================================================= */

function getArticleUrl(
  post: any,
  targetLang: "ro" | "en" | "es"
) {
  const slug = post.id.replace(
    new RegExp(`^${targetLang}/`),
    ""
  );

  if (targetLang === "ro") {
    return `/blog/${slug}`;
  }

  return `/${targetLang}/blog/${slug}`;
}


/* =========================================================
   ARTICLE TRANSLATIONS
========================================================= */

let articleLanguageLinks:
  | {
      ro: string;
      en: string;
      es: string;
    }
  | null = null;

if (currentBlogSlug) {
  const allPosts = await getCollection(
    "blog",
    ({ data }) => !data.draft
  );

  const currentArticle = allPosts.find((post) => {
    if (post.data.lang !== lang) {
      return false;
    }

    const postSlug = post.id.replace(
      new RegExp(`^${lang}/`),
      ""
    );

    return postSlug === currentBlogSlug;
  });

  if (
    currentArticle &&
    currentArticle.data.translationKey
  ) {
    const translationKey =
      currentArticle.data.translationKey;

    const roPost = allPosts.find(
      (post) =>
        post.data.lang === "ro" &&
        post.data.translationKey === translationKey
    );

    const enPost = allPosts.find(
      (post) =>
        post.data.lang === "en" &&
        post.data.translationKey === translationKey
    );

    const esPost = allPosts.find(
      (post) =>
        post.data.lang === "es" &&
        post.data.translationKey === translationKey
    );

    articleLanguageLinks = {
      ro: roPost
        ? getArticleUrl(roPost, "ro")
        : routes.ro.blog,

      en: enPost
        ? getArticleUrl(enPost, "en")
        : routes.en.blog,

      es: esPost
        ? getArticleUrl(esPost, "es")
        : routes.es.blog,
    };
  }
}


/* =========================================================
   FINAL LANGUAGE LINKS
========================================================= */

const languageLinks =
  articleLanguageLinks ??
  defaultLanguageLinks;
---

<header
  class="
    sticky
    top-0
    z-50
    w-full

    border-b
    border-[#D5E3E7]

    bg-white/95
    backdrop-blur-md

    font-heading

    shadow-[0_2px_10px_rgba(14,56,70,0.04)]
  "
>

  <!-- =====================================================
       HEADER CONTAINER
  ====================================================== -->

  <div
    class="
      mx-auto

      flex
      min-h-[78px]

      max-w-site

      items-center
      justify-between

      gap-5

      px-4
      sm:px-6
      lg:px-8
    "
  >

    <!-- =====================================================
         LOGO
    ====================================================== -->

    <a
      href={r.home}
      class="
        flex
        shrink-0
        items-center
      "
      aria-label="Stay in Costa Blanca"
    >

      <img
        src="/sicb.png"
        alt="Stay in Costa Blanca"

        class="
          h-[54px]
          w-auto
          object-contain

          sm:h-[58px]
        "
      />

    </a>


    <!-- =====================================================
         DESKTOP NAVIGATION
    ====================================================== -->

    <nav
      class="
        hidden

        xl:flex
        items-center

        gap-1.5
      "
      aria-label="Main navigation"
    >

      {
        navigation.map((item) => {
          const active = currentPageKey === item.key;

          return (

            <a
              href={item.href}

              aria-current={active ? "page" : undefined}

              class:list={[
                "relative",

                "rounded-xl",

                "px-3.5",
                "py-3",

                "text-[15px]",
                "font-semibold",

                "whitespace-nowrap",

                "transition-all",
                "duration-200",

                active
                  ? "bg-[#E5F2F5] text-[#0E3846]"
                  : "text-[#294A55] hover:bg-[#F1F6F7] hover:text-[#0E3846]",
              ]}
            >

              {item.label}


              <!-- ACTIVE INDICATOR -->

              {active && (

                <span
                  class="
                    absolute

                    left-3.5
                    right-3.5

                    -bottom-[1px]

                    h-[2px]

                    rounded-full

                    bg-[#D99B26]
                  "
                  aria-hidden="true"
                />

              )}

            </a>

          );
        })
      }

    </nav>


    <!-- =====================================================
         DESKTOP RIGHT SIDE
    ====================================================== -->

    <div
      class="
        hidden

        xl:flex

        shrink-0
        items-center

        gap-3.5
      "
    >

      <!-- =================================================
           LANGUAGE SWITCHER
      ================================================== -->

      <div
        class="
          flex

          items-center

          rounded-full

          border
          border-[#D6E2E5]

          bg-[#F3F7F8]

          p-1
        "
        aria-label="Language"
      >

        <!-- EN -->

        <a
          href={languageLinks.en}

          class:list={[
            "flex",

            "h-8",
            "min-w-[36px]",

            "items-center",
            "justify-center",

            "rounded-full",

            "px-2",

            "text-[11px]",
            "font-bold",

            "transition-all",
            "duration-200",

            lang === "en"
              ? "bg-[#0E3846] text-white shadow-sm"
              : "text-[#536E77] hover:bg-white hover:text-[#0E3846]",
          ]}
        >
          EN
        </a>


        <!-- RO -->

        <a
          href={languageLinks.ro}

          class:list={[
            "flex",

            "h-8",
            "min-w-[36px]",

            "items-center",
            "justify-center",

            "rounded-full",

            "px-2",

            "text-[11px]",
            "font-bold",

            "transition-all",
            "duration-200",

            lang === "ro"
              ? "bg-[#0E3846] text-white shadow-sm"
              : "text-[#536E77] hover:bg-white hover:text-[#0E3846]",
          ]}
        >
          RO
        </a>


        <!-- ES -->

        <a
          href={languageLinks.es}

          class:list={[
            "flex",

            "h-8",
            "min-w-[36px]",

            "items-center",
            "justify-center",

            "rounded-full",

            "px-2",

            "text-[11px]",
            "font-bold",

            "transition-all",
            "duration-200",

            lang === "es"
              ? "bg-[#0E3846] text-white shadow-sm"
              : "text-[#536E77] hover:bg-white hover:text-[#0E3846]",
          ]}
        >
          ES
        </a>

      </div>


      <!-- =================================================
           PHONE
      ================================================== -->

      <a
        href="tel:+34624110656"

        aria-label={`${t.phoneLabel}: +34 624 110 656`}

        class="
          group

          flex
          items-center

          gap-2

          whitespace-nowrap

          text-[13px]
          xl:text-[14px]

          font-bold

          text-[#294A55]

          transition-colors
          duration-200

          hover:text-[#0E3846]
        "
      >

        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"

          class="
            h-[18px]
            w-[18px]

            shrink-0

            text-[#D99B26]
          "

          aria-hidden="true"
        >

          <path
            d="M5 4h3l2 5-2 1.5c1.1 2.3 3.2 4.4 5.5 5.5L15 14l5 2v3c0 1.1-.9 2-2 2C10.3 21 3 13.7 3 6c0-1.1.9-2 2-2z"

            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />

        </svg>

        <span>
          +34 624 110 656
        </span>

      </a>


      <!-- =================================================
           MAIN CTA
      ================================================== -->

      <a
        href={r.contact}

        class="
          inline-flex

          min-h-[46px]

          items-center
          justify-center

          whitespace-nowrap

          rounded-xl

          bg-[#D99B26]

          px-6
          py-3

          text-[13px]

          font-extrabold

          uppercase
          tracking-[0.04em]

          text-[#0E3846]

          shadow-[0_6px_16px_rgba(217,155,38,0.28)]

          transition-all
          duration-200

          hover:-translate-y-0.5
          hover:bg-[#E5A835]
          hover:shadow-[0_8px_20px_rgba(217,155,38,0.34)]
        "
      >
        {t.cta}
      </a>

    </div>


    <!-- =====================================================
         MOBILE / TABLET
    ====================================================== -->

    <details
      class="
        group
        relative

        xl:hidden
      "
    >

      <!-- =================================================
           MOBILE MENU BUTTON
      ================================================== -->

      <summary
        class="
          flex

          h-12
          w-12

          cursor-pointer

          list-none

          items-center
          justify-center

          rounded-xl

          border
          border-[#CBDCE1]

          bg-white

          text-[#0E3846]

          shadow-sm

          transition-all
          duration-200

          hover:bg-[#F0F6F7]

          [&::-webkit-details-marker]:hidden
        "

        aria-label={t.menu}
      >

        <!-- HAMBURGER -->

        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"

          class="
            h-6
            w-6

            group-open:hidden
          "

          aria-hidden="true"
        >

          <path
            d="M4 7h16M4 12h16M4 17h16"
            stroke-width="2"
            stroke-linecap="round"
          />

        </svg>


        <!-- CLOSE -->

        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"

          class="
            hidden

            h-6
            w-6

            group-open:block
          "

          aria-hidden="true"
        >

          <path
            d="M6 6l12 12M18 6L6 18"
            stroke-width="2"
            stroke-linecap="round"
          />

        </svg>

      </summary>


      <!-- =================================================
           MOBILE MENU PANEL
      ================================================== -->

      <div
        class="
          fixed

          left-0
          right-0

          top-[78px]

          max-h-[calc(100vh-78px)]

          overflow-y-auto

          border-t
          border-[#D7E3E6]

          bg-white

          shadow-[0_20px_38px_rgba(14,56,70,0.16)]
        "
      >

        <div
          class="
            mx-auto

            max-w-site

            px-4
            sm:px-6

            py-6
          "
        >

          <!-- =============================================
               MOBILE NAV
          ============================================== -->

          <nav
            class="
              flex
              flex-col

              gap-1.5
            "
            aria-label="Mobile navigation"
          >

            {
              navigation.map((item) => {

                const active =
                  currentPageKey === item.key;

                return (

                  <a
                    href={item.href}

                    aria-current={
                      active
                        ? "page"
                        : undefined
                    }

                    class:list={[
                      "flex",

                      "min-h-[52px]",

                      "items-center",

                      "rounded-xl",

                      "px-4",

                      "text-[16px]",
                      "font-semibold",

                      "transition-all",
                      "duration-200",

                      active
                        ? "bg-[#E5F2F5] text-[#0E3846]"
                        : "text-[#294A55] hover:bg-[#F3F7F8]",
                    ]}
                  >

                    {item.label}

                  </a>

                );
              })
            }

          </nav>


          <!-- =============================================
               MOBILE LANGUAGE SWITCHER
          ============================================== -->

          <div
            class="
              mt-6

              border-t
              border-[#DCE6E9]

              pt-5
            "
          >

            <div
              class="
                inline-flex

                items-center

                rounded-full

                border
                border-[#D6E2E5]

                bg-[#F3F7F8]

                p-1
              "
            >

              <!-- EN -->

              <a
                href={languageLinks.en}

                class:list={[
                  "flex",

                  "h-10",
                  "min-w-[48px]",

                  "items-center",
                  "justify-center",

                  "rounded-full",

                  "px-3",

                  "text-xs",
                  "font-bold",

                  "transition-all",

                  lang === "en"
                    ? "bg-[#0E3846] text-white"
                    : "text-[#526B74]",
                ]}
              >
                EN
              </a>


              <!-- RO -->

              <a
                href={languageLinks.ro}

                class:list={[
                  "flex",

                  "h-10",
                  "min-w-[48px]",

                  "items-center",
                  "justify-center",

                  "rounded-full",

                  "px-3",

                  "text-xs",
                  "font-bold",

                  "transition-all",

                  lang === "ro"
                    ? "bg-[#0E3846] text-white"
                    : "text-[#526B74]",
                ]}
              >
                RO
              </a>


              <!-- ES -->

              <a
                href={languageLinks.es}

                class:list={[
                  "flex",

                  "h-10",
                  "min-w-[48px]",

                  "items-center",
                  "justify-center",

                  "rounded-full",

                  "px-3",

                  "text-xs",
                  "font-bold",

                  "transition-all",

                  lang === "es"
                    ? "bg-[#0E3846] text-white"
                    : "text-[#526B74]",
                ]}
              >
                ES
              </a>

            </div>

          </div>


          <!-- =============================================
               MOBILE PHONE
          ============================================== -->

          <a
            href="tel:+34624110656"

            class="
              mt-5

              flex

              min-h-[52px]

              items-center

              gap-3

              rounded-xl

              border
              border-[#D7E3E6]

              bg-[#F7FAFA]

              px-4

              text-[15px]

              font-bold

              text-[#0E3846]
            "
          >

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"

              class="
                h-5
                w-5

                shrink-0

                text-[#D99B26]
              "

              aria-hidden="true"
            >

              <path
                d="M5 4h3l2 5-2 1.5c1.1 2.3 3.2 4.4 5.5 5.5L15 14l5 2v3c0 1.1-.9 2-2 2C10.3 21 3 13.7 3 6c0-1.1.9-2 2-2z"

                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />

            </svg>

            <span>
              +34 624 110 656
            </span>

          </a>


          <!-- =============================================
               MOBILE CTA
          ============================================== -->

          <a
            href={r.contact}

            class="
              mt-3

              flex

              min-h-[54px]

              w-full

              items-center
              justify-center

              rounded-xl

              bg-[#D99B26]

              px-5
              py-3.5

              text-center

              text-sm

              font-extrabold

              uppercase
              tracking-[0.04em]

              text-[#0E3846]

              shadow-[0_6px_16px_rgba(217,155,38,0.24)]
            "
          >
            {t.cta}
          </a>

        </div>

      </div>

    </details>

  </div>

</header>
