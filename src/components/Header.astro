---
// src/components/Header.astro

const currentLang = Astro.currentLocale || "ro";
const pathname = Astro.url.pathname;

/* =========================================================
   ROUTES
========================================================= */

const routes = {
  ro: {
    home: "/",
    services: "/services",
    sustainability: "/sustenabilitate",
    about: "/about",
    blog: "/blog",
    contact: "/contact",
  },

  en: {
    home: "/en/",
    services: "/en/services",
    sustainability: "/en/sustainability",
    about: "/en/about",
    blog: "/en/blog",
    contact: "/en/contact",
  },

  es: {
    home: "/es/",
    services: "/es/services",
    sustainability: "/es/sustainability",
    about: "/es/about",
    blog: "/es/blog",
    contact: "/es/contact",
  },
};

const translations = {
  ro: {
    home: "Acasă",
    services: "Servicii",
    sustainability: "Sustenabilitate",
    about: "Despre noi",
    blog: "Blog",
    contact: "Contact",
    phoneLabel: "Sună-ne",
    cta: "SOLICITĂ EVALUAREA",
    menu: "Meniu",
  },

  en: {
    home: "Home",
    services: "Services",
    sustainability: "Sustainability",
    about: "About us",
    blog: "Blog",
    contact: "Contact",
    phoneLabel: "Call us",
    cta: "REQUEST ASSESSMENT",
    menu: "Menu",
  },

  es: {
    home: "Inicio",
    services: "Servicios",
    sustainability: "Sostenibilidad",
    about: "Sobre nosotros",
    blog: "Blog",
    contact: "Contacto",
    phoneLabel: "Llámanos",
    cta: "SOLICITAR EVALUACIÓN",
    menu: "Menú",
  },
};

const lang =
  currentLang === "en" || currentLang === "es"
    ? currentLang
    : "ro";

const t = translations[lang];
const r = routes[lang];


/* =========================================================
   NAVIGATION
========================================================= */

const navigation = [
  {
    label: t.home,
    href: r.home,
    key: "home",
  },
  {
    label: t.services,
    href: r.services,
    key: "services",
  },
  {
    label: t.sustainability,
    href: r.sustainability,
    key: "sustainability",
  },
  {
    label: t.about,
    href: r.about,
    key: "about",
  },
  {
    label: t.blog,
    href: r.blog,
    key: "blog",
  },
  {
    label: t.contact,
    href: r.contact,
    key: "contact",
  },
];


/* =========================================================
   IDENTIFICĂ PAGINA CURENTĂ
========================================================= */

function getCurrentPageKey() {
  const cleanPath =
    pathname.length > 1 && pathname.endsWith("/")
      ? pathname.slice(0, -1)
      : pathname;

  if (
    cleanPath === "" ||
    cleanPath === "/" ||
    cleanPath === "/en" ||
    cleanPath === "/es"
  ) {
    return "home";
  }

  if (
    cleanPath.includes("/services")
  ) {
    return "services";
  }

  if (
    cleanPath.includes("/sustenabilitate") ||
    cleanPath.includes("/sustainability")
  ) {
    return "sustainability";
  }

  if (cleanPath.includes("/about")) {
    return "about";
  }

  if (cleanPath.includes("/blog")) {
    return "blog";
  }

  if (cleanPath.includes("/contact")) {
    return "contact";
  }

  return "home";
}

const currentPageKey = getCurrentPageKey();


/* =========================================================
   LANGUAGE LINKS
   Păstrăm aceeași pagină când schimbăm limba
========================================================= */

const languageLinks = {
  ro: routes.ro[currentPageKey as keyof typeof routes.ro],
  en: routes.en[currentPageKey as keyof typeof routes.en],
  es: routes.es[currentPageKey as keyof typeof routes.es],
};
---

<header
  class="
    sticky
    top-0
    z-50
    w-full
    border-b
    border-[#D8E5E8]
    bg-white/95
    backdrop-blur-md
    font-heading
  "
>
  <div
    class="
      mx-auto
      flex
      min-h-[68px]
      max-w-site
      items-center
      justify-between
      gap-4
      px-4
      sm:px-6
      lg:px-8
    "
  >

    <!-- =====================================================
         LOGO
    ====================================================== -->

    <a
      href={r.home}
      class="
        flex
        shrink-0
        items-center
      "
      aria-label="Stay in Costa Blanca"
    >
      <img
        src="/sicb.png"
        alt="Stay in Costa Blanca"
        class="
          h-[46px]
          w-auto
          object-contain
          sm:h-[50px]
        "
      />
    </a>


    <!-- =====================================================
         DESKTOP NAVIGATION
    ====================================================== -->

    <nav
      class="
        hidden
        xl:flex
        items-center
        gap-1
      "
      aria-label="Main navigation"
    >
      {
        navigation.map((item) => {
          const active = currentPageKey === item.key;

          return (
            <a
              href={item.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "relative",
                "rounded-lg",
                "px-3",
                "py-2.5",
                "text-[14px]",
                "font-semibold",
                "transition-all",
                "duration-200",

                active
                  ? "bg-[#E5F2F5] text-[#0E3846]"
                  : "text-[#294A55] hover:bg-[#F1F6F7] hover:text-[#0E3846]",
              ]}
            >
              {item.label}

              {active && (
                <span
                  class="
                    absolute
                    left-3
                    right-3
                    -bottom-[1px]
                    h-[2px]
                    rounded-full
                    bg-[#D99B26]
                  "
                  aria-hidden="true"
                />
              )}
            </a>
          );
        })
      }
    </nav>


    <!-- =====================================================
         DESKTOP RIGHT SIDE
    ====================================================== -->

    <div
      class="
        hidden
        xl:flex
        items-center
        gap-3
        shrink-0
      "
    >

      <!-- LANGUAGE SWITCHER -->

      <div
        class="
          flex
          items-center
          rounded-full
          border
          border-[#D8E3E6]
          bg-[#F3F7F8]
          p-1
        "
        aria-label="Language"
      >

        <a
          href={languageLinks.en}
          class:list={[
            "flex",
            "h-7",
            "min-w-[34px]",
            "items-center",
            "justify-center",
            "rounded-full",
            "px-2",
            "text-[11px]",
            "font-bold",
            "transition-colors",

            lang === "en"
              ? "bg-[#0E3846] text-white"
              : "text-[#536E77] hover:text-[#0E3846]",
          ]}
        >
          EN
        </a>


        <a
          href={languageLinks.ro}
          class:list={[
            "flex",
            "h-7",
            "min-w-[34px]",
            "items-center",
            "justify-center",
            "rounded-full",
            "px-2",
            "text-[11px]",
            "font-bold",
            "transition-colors",

            lang === "ro"
              ? "bg-[#0E3846] text-white"
              : "text-[#536E77] hover:text-[#0E3846]",
          ]}
        >
          RO
        </a>


        <a
          href={languageLinks.es}
          class:list={[
            "flex",
            "h-7",
            "min-w-[34px]",
            "items-center",
            "justify-center",
            "rounded-full",
            "px-2",
            "text-[11px]",
            "font-bold",
            "transition-colors",

            lang === "es"
              ? "bg-[#0E3846] text-white"
              : "text-[#536E77] hover:text-[#0E3846]",
          ]}
        >
          ES
        </a>

      </div>


      <!-- PHONE -->

      <a
        href="tel:+34624110656"
        aria-label={`${t.phoneLabel}: +34 624 110 656`}
        class="
          group
          flex
          items-center
          gap-2
          whitespace-nowrap
          text-[13px]
          font-bold
          text-[#294A55]
          transition-colors
          hover:text-[#0E3846]
        "
      >

        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          class="
            h-4
            w-4
            shrink-0
            text-[#168D79]
          "
          aria-hidden="true"
        >
          <path
            d="M5 4h3l2 5-2 1.5c1.1 2.3 3.2 4.4 5.5 5.5L15 14l5 2v3c0 1.1-.9 2-2 2C10.3 21 3 13.7 3 6c0-1.1.9-2 2-2z"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>

        <span>
          +34 624 110 656
        </span>

      </a>


      <!-- CTA -->

      <a
        href={r.contact}
        class="
          inline-flex
          min-h-[42px]
          items-center
          justify-center
          whitespace-nowrap
          rounded-xl
          bg-[#D99B26]
          px-5
          py-2.5
          text-[12px]
          font-extrabold
          uppercase
          tracking-[0.04em]
          text-[#0E3846]
          shadow-[0_5px_14px_rgba(217,155,38,0.25)]
          transition-all
          duration-200
          hover:-translate-y-0.5
          hover:bg-[#E5A835]
        "
      >
        {t.cta}
      </a>

    </div>


    <!-- =====================================================
         MOBILE / TABLET MENU
    ====================================================== -->

    <details
      class="
        group
        relative
        xl:hidden
      "
    >

      <summary
        class="
          flex
          h-11
          w-11
          cursor-pointer
          list-none
          items-center
          justify-center
          rounded-xl
          border
          border-[#CBDCE1]
          bg-white
          text-[#0E3846]
          transition-colors
          hover:bg-[#F0F6F7]
          [&::-webkit-details-marker]:hidden
        "
        aria-label={t.menu}
      >

        <!-- HAMBURGER -->

        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          class="
            h-6
            w-6
            group-open:hidden
          "
          aria-hidden="true"
        >
          <path
            d="M4 7h16M4 12h16M4 17h16"
            stroke-width="2"
            stroke-linecap="round"
          />
        </svg>


        <!-- CLOSE -->

        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          class="
            hidden
            h-6
            w-6
            group-open:block
          "
          aria-hidden="true"
        >
          <path
            d="M6 6l12 12M18 6L6 18"
            stroke-width="2"
            stroke-linecap="round"
          />
        </svg>

      </summary>


      <!-- MOBILE PANEL -->

      <div
        class="
          fixed
          left-0
          right-0
          top-[68px]
          max-h-[calc(100vh-68px)]
          overflow-y-auto
          border-t
          border-[#D7E3E6]
          bg-white
          shadow-[0_18px_32px_rgba(14,56,70,0.14)]
        "
      >

        <div
          class="
            mx-auto
            max-w-site
            px-4
            sm:px-6
            py-5
          "
        >

          <!-- MOBILE NAV -->

          <nav
            class="
              flex
              flex-col
              gap-1
            "
          >

            {
              navigation.map((item) => {
                const active = currentPageKey === item.key;

                return (
                  <a
                    href={item.href}
                    aria-current={active ? "page" : undefined}
                    class:list={[
                      "flex",
                      "min-h-[48px]",
                      "items-center",
                      "rounded-xl",
                      "px-4",
                      "text-[16px]",
                      "font-semibold",
                      "transition-colors",

                      active
                        ? "bg-[#E5F2F5] text-[#0E3846]"
                        : "text-[#294A55] hover:bg-[#F3F7F8]",
                    ]}
                  >
                    {item.label}
                  </a>
                );
              })
            }

          </nav>


          <!-- MOBILE LANGUAGE -->

          <div
            class="
              mt-5
              border-t
              border-[#DCE6E9]
              pt-5
            "
          >

            <div
              class="
                inline-flex
                items-center
                rounded-full
                border
                border-[#D6E2E5]
                bg-[#F3F7F8]
                p-1
              "
            >

              <a
                href={languageLinks.en}
                class:list={[
                  "flex h-9 min-w-[46px] items-center justify-center rounded-full px-3 text-xs font-bold",
                  lang === "en"
                    ? "bg-[#0E3846] text-white"
                    : "text-[#526B74]",
                ]}
              >
                EN
              </a>

              <a
                href={languageLinks.ro}
                class:list={[
                  "flex h-9 min-w-[46px] items-center justify-center rounded-full px-3 text-xs font-bold",
                  lang === "ro"
                    ? "bg-[#0E3846] text-white"
                    : "text-[#526B74]",
                ]}
              >
                RO
              </a>

              <a
                href={languageLinks.es}
                class:list={[
                  "flex h-9 min-w-[46px] items-center justify-center rounded-full px-3 text-xs font-bold",
                  lang === "es"
                    ? "bg-[#0E3846] text-white"
                    : "text-[#526B74]",
                ]}
              >
                ES
              </a>

            </div>

          </div>


          <!-- MOBILE PHONE -->

          <a
            href="tel:+34624110656"
            class="
              mt-5
              flex
              min-h-[48px]
              items-center
              gap-3
              rounded-xl
              border
              border-[#D7E3E6]
              px-4
              text-[15px]
              font-bold
              text-[#0E3846]
            "
          >

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              class="
                h-5
                w-5
                shrink-0
                text-[#D99B26]
              "
              aria-hidden="true"
            >
              <path
                d="M5 4h3l2 5-2 1.5c1.1 2.3 3.2 4.4 5.5 5.5L15 14l5 2v3c0 1.1-.9 2-2 2C10.3 21 3 13.7 3 6c0-1.1.9-2 2-2z"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>

            +34 624 110 656

          </a>


          <!-- MOBILE CTA -->

          <a
            href={r.contact}
            class="
              mt-3
              flex
              min-h-[52px]
              w-full
              items-center
              justify-center
              rounded-xl
              bg-[#D99B26]
              px-5
              py-3
              text-center
              text-sm
              font-extrabold
              uppercase
              tracking-[0.04em]
              text-[#0E3846]
            "
          >
            {t.cta}
          </a>

        </div>

      </div>

    </details>

  </div>
</header>
