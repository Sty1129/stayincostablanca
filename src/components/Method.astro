---
// src/components/Method.astro

const currentLang = Astro.currentLocale || 'ro';

const lang =
  currentLang === 'en' || currentLang === 'es'
    ? currentLang
    : 'ro';

const translations = {
  ro: {
    topper: 'CUM LUCRĂM',
    heading: 'Nu doar vizităm. Monitorizăm și documentăm.',
    intro:
      'Fiecare proprietate dezvoltă în timp un istoric. Fotografii, observații, valori relevante și verificări periodice ne ajută să identificăm schimbările, nu doar să spunem că „totul pare în regulă”.',
    stepLabel: 'Pasul',
    finalBefore: 'Rezultatul este un proces',
    finalStrong: 'măsurabil, documentat și preventiv',
    finalAfter: 'construit pentru a urmări proprietatea în timp.',
    steps: [
      {
        label: 'MĂSURĂM',
        desc: 'Colectăm datele și parametrii relevanți ai proprietății.',
      },
      {
        label: 'COMPARĂM',
        desc: 'Urmărim evoluția față de vizitele și valorile anterioare.',
      },
      {
        label: 'DOCUMENTĂM',
        desc: 'Înregistrăm fotografii, valori și observații clare.',
      },
      {
        label: 'DETECTĂM',
        desc: 'Identificăm din timp schimbările care necesită atenție.',
      },
      {
        label: 'ACȚIONĂM',
        desc: 'Informăm proprietarul și coordonăm următorii pași.',
      },
    ],
  },

  en: {
    topper: 'HOW WE WORK',
    heading: 'We do more than visit. We monitor and document.',
    intro:
      'Every property develops a history over time. Photographs, observations, relevant readings and scheduled checks help us identify changes rather than simply saying that “everything looks fine”.',
    stepLabel: 'Step',
    finalBefore: 'The result is a',
    finalStrong: 'measurable, documented and preventive',
    finalAfter: 'process designed to track the property over time.',
    steps: [
      {
        label: 'MEASURE',
        desc: 'We collect relevant data and property parameters.',
      },
      {
        label: 'COMPARE',
        desc: 'We track changes against previous visits and recorded values.',
      },
      {
        label: 'DOCUMENT',
        desc: 'We record photographs, readings and clear observations.',
      },
      {
        label: 'DETECT',
        desc: 'We identify changes that require attention at an early stage.',
      },
      {
        label: 'ACT',
        desc: 'We inform the owner and coordinate the next steps.',
      },
    ],
  },

  es: {
    topper: 'CÓMO TRABAJAMOS',
    heading: 'No solo visitamos. Monitorizamos y documentamos.',
    intro:
      'Cada propiedad desarrolla un historial con el tiempo. Fotografías, observaciones, valores relevantes y revisiones periódicas nos ayudan a identificar cambios, no simplemente a decir que “todo parece estar bien”.',
    stepLabel: 'Paso',
    finalBefore: 'El resultado es un proceso',
    finalStrong: 'medible, documentado y preventivo',
    finalAfter: 'diseñado para hacer un seguimiento de la propiedad a lo largo del tiempo.',
    steps: [
      {
        label: 'MEDIMOS',
        desc: 'Recopilamos los datos y parámetros relevantes de la propiedad.',
      },
      {
        label: 'COMPARAMOS',
        desc: 'Seguimos la evolución respecto a visitas y valores anteriores.',
      },
      {
        label: 'DOCUMENTAMOS',
        desc: 'Registramos fotografías, valores y observaciones claras.',
      },
      {
        label: 'DETECTAMOS',
        desc: 'Identificamos con antelación los cambios que requieren atención.',
      },
      {
        label: 'ACTUAMOS',
        desc: 'Informamos al propietario y coordinamos los siguientes pasos.',
      },
    ],
  },
};

const t = translations[lang];
const steps = t.steps;
---

<section
  id="cum-lucram"
  class="
    py-14
    sm:py-16
    md:py-20
    bg-[#0E3846]
    font-heading
    border-b
    border-[#1C4D5C]
    scroll-mt-20
  "
>
  <div class="mx-auto max-w-site px-4 sm:px-6 lg:px-8">

    <!-- =====================================================
         TITLE & INTRO
    ====================================================== -->
    <div class="text-center max-w-4xl mx-auto mb-12 sm:mb-16">

      <p
        class="
          text-sm
          font-bold
          uppercase
          tracking-[0.18em]
          text-[#F3C76B]
          mb-3
        "
      >
        {t.topper}
      </p>

      <h2
        class="
          text-[28px]
          sm:text-4xl
          lg:text-[42px]
          font-bold
          text-white
          tracking-tight
          leading-[1.15]
        "
      >
        {t.heading}
      </h2>

      <p
        class="
          mt-5
          sm:mt-6
          text-base
          sm:text-lg
          text-[#DCECEF]
          leading-7
          sm:leading-8
          max-w-3xl
          mx-auto
        "
      >
        {t.intro}
      </p>

    </div>


    <!-- =====================================================
         PROCESS FLOW
    ====================================================== -->
    <div
      class="
        grid
        grid-cols-1
        sm:grid-cols-2
        lg:grid-cols-5
        gap-5
        lg:gap-4
        max-w-6xl
        mx-auto
      "
    >

      {steps.map((step, index) => (

        <article
          class="
            relative
            bg-white
            rounded-2xl
            border
            border-[#C9DDE3]
            p-6
            lg:px-5
            lg:py-7
            shadow-[0_8px_24px_rgba(0,0,0,0.15)]
            hover:-translate-y-1
            hover:shadow-[0_12px_30px_rgba(0,0,0,0.20)]
            transition-all
            duration-300
            flex
            flex-col
            items-center
            text-center
          "
        >

          <!-- Step number -->
          <div
            class={`
              w-12
              h-12
              rounded-full
              flex
              items-center
              justify-center
              font-bold
              text-lg
              mb-5
              ${
                index === 4
                  ? 'bg-[#D99B26] text-[#0E3846]'
                  : 'bg-[#EAF4F6] text-[#0E3846] border border-[#BFD8E0]'
              }
            `}
          >
            {index + 1}
          </div>


          <!-- Step -->
          <p
            class="
              text-xs
              sm:text-sm
              font-bold
              text-[#607983]
              uppercase
              tracking-[0.14em]
              mb-2
            "
          >
            {t.stepLabel} 0{index + 1}
          </p>


          <!-- Title -->
          <h3
            class={`
              text-xl
              font-bold
              tracking-wide
              leading-tight
              mb-3
              ${
                index === 4
                  ? 'text-[#B47500]'
                  : 'text-[#0E3846]'
              }
            `}
          >
            {step.label}
          </h3>


          <!-- Description -->
          <p
            class="
              text-base
              sm:text-[17px]
              text-[#405963]
              leading-7
            "
          >
            {step.desc}
          </p>


          <!-- Arrow between steps - desktop only -->
          {index < steps.length - 1 && (
            <div
              class="
                hidden
                lg:flex
                absolute
                top-1/2
                -right-[21px]
                -translate-y-1/2
                z-20
                w-7
                h-7
                rounded-full
                bg-[#5B9EB5]
                items-center
                justify-center
                text-white
                font-bold
                text-lg
                shadow-sm
              "
              aria-hidden="true"
            >
              →
            </div>
          )}

        </article>

      ))}

    </div>


    <!-- =====================================================
         FINAL MESSAGE
    ====================================================== -->
    <div class="text-center max-w-3xl mx-auto mt-10 sm:mt-12">

      <p
        class="
          text-base
          sm:text-lg
          text-[#DCECEF]
          leading-7
          sm:leading-8
        "
      >
        {t.finalBefore}{' '}
        <strong class="text-white">{t.finalStrong}</strong>,
        {' '}{t.finalAfter}
      </p>

    </div>

  </div>
</section>
