
---
// src/components/Method.astro

const steps = [
  { label: "MĂSURĂM", desc: "Colectăm date și parametri inițiali." },
  { label: "COMPARĂM", desc: "Urmărim evoluția față de vizitele anterioare." },
  { label: "DOCUMENTĂM", desc: "Înregistrăm fotografii și observații clare." },
  { label: "DETECTĂM", desc: "Identificăm timpurie orice neconcordanță." },
  { label: "ACȚIONĂM", desc: "Notificăm și coordonăm soluția potrivită." }
];
---

<section id="cum-lucram" class="py-12 sm:py-16 md:py-20 bg-slate-50 font-heading border-b border-border scroll-mt-20">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    
    <!-- Titlu & Intro -->
    <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-text uppercase tracking-tight">
        Nu doar vizităm. Monitorizăm și documentăm.
      </h2>
      <p class="mt-4 text-sm sm:text-base text-text-muted leading-relaxed">
        Fiecare proprietate dezvoltă în timp un istoric. Fotografii, observații, valori relevante și verificări periodice ne ajută să identificăm schimbările, nu doar să spunem că „totul pare în regulă”.
      </p>
    </div>

    <!-- Diagrama procesului (Măsurăm -> Comparăm -> Documentăm -> Detectăm -> Acționăm) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 max-w-5xl mx-auto">
      {steps.map((step, index) => (
        <div class="bg-surface p-5 rounded-xl border border-border shadow-sm flex flex-col items-center text-center relative group hover:border-emerald-600 transition-colors">
          <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1">
            Pasul 0{index + 1}
          </span>
          <h3 class={`text-base font-bold tracking-wide mb-1 ${index === 4 ? 'text-emerald-700' : 'text-emerald-900'}`}>
            {step.label}
          </h3>
          <p class="text-xs text-text-muted leading-relaxed mt-1">
            {step.desc}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
