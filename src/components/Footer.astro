---
// src/components/Footer.astro

const currentLang = Astro.currentLocale || "ro";

const translations = {
  ro: {
    homeHref: "/",

    description:
      "Key Holding & Property Management pentru proprietarii care nu locuiesc permanent în Costa Blanca.",

    navigationTitle: "NAVIGARE",
    servicesTitle: "SERVICII",
    contactTitle: "CONTACT",

    navigation: [
      { label: "Acasă", href: "/" },
      { label: "Servicii & prețuri", href: "/services" },
      { label: "Sustenabilitate", href: "/sustenabilitate" },
      { label: "Blog", href: "/blog" },
      { label: "Despre noi", href: "/about" },
      { label: "Contact", href: "/contact" },
    ],

    services: [
      { label: "ECO-BASIC — WATCH", href: "/services#eco-basic" },
      { label: "ECO-SMART — PREVENT", href: "/services#eco-smart" },
      { label: "ECO-PREMIUM — MANAGE", href: "/services#eco-premium" },
      { label: "Compară pachetele", href: "/services#comparatie" },
    ],

    area: "Orihuela Costa & Torrevieja",

    positioning:
      "Administrare Științifică & Sustenabilă a Proprietăților",

    rights:
      "Toate drepturile rezervate.",

    slogan:
      "Mai mult timp pentru tine. Noi avem grijă de restul.",
  },

  en: {
    homeHref: "/en/",

    description:
      "Key Holding & Property Management for owners who do not live permanently in Costa Blanca.",

    navigationTitle: "NAVIGATION",
    servicesTitle: "SERVICES",
    contactTitle: "CONTACT",

    navigation: [
      { label: "Home", href: "/en/" },
      { label: "Services & pricing", href: "/en/services" },
      { label: "Sustainability", href: "/en/sustainability" },
      { label: "Blog", href: "/en/blog" },
      { label: "About us", href: "/en/about" },
      { label: "Contact", href: "/en/contact" },
    ],

    services: [
      { label: "ECO-BASIC — WATCH", href: "/en/services#eco-basic" },
      { label: "ECO-SMART — PREVENT", href: "/en/services#eco-smart" },
      { label: "ECO-PREMIUM — MANAGE", href: "/en/services#eco-premium" },
      { label: "Compare packages", href: "/en/services#comparatie" },
    ],

    area: "Orihuela Costa & Torrevieja",

    positioning:
      "Scientific & Sustainable Property Management",

    rights:
      "All rights reserved.",

    slogan:
      "More time for you. We take care of the rest.",
  },

  es: {
    homeHref: "/es/",

    description:
      "Key Holding y Gestión de Propiedades para propietarios que no residen permanentemente en la Costa Blanca.",

    navigationTitle: "NAVEGACIÓN",
    servicesTitle: "SERVICIOS",
    contactTitle: "CONTACTO",

    navigation: [
      { label: "Inicio", href: "/es/" },
      { label: "Servicios y precios", href: "/es/services" },
      { label: "Sostenibilidad", href: "/es/sustainability" },
      { label: "Blog", href: "/es/blog" },
      { label: "Sobre nosotros", href: "/es/about" },
      { label: "Contacto", href: "/es/contact" },
    ],

    services: [
      { label: "ECO-BASIC — WATCH", href: "/es/services#eco-basic" },
      { label: "ECO-SMART — PREVENT", href: "/es/services#eco-smart" },
      { label: "ECO-PREMIUM — MANAGE", href: "/es/services#eco-premium" },
      { label: "Comparar planes", href: "/es/services#comparatie" },
    ],

    area: "Orihuela Costa & Torrevieja",

    positioning:
      "Gestión Científica y Sostenible de Propiedades",

    rights:
      "Todos los derechos reservados.",

    slogan:
      "Más tiempo para ti. Nosotros nos ocupamos del resto.",
  },
};

const t =
  translations[currentLang as keyof typeof translations] ||
  translations.ro;

const year = new Date().getFullYear();
---

<footer
  class="
    bg-[#0A2D38]
    font-heading
    text-white
  "
>

  <!-- =====================================================
       MAIN FOOTER
  ====================================================== -->

  <div
    class="
      mx-auto
      max-w-site
      px-4
      sm:px-6
      lg:px-8
      py-12
      sm:py-14
      lg:py-16
    "
  >

    <div
      class="
        grid
        grid-cols-1
        sm:grid-cols-2
        lg:grid-cols-[1.25fr_0.7fr_0.9fr_1.35fr]
        gap-10
        lg:gap-9
        xl:gap-12
      "
    >

      <!-- =================================================
           BRAND
      ================================================== -->

      <div class="min-w-0">

        <a
          href={t.homeHref}
          class="inline-flex items-center"
          aria-label="Stay in Costa Blanca"
        >

          <div
            class="
              rounded-xl
              bg-white
              px-4
              py-3
            "
          >
            <img
              src="/sicb.png"
              alt="Stay in Costa Blanca"
              class="
                h-14
                sm:h-16
                w-auto
                object-contain
              "
              loading="lazy"
            />
          </div>

        </a>


        <p
          class="
            mt-5
            max-w-sm
            text-[15px]
            leading-7
            text-[#C8DCE1]
          "
        >
          {t.description}
        </p>


        <!-- POSITIONING -->

        <div
          class="
            mt-5
            inline-flex
            items-start
            gap-2.5
            rounded-lg
            border
            border-white/10
            bg-white/5
            px-3
            py-2.5
          "
        >

          <span
            class="
              mt-1.5
              h-2
              w-2
              shrink-0
              rounded-full
              bg-[#D99B26]
            "
            aria-hidden="true"
          ></span>

          <span
            class="
              text-[11px]
              sm:text-xs
              font-bold
              uppercase
              tracking-[0.09em]
              leading-5
              text-[#E1EEF1]
            "
          >
            {t.positioning}
          </span>

        </div>

      </div>


      <!-- =================================================
           NAVIGATION
      ================================================== -->

      <div class="min-w-0">

        <h2
          class="
            text-xs
            font-bold
            uppercase
            tracking-[0.16em]
            text-[#F3C76B]
          "
        >
          {t.navigationTitle}
        </h2>


        <nav
          class="
            mt-5
            flex
            flex-col
            gap-3
          "
          aria-label={t.navigationTitle}
        >

          {t.navigation.map((item) => (

            <a
              href={item.href}
              class="
                text-[15px]
                leading-6
                text-[#D2E3E7]
                transition-colors
                duration-200
                hover:text-white
              "
            >
              {item.label}
            </a>

          ))}

        </nav>

      </div>


      <!-- =================================================
           SERVICES
      ================================================== -->

      <div class="min-w-0">

        <h2
          class="
            text-xs
            font-bold
            uppercase
            tracking-[0.16em]
            text-[#F3C76B]
          "
        >
          {t.servicesTitle}
        </h2>


        <nav
          class="
            mt-5
            flex
            flex-col
            gap-3
          "
          aria-label={t.servicesTitle}
        >

          {t.services.map((item) => (

            <a
              href={item.href}
              class="
                text-[14px]
                xl:text-[15px]
                leading-6
                text-[#D2E3E7]
                transition-colors
                duration-200
                hover:text-white
              "
            >
              {item.label}
            </a>

          ))}

        </nav>

      </div>


      <!-- =================================================
           CONTACT
      ================================================== -->

      <div class="min-w-0">

        <h2
          class="
            text-xs
            font-bold
            uppercase
            tracking-[0.16em]
            text-[#F3C76B]
          "
        >
          {t.contactTitle}
        </h2>


        <div
          class="
            mt-5
            flex
            flex-col
            gap-4
          "
        >

          <!-- LOCATION -->

          <div
            class="
              flex
              items-center
              gap-3
            "
          >

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              class="
                h-5
                w-5
                shrink-0
                text-[#D99B26]
              "
              aria-hidden="true"
            >
              <path
                d="M12 21s7-5.1 7-11a7 7 0 10-14 0c0 5.9 7 11 7 11z"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />

              <circle
                cx="12"
                cy="10"
                r="2.3"
                stroke-width="1.8"
              />
            </svg>

            <span
              class="
                whitespace-nowrap
                text-[14px]
                xl:text-[15px]
                leading-6
                text-[#D2E3E7]
              "
            >
              {t.area}
            </span>

          </div>


          <!-- PHONE -->

          <a
            href="tel:+34624110656"
            class="
              group
              flex
              items-center
              gap-3
              w-fit
            "
          >

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              class="
                h-5
                w-5
                shrink-0
                text-[#D99B26]
              "
              aria-hidden="true"
            >
              <path
                d="M5 4h3l2 5-2 1.5c1.1 2.3 3.2 4.4 5.5 5.5L15 14l5 2v3c0 1.1-.9 2-2 2C10.3 21 3 13.7 3 6c0-1.1.9-2 2-2z"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>

            <span
              class="
                whitespace-nowrap
                text-[14px]
                xl:text-[15px]
                text-[#D2E3E7]
                transition-colors
                duration-200
                group-hover:text-white
              "
            >
              +34 624 110 656
            </span>

          </a>


          <!-- EMAIL -->

          <a
            href="mailto:stelian@stayincostablanca.com"
            class="
              group
              flex
              items-center
              gap-3
              w-fit
            "
          >

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              class="
                h-5
                w-5
                shrink-0
                text-[#D99B26]
              "
              aria-hidden="true"
            >
              <rect
                x="3"
                y="5"
                width="18"
                height="14"
                rx="2"
                stroke-width="1.7"
              />

              <path
                d="M4 7l8 6 8-6"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>

            <span
              class="
                whitespace-nowrap
                text-[13px]
                xl:text-[15px]
                leading-6
                text-[#D2E3E7]
                transition-colors
                duration-200
                group-hover:text-white
              "
            >
              stelian@stayincostablanca.com
            </span>

          </a>


          <!-- WEBSITE -->

          <a
            href="https://www.stayincostablanca.com"
            class="
              group
              flex
              items-center
              gap-3
              w-fit
            "
          >

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              class="
                h-5
                w-5
                shrink-0
                text-[#D99B26]
              "
              aria-hidden="true"
            >

              <circle
                cx="12"
                cy="12"
                r="9"
                stroke-width="1.7"
              />

              <path
                d="
                  M3.5 12h17
                  M12 3c2.2 2.5 3.2 5.5 3.2 9S14.2 18.5 12 21
                  M12 3C9.8 5.5 8.8 8.5 8.8 12s1 6.5 3.2 9
                "
                stroke-width="1.5"
              />

            </svg>

            <span
              class="
                whitespace-nowrap
                text-[14px]
                xl:text-[15px]
                text-[#D2E3E7]
                transition-colors
                duration-200
                group-hover:text-white
              "
            >
              stayincostablanca.com
            </span>

          </a>

        </div>

      </div>

    </div>

  </div>


  <!-- =====================================================
       BOTTOM BAR
  ====================================================== -->

  <div
    class="
      border-t
      border-white/10
    "
  >

    <div
      class="
        mx-auto
        max-w-site
        px-4
        sm:px-6
        lg:px-8
        py-5
      "
    >

      <div
        class="
          flex
          flex-col
          sm:flex-row
          sm:items-center
          sm:justify-between
          gap-3
          text-xs
          sm:text-sm
          text-[#91ABB3]
        "
      >

        <p>
          © {year} Stay in Costa Blanca. {t.rights}
        </p>


        <p
          class="
            font-semibold
            text-[#ABC0C6]
          "
        >
          {t.slogan}
        </p>

      </div>

    </div>

  </div>

</footer>
