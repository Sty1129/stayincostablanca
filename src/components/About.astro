---
// src/components/About.astro

const url = new URL(Astro.request.url);
const pathname = url.pathname;

const isEn = pathname.startsWith('/en/') || pathname === '/en';
const currentLang = isEn ? 'en' : 'ro';
const base = isEn ? '/en' : '';

const translations = {
  ro: {
    topper: 'PARTENERUL TĂU LOCAL',

    heading:
      'Prezență locală. Proces documentat. Responsabilitate reală.',

    intro:
      'Când ne încredințezi accesul la proprietatea ta, ne încredințezi mai mult decât o cheie.',

    body:
      'Stay in Costa Blanca combină prezența locală cu o abordare preventivă și documentată. Verificăm proprietatea, urmărim schimbările în timp și te informăm atunci când ceva necesită atenție.',

    points: [
      {
        title: 'Prezență locală',
        text: 'Orihuela Costa & Torrevieja',
        icon: 'location',
      },
      {
        title: 'Proces documentat',
        text: 'Fotografii, observații și istoric digital al proprietății',
        icon: 'document',
      },
      {
        title: 'Abordare preventivă',
        text: 'Identificăm schimbările înainte să devină probleme mai mari',
        icon: 'shield',
      },
    ],

    name: 'Stelian Matei',

    role:
      'Director General & Specialist în Administrarea Proprietăților',

    brandline:
      'Administrare Științifică & Sustenabilă a Proprietăților',

    ctaLabel: 'AFLĂ MAI MULTE DESPRE NOI',

    imageAlt:
      'Stelian Matei, Stay in Costa Blanca, administrarea proprietăților în Orihuela Costa și Torrevieja',
  },

  en: {
    topper: 'YOUR LOCAL PARTNER',

    heading:
      'Local presence. Documented process. Real accountability.',

    intro:
      'When you entrust us with access to your property, you are entrusting us with more than a key.',

    body:
      'Stay in Costa Blanca combines local presence with a preventive and documented approach. We check the property, track changes over time and keep you informed whenever something requires attention.',

    points: [
      {
        title: 'Local presence',
        text: 'Orihuela Costa & Torrevieja',
        icon: 'location',
      },
      {
        title: 'Documented process',
        text: 'Photos, observations and digital property history',
        icon: 'document',
      },
      {
        title: 'Preventive approach',
        text: 'We identify changes before they develop into bigger problems',
        icon: 'shield',
      },
    ],

    name: 'Stelian Matei',

    role:
      'Managing Director & Property Specialist',

    brandline:
      'Scientific & Sustainable Property Management',

    ctaLabel: 'LEARN MORE ABOUT US',

    imageAlt:
      'Stelian Matei, Stay in Costa Blanca property management',
  }
};

const t = translations[currentLang];
---

<section
  id="despre-noi"
  class="
    bg-white
    py-14
    sm:py-16
    md:py-20
    font-heading
    border-b
    border-[#D8E1E5]
  "
>
  <div
    class="
      mx-auto
      max-w-site
      px-4
      sm:px-6
      lg:px-8
    "
  >

    <div
      class="
        grid
        grid-cols-1
        lg:grid-cols-[1.05fr_0.95fr]
        gap-10
        lg:gap-14
        items-start
      "
    >

      <!-- =====================================================
           FOTO + IDENTITATE
      ====================================================== -->

      <div class="order-2 lg:order-1">

        <div
          class="
            overflow-hidden
            rounded-2xl
            border
            border-[#D1E0E5]
            shadow-[0_18px_40px_rgba(14,56,70,0.14)]
            bg-[#F7FAFA]
          "
        >

          <img
            src="/aboutme.png"
            alt={t.imageAlt}
            loading="lazy"
            decoding="async"
            class="
              block
              w-full
              aspect-[16/10]
              object-cover
              object-center
            "
          />

        </div>


        <!-- Identificare persoană -->
        <div
          class="
            relative
            -mt-5
            mx-4
            sm:mx-6
            bg-white
            rounded-xl
            border
            border-[#D4E1E5]
            shadow-[0_8px_24px_rgba(14,56,70,0.10)]
            px-5
            py-4
          "
        >

          <div
            class="
              flex
              flex-col
              sm:flex-row
              sm:items-center
              sm:justify-between
              gap-3
            "
          >

            <div>

              <p
                class="
                  text-lg
                  font-bold
                  text-[#0E3846]
                "
              >
                {t.name}
              </p>

              <p
                class="
                  mt-0.5
                  text-sm
                  font-semibold
                  text-[#526B74]
                "
              >
                {t.role}
              </p>

            </div>


            <div class="sm:text-right">

              <p
                class="
                  text-[11px]
                  font-bold
                  uppercase
                  tracking-[0.12em]
                  text-[#D99B26]
                "
              >
                STAY IN COSTA BLANCA
              </p>

              <p
                class="
                  mt-0.5
                  text-xs
                  font-semibold
                  text-[#5B9EB5]
                "
              >
                {t.brandline}
              </p>

            </div>

          </div>

        </div>

      </div>


      <!-- =====================================================
           TEXT
      ====================================================== -->

      <div class="order-1 lg:order-2">

        <p
          class="
            text-sm
            font-bold
            uppercase
            tracking-[0.16em]
            text-[#D99B26]
            mb-3
          "
        >
          {t.topper}
        </p>


        <h2
          class="
            text-[30px]
            sm:text-4xl
            lg:text-[42px]
            font-bold
            text-[#0E3846]
            tracking-tight
            leading-[1.13]
          "
        >
          {t.heading}
        </h2>


        <p
          class="
            mt-5
            text-[18px]
            sm:text-[19px]
            font-semibold
            text-[#294A55]
            leading-8
          "
        >
          {t.intro}
        </p>


        <p
          class="
            mt-3
            text-base
            sm:text-[17px]
            text-[#526B74]
            leading-7
            sm:leading-8
          "
        >
          {t.body}
        </p>


        <!-- =================================================
             3 ARGUMENTE
        ================================================== -->

        <div class="mt-7 space-y-3">

          {t.points.map((point) => (

            <div
              class="
                flex
                items-center
                gap-4
                rounded-xl
                bg-[#F7FAFA]
                border
                border-[#D7E3E6]
                px-4
                py-3.5
              "
            >

              <div
                class="
                  w-10
                  h-10
                  shrink-0
                  rounded-full
                  bg-[#E4F1F4]
                  flex
                  items-center
                  justify-center
                  text-[#0E3846]
                "
              >

                {point.icon === 'location' && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    class="w-5 h-5"
                    aria-hidden="true"
                  >
                    <path
                      d="M12 21s7-5.1 7-11a7 7 0 10-14 0c0 5.9 7 11 7 11z"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                    <circle
                      cx="12"
                      cy="10"
                      r="2.3"
                      stroke-width="1.8"
                    />
                  </svg>
                )}


                {point.icon === 'document' && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    class="w-5 h-5"
                    aria-hidden="true"
                  >
                    <rect
                      x="5"
                      y="3"
                      width="14"
                      height="18"
                      rx="2"
                      stroke-width="1.8"
                    />
                    <path
                      d="M8.5 8h7M8.5 12h7M8.5 16h4.5"
                      stroke-width="1.8"
                      stroke-linecap="round"
                    />
                  </svg>
                )}


                {point.icon === 'shield' && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    class="w-5 h-5"
                    aria-hidden="true"
                  >
                    <path
                      d="M12 3l7 3v5c0 4.5-2.7 8-7 10-4.3-2-7-5.5-7-10V6l7-3z"
                      stroke-width="1.8"
                      stroke-linejoin="round"
                    />
                    <path
                      d="M9 12l2 2 4-4"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                )}

              </div>


              <div>

                <h3
                  class="
                    text-base
                    sm:text-[17px]
                    font-bold
                    text-[#0E3846]
                  "
                >
                  {point.title}
                </h3>

                <p
                  class="
                    mt-0.5
                    text-sm
                    sm:text-[15px]
                    text-[#607983]
                    leading-6
                  "
                >
                  {point.text}
                </p>

              </div>

            </div>

          ))}

        </div>


        <!-- =================================================
             CTA
        ================================================== -->

        <div class="mt-7">

          <a
            href={`${base}/about`}
            class="
              inline-flex
              min-h-[50px]
              items-center
              justify-center
              gap-2
              rounded-xl
              border-2
              border-[#0E3846]
              bg-white
              px-6
              py-3
              text-sm
              sm:text-[15px]
              font-bold
              uppercase
              tracking-[0.05em]
              text-[#0E3846]
              transition-all
              duration-200
              hover:bg-[#0E3846]
              hover:text-white
            "
          >
            {t.ctaLabel}

            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 12h14m-5-5 5 5-5 5"
              />
            </svg>

          </a>

        </div>

      </div>

    </div>

  </div>
</section>
