---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import CTA from '../components/CTA.astro';
import { brand } from '../config/brand';
---

<BaseLayout
  title="Sustenabilitate"
  description={`Află cum integrează ${brand.name} principiile sustenabilității în administrarea proprietăților din Orihuela Costa și Torrevieja.`}
>
  <Header slot="header" />

  <Banner title="Sustenabilitate" />

  <!-- INTRO -->
  <section class="py-16 sm:py-20 bg-white font-heading border-b border-[#D8E1E5]">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto max-w-4xl text-center">
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-[#D99B26] mb-3">
          ADMINISTRARE RESPONSABILĂ
        </p>

        <h1 class="text-[30px] sm:text-4xl lg:text-[44px] font-bold text-[#0E3846] tracking-tight leading-tight">
          Sustenabilitate aplicată în administrarea proprietăților
        </h1>

        <p class="mt-5 text-base sm:text-lg text-[#405963] leading-7 sm:leading-8 max-w-3xl mx-auto">
          Pentru noi, sustenabilitatea nu înseamnă doar un concept frumos formulat.
          Înseamnă monitorizare atentă, prevenție, utilizarea responsabilă a resurselor
          și o administrare documentată, care contribuie la protejarea proprietății pe termen lung.
        </p>
      </div>
    </div>
  </section>

  <!-- PRINCIPII / PILONI -->
  <section class="py-16 sm:py-20 bg-[#FCFDFD] font-heading border-b border-[#D8E1E5]">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-[#D99B26] mb-3">
          CUM O INTEGRĂM
        </p>

        <h2 class="text-[28px] sm:text-4xl font-bold text-[#0E3846] tracking-tight leading-tight">
          Două direcții principale și două dimensiuni transversale
        </h2>

        <p class="mt-4 text-base sm:text-lg text-[#526B74] leading-7 max-w-3xl mx-auto">
          Abordarea noastră pornește de la două direcții operaționale clare,
          susținute permanent de digitalizare și colaborare locală.
        </p>
      </div>

      <!-- CELE 2 DIRECȚII PRINCIPALE -->
      <div class="mt-12 grid grid-cols-1 lg:grid-cols-2 gap-6 max-w-5xl mx-auto">
        <!-- RESURSE -->
        <article class="rounded-2xl border border-[#D2E1E5] bg-[#F7FAFA] p-6 sm:p-7">
          <div class="flex h-14 w-14 items-center justify-center rounded-full bg-[#E5F2F5] text-[#0E3846]">
            <svg
              viewBox="0 0 64 64"
              fill="none"
              stroke="currentColor"
              class="h-8 w-8"
              aria-hidden="true"
            >
              <!-- picătură -->
              <path
                d="M20 10S10 21 10 30a10 10 0 0020 0c0-9-10-20-10-20z"
                stroke-width="3"
                stroke-linejoin="round"
              />
              <!-- fulger -->
              <path
                d="M42 10L32 34h10l-5 20 17-27H43l7-17z"
                stroke-width="3"
                stroke-linejoin="round"
                stroke-linecap="round"
              />
            </svg>
          </div>

          <p class="mt-5 text-xs font-bold uppercase tracking-[0.12em] text-[#D99B26]">
            ODD 6 + ODD 7
          </p>

          <h3 class="mt-2 text-xl sm:text-2xl font-bold text-[#0E3846]">
            Resurse
          </h3>

          <p class="mt-3 text-[15px] leading-7 text-[#526B74]">
            Monitorizăm elementele relevante legate de apă și energie, documentăm consumurile
            și urmărim schimbările care pot indica pierderi, consum anormal sau funcționare
            ineficientă.
          </p>
        </article>

        <!-- PROPRIETATE & REZILIENȚĂ -->
        <article class="rounded-2xl border border-[#D2E1E5] bg-[#F7FAFA] p-6 sm:p-7">
          <div class="flex h-14 w-14 items-center justify-center rounded-full bg-[#E5F2F5] text-[#0E3846]">
            <svg
              viewBox="0 0 64 64"
              fill="none"
              stroke="currentColor"
              class="h-8 w-8"
              aria-hidden="true"
            >
              <!-- casă -->
              <path
                d="M8 30L26 15l18 15v22H8z"
                stroke-width="3"
                stroke-linejoin="round"
              />
              <path
                d="M20 52V39h12v13"
                stroke-width="3"
                stroke-linejoin="round"
              />
              <!-- scut -->
              <path
                d="M46 26l10 4v9c0 8-5 13-10 16-5-3-10-8-10-16v-9l10-4z"
                stroke-width="3"
                stroke-linejoin="round"
              />
              <path
                d="M42 39l3 3 6-7"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </div>

          <p class="mt-5 text-xs font-bold uppercase tracking-[0.12em] text-[#D99B26]">
            ODD 11 + ODD 12 + ODD 13
          </p>

          <h3 class="mt-2 text-xl sm:text-2xl font-bold text-[#0E3846]">
            Proprietate &amp; reziliență
          </h3>

          <p class="mt-3 text-[15px] leading-7 text-[#526B74]">
            Verificările preventive, observarea schimbărilor și intervenția la timp contribuie
            la reducerea degradării și la prelungirea duratei de viață a proprietății și echipamentelor.
          </p>
        </article>
      </div>

      <!-- DIMENSIUNI TRANSVERSALE -->
      <div class="mt-12 mx-auto max-w-5xl">
        <div class="text-center">
          <p class="text-xs font-bold uppercase tracking-[0.17em] text-[#D99B26]">
            DIMENSIUNI TRANSVERSALE
          </p>

          <h3 class="mt-2 text-2xl sm:text-3xl font-bold text-[#0E3846]">
            Două elemente susțin întregul nostru proces
          </h3>

          <p class="mx-auto mt-3 max-w-3xl text-base leading-7 text-[#526B74]">
            Digitalizarea și colaborarea locală nu aparțin unui singur tip de verificare.
            Ele traversează întregul proces de administrare și fac posibilă monitorizarea
            documentată, trasabilitatea și coordonarea intervențiilor.
          </p>
        </div>

        <div class="mt-7 grid grid-cols-1 lg:grid-cols-2 gap-5">
          <!-- DIGITALIZARE -->
          <article class="flex gap-5 rounded-2xl border border-[#BFD7DE] bg-[#EEF7F9] p-6">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white text-[#0E3846]">
              <svg
                viewBox="0 0 64 64"
                fill="none"
                stroke="currentColor"
                class="h-7 w-7"
                aria-hidden="true"
              >
                <rect x="10" y="8" width="34" height="44" rx="4" stroke-width="3" />
                <path d="M18 19h18M18 27h12" stroke-width="3" stroke-linecap="round" />
                <path
                  d="M18 42l7-8 6 5 11-13"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
                <circle cx="48" cy="44" r="9" stroke-width="3" />
                <path
                  d="M44 44l3 3 5-6"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </div>

            <div>
              <p class="text-[10px] font-bold uppercase tracking-[0.12em] text-[#397C92]">
                TRANSVERSAL ÎN TOATE PACHETELE
              </p>

              <h4 class="mt-1 text-xl font-bold text-[#0E3846]">
                Digitalizare &amp; trasabilitate
              </h4>

              <p class="mt-2 text-sm leading-6 text-[#526B74]">
                Fotografiile, valorile măsurate, rapoartele și istoricul vizitelor creează
                continuitate între verificări. Astfel putem compara starea proprietății în timp
                și putem identifica mai ușor schimbările relevante.
              </p>
            </div>
          </article>

          <!-- PARTENERIATE -->
          <article class="flex gap-5 rounded-2xl border border-[#E2D3A9] bg-[#FFF9ED] p-6">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white text-[#0E3846]">
              <svg
                viewBox="0 0 64 64"
                fill="none"
                stroke="currentColor"
                class="h-8 w-8"
                aria-hidden="true"
              >
                <path
                  d="M7 28l11-10 12 5"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
                <path
                  d="M57 28L46 18l-13 6"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
                <path
                  d="M24 25l8-5c3-2 6-1 8 1l5 5"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
                <path
                  d="M17 34l14 13c2 2 5 2 7 0l11-11"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
                <path
                  d="M26 41l5-5M32 46l5-5M38 46l5-5"
                  stroke-width="3"
                  stroke-linecap="round"
                />
              </svg>
            </div>

            <div>
              <p class="text-[10px] font-bold uppercase tracking-[0.12em] text-[#D18D13]">
                TRANSVERSAL ÎN ADMINISTRAREA PROPRIETĂȚII
              </p>

              <h4 class="mt-1 text-xl font-bold text-[#0E3846]">
                Parteneriate locale
              </h4>

              <p class="mt-2 text-sm leading-6 text-[#526B74]">
                Colaborarea cu tehnicieni, furnizori și profesioniști locali ne permite
                să transformăm o problemă identificată într-o acțiune coordonată atunci când este necesar.
              </p>

              <p class="mt-3 text-xs font-bold uppercase tracking-[0.1em] text-[#D99B26]">
                ODD 17
              </p>
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- ÎN PRACTICĂ -->
  <section class="py-16 sm:py-20 bg-white font-heading border-b border-[#D8E1E5]">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-[#D99B26] mb-3">
          ÎN PRACTICĂ
        </p>

        <h2 class="text-[28px] sm:text-4xl font-bold text-[#0E3846] tracking-tight leading-tight">
          Cum se traduce sustenabilitatea în serviciile noastre
        </h2>

        <p class="mt-4 text-base sm:text-lg text-[#526B74] leading-7">
          Integrăm aceste principii în mod gradual, de la monitorizare și prevenție
          până la optimizare și coordonare responsabilă.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- 1 -->
        <article class="rounded-2xl border border-[#D2E1E5] bg-[#F7FAFA] p-6 sm:p-7">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#D99B26]">
            NIVEL 1
          </p>

          <h3 class="mt-2 text-xl font-bold text-[#0E3846]">
            Awareness & Monitoring
          </h3>

          <p class="mt-3 text-sm leading-6 text-[#526B74]">
            Observăm, măsurăm și documentăm elementele relevante pentru a crea un punct
            de referință și un istoric comparabil al proprietății.
          </p>

          <ul class="mt-5 space-y-3 text-sm text-[#405963]">
            <li class="flex gap-3">
              <span class="mt-1 h-2.5 w-2.5 rounded-full bg-[#D99B26] shrink-0"></span>
              Verificarea vizuală a instalațiilor și accesului
            </li>
            <li class="flex gap-3">
              <span class="mt-1 h-2.5 w-2.5 rounded-full bg-[#D99B26] shrink-0"></span>
              Fotografii și observații comparative
            </li>
            <li class="flex gap-3">
              <span class="mt-1 h-2.5 w-2.5 rounded-full bg-[#D99B26] shrink-0"></span>
              Monitorizarea consumului și a semnalelor timpurii
            </li>
          </ul>
        </article>

        <!-- 2 -->
        <article class="rounded-2xl border border-[#D2E1E5] bg-[#F7FAFA] p-6 sm:p-7">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#D99B26]">
            NIVEL 2
          </p>

          <h3 class="mt-2 text-xl font-bold text-[#0E3846]">
            Optimization & Efficiency
          </h3>

          <p class="mt-3 text-sm leading-6 text-[#526B74]">
            Comparăm informațiile în timp și identificăm situațiile în care pot fi
            prevenite pierderi, supraconsum sau degradări evitabile.
          </p>

          <ul class="mt-5 space-y-3 text-sm text-[#405963]">
            <li class="flex gap-3">
              <span class="mt-1 h-2.5 w-2.5 rounded-full bg-[#D99B26] shrink-0"></span>
              Interpretarea variațiilor de consum
            </li>
            <li class="flex gap-3">
              <span class="mt-1 h-2.5 w-2.5 rounded-full bg-[#D99B26] shrink-0"></span>
              Screening preventiv pentru umiditate și echipamente
            </li>
            <li class="flex gap-3">
              <span class="mt-1 h-2.5 w-2.5 rounded-full bg-[#D99B26] shrink-0"></span>
              Recomandări bazate pe observații documentate
            </li>
          </ul>
        </article>

        <!-- 3 -->
        <article class="rounded-2xl border border-[#D2E1E5] bg-[#F7FAFA] p-6 sm:p-7">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#D99B26]">
            NIVEL 3
          </p>

          <h3 class="mt-2 text-xl font-bold text-[#0E3846]">
            Resilience & Impact
          </h3>

          <p class="mt-3 text-sm leading-6 text-[#526B74]">
            Atunci când apare o nevoie reală de intervenție, susținem coordonarea locală
            astfel încât proprietatea să fie protejată rapid și responsabil.
          </p>

          <ul class="mt-5 space-y-3 text-sm text-[#405963]">
            <li class="flex gap-3">
              <span class="mt-1 h-2.5 w-2.5 rounded-full bg-[#D99B26] shrink-0"></span>
              Coordonarea accesului pentru tehnicieni
            </li>
            <li class="flex gap-3">
              <span class="mt-1 h-2.5 w-2.5 rounded-full bg-[#D99B26] shrink-0"></span>
              Verificări după vreme severă sau incidente
            </li>
            <li class="flex gap-3">
              <span class="mt-1 h-2.5 w-2.5 rounded-full bg-[#D99B26] shrink-0"></span>
              Menținerea proprietății într-o stare bună pe termen lung
            </li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- SECȚIUNE DIGITALĂ -->
  <section class="py-16 sm:py-20 bg-[#F7FAFA] font-heading border-b border-[#D8E1E5]">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto max-w-4xl text-center">
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-[#D99B26] mb-3">
          DIGITALIZARE & TRASABILITATE
        </p>

        <h2 class="text-[28px] sm:text-4xl font-bold text-[#0E3846] tracking-tight leading-tight">
          Sustenabilitatea are nevoie și de date
        </h2>

        <p class="mt-4 text-base sm:text-lg text-[#526B74] leading-7">
          Nu este suficient să spunem că „totul pare în regulă”.
          O administrare responsabilă are nevoie de istoric, comparație și continuitate.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="rounded-2xl bg-white border border-[#D2E1E5] p-6 sm:p-7">
          <h3 class="text-xl font-bold text-[#0E3846]">
            Ce documentăm
          </h3>

          <ul class="mt-5 space-y-3 text-sm text-[#526B74]">
            <li class="flex gap-3">
              <span class="mt-1 h-2.5 w-2.5 rounded-full bg-[#0E3846] shrink-0"></span>
              Fotografii comparative ale spațiilor și echipamentelor
            </li>
            <li class="flex gap-3">
              <span class="mt-1 h-2.5 w-2.5 rounded-full bg-[#0E3846] shrink-0"></span>
              Observații privind schimbările vizibile între vizite
            </li>
            <li class="flex gap-3">
              <span class="mt-1 h-2.5 w-2.5 rounded-full bg-[#0E3846] shrink-0"></span>
              Citiri relevante și date utile acolo unde este posibil
            </li>
            <li class="flex gap-3">
              <span class="mt-1 h-2.5 w-2.5 rounded-full bg-[#0E3846] shrink-0"></span>
              Incidente, alerte și recomandări
            </li>
          </ul>
        </div>

        <div class="rounded-2xl bg-white border border-[#D2E1E5] p-6 sm:p-7">
          <h3 class="text-xl font-bold text-[#0E3846]">
            De ce contează
          </h3>

          <ul class="mt-5 space-y-3 text-sm text-[#526B74]">
            <li class="flex gap-3">
              <span class="mt-1 h-2.5 w-2.5 rounded-full bg-[#D99B26] shrink-0"></span>
              Ajută la depistarea timpurie a problemelor
            </li>
            <li class="flex gap-3">
              <span class="mt-1 h-2.5 w-2.5 rounded-full bg-[#D99B26] shrink-0"></span>
              Permite comparația între vizite și sezoane
            </li>
            <li class="flex gap-3">
              <span class="mt-1 h-2.5 w-2.5 rounded-full bg-[#D99B26] shrink-0"></span>
              Susține comunicarea clară cu proprietarul
            </li>
            <li class="flex gap-3">
              <span class="mt-1 h-2.5 w-2.5 rounded-full bg-[#D99B26] shrink-0"></span>
              Creează o bază utilă pentru coordonarea intervențiilor
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CONCLUZIE -->
  <section class="py-16 sm:py-20 bg-white font-heading">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 text-center">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-[#D99B26] mb-3">
        CONCLUZIE
      </p>

      <h2 class="text-[28px] sm:text-4xl font-bold text-[#0E3846] tracking-tight leading-tight">
        Administrare mai atentă. Proprietăți mai bine protejate.
      </h2>

      <p class="mt-5 text-base sm:text-lg text-[#526B74] leading-8">
        Pentru noi, sustenabilitatea în administrarea proprietăților înseamnă
        grijă pentru resurse, prevenție, documentare și responsabilitate.
        Înseamnă să observăm din timp, să comunicăm clar și să acționăm local atunci când este nevoie.
      </p>
    </div>
  </section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>
