import Footer from '../components/Footer.astro';
import CTA from '../components/CTA.astro';
import { brand } from '../config/brand';


/* =========================================================
   LANGUAGE
========================================================= */

const currentLang = Astro.currentLocale || 'ro';

const lang =
  currentLang === 'en' || currentLang === 'es'
    ? currentLang
    : 'ro';


/* =========================================================
   ROUTES
========================================================= */

const routes = {
  ro: {
    services: '/services',
    contact: '/contact',
  },

  en: {
    services: '/en/services',
    contact: '/en/contact',
  },

  es: {
    services: '/es/services',
    contact: '/es/contact',
  },
};

const r = routes[lang];


