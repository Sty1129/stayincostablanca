---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTA from '../components/CTA.astro';
import { brand } from '../config/brand';


/* =========================================================
   ODD / SDG DATA
========================================================= */

const oddItems = [
  {
    number: 6,
    title: 'Apă curată și sanitație',
    short: 'Monitorizarea apei',
    text:
      'Fotografiile contoarelor, verificările instalațiilor sanitare și observarea eventualelor pierderi ne ajută să identificăm mai repede situațiile care pot duce la risipă de apă.',
  },

  {
    number: 7,
    title: 'Energie curată și la prețuri accesibile',
    short: 'Monitorizarea energiei',
    text:
      'Urmărirea consumurilor și verificarea funcționării de bază a echipamentelor pot evidenția schimbări care merită investigate înainte ca acestea să genereze consum inutil.',
  },

  {
    number: 11,
    title: 'Orașe și comunități durabile',
    short: 'Proprietăți mai reziliente',
    text:
      'Întreținerea preventivă și monitorizarea regulată contribuie la păstrarea proprietăților într-o stare mai bună în perioadele în care acestea sunt nelocuite.',
  },

  {
    number: 12,
    title: 'Consum și producție responsabile',
    short: 'Prevenție înainte de înlocuire',
    text:
      'Identificarea timpurie a unei probleme poate permite o intervenție minoră înainte ca deteriorarea să impună reparații mai ample, materiale suplimentare sau înlocuirea unor echipamente.',
  },

  {
    number: 13,
    title: 'Acțiune climatică',
    short: 'Pregătire & reziliență',
    text:
      'Verificările după episoade de vreme severă și monitorizarea elementelor exterioare ajută la identificarea mai rapidă a efectelor produse de condițiile meteo extreme.',
  },

  {
    number: 17,
    title: 'Parteneriate pentru realizarea obiectivelor',
    short: 'Colaborare locală',
    text:
      'Administrarea proprietății presupune uneori colaborarea cu tehnicieni, furnizori și profesioniști locali. Coordonarea responsabilă face parte din procesul nostru.',
  },
];


/* =========================================================
   HERO ODD
========================================================= */

const heroOdds = [
  {
    number: 6,
    title: 'Apă curată și sanitație',
  },

  {
    number: 7,
    title: 'Energie curată și la prețuri accesibile',
  },

  {
    number: 9,
    title: 'Industrie, inovație și infrastructură',
  },

  {
    number: 11,
    title: 'Orașe și comunități durabile',
  },

  {
    number: 12,
    title: 'Consum și producție responsabile',
  },

  {
    number: 13,
    title: 'Acțiune climatică',
  },

  {
    number: 17,
    title: 'Parteneriate pentru realizarea obiectivelor',
  },
];


/* =========================================================
   PACKAGE LEVELS
========================================================= */

const packageLevels = [
  {
    name: 'ECO-BASIC',
    level: 'WATCH',
    subtitle: 'Awareness & Monitoring',

    featured: false,

    odds: [6, 7, 9, 11],

    items: [
      'Fotografii ale contoarelor',
      'Verificări periodice ale apei și instalațiilor sanitare',
      'Observarea vizuală a umidității și infiltrațiilor',
      'Verificare funcțională de bază a aerului condiționat',
      'Raport digital după fiecare vizită',
    ],
  },

  {
    name: 'ECO-SMART',
    level: 'PREVENT',
    subtitle: 'Optimization & Efficiency',

    featured: true,

    odds: [6, 7, 9, 11, 12, 13],

    items: [
      'Tot ce include ECO-BASIC',
      'Temperatură și umiditate relativă',
      'Ventilație asistată',
      'Citiri comparative de umiditate',
      'Analiză trimestrială apă & energie',
      'Screening preventiv al aerului condiționat',
    ],
  },

  {
    name: 'ECO-PREMIUM',
    level: 'MANAGE',
    subtitle: 'Resilience & Impact',

    featured: false,

    odds: [6, 7, 9, 11, 12, 13, 17],

    items: [
      'Tot ce include ECO-SMART',
      'Analiză lunară apă & energie',
      'Extended Property Reviews',
      'Mai multe verificări după vreme severă',
      'Property Health Report anual',
      'Coordonare locală extinsă',
    ],
  },
];


/* =========================================================
   PRACTICAL EXAMPLES
========================================================= */

const practicalItems = [
  {
    number: '01',

    title:
      'O variație neașteptată a consumului de apă',

    text:
      'Poate indica o pierdere sau o problemă care merită verificată înainte de următoarea factură.',
  },

  {
    number: '02',

    title:
      'Umiditate în creștere',

    text:
      'Compararea valorilor între vizite poate evidenția o schimbare înainte ca deteriorarea să devină evidentă vizual.',
  },

  {
    number: '03',

    title:
      'Drenaj blocat pe terasă',

    text:
      'Identificat înaintea unei ploi puternice, poate preveni acumularea apei și eventuale infiltrații.',
  },

  {
    number: '04',

    title:
      'Un echipament care funcționează diferit',

    text:
      'O schimbare observată în timpul unei verificări poate fi investigată înainte de apariția unei defecțiuni mai serioase.',
  },
];
---

<BaseLayout
  title={`Sustenabilitate | ${brand.name}`}
  description="Administrare preventivă și sustenabilă a proprietăților din Costa Blanca: apă, energie, reziliență, digitalizare, trasabilitate și parteneriate locale."
>

  <Header slot="header" />


  <!-- =====================================================
       HERO
  ====================================================== -->

  <section
    class="
      relative
      overflow-hidden

      bg-[#0E3846]

      py-16
      sm:py-20
      lg:py-24

      font-heading
    "
  >

    <!-- BACKGROUND -->

    <div
      class="
        pointer-events-none

        absolute
        -right-24
        -top-24

        h-96
        w-96

        rounded-full

        bg-[#5B9EB5]/20

        blur-3xl
      "
    ></div>


    <div
      class="
        pointer-events-none

        absolute
        -bottom-32
        -left-24

        h-80
        w-80

        rounded-full

        bg-[#D99B26]/10

        blur-3xl
      "
    ></div>


    <div
      class="
        relative

        mx-auto
        max-w-site

        px-4
        sm:px-6
        lg:px-8
      "
    >

      <div
        class="
          mx-auto
          max-w-5xl
          text-center
        "
      >

        <p
          class="
            text-sm
            font-bold
            uppercase
            tracking-[0.18em]

            text-[#F3C76B]
          "
        >
          SUSTENABILITATE APLICATĂ
        </p>


        <h1
          class="
            mt-4

            text-[36px]
            sm:text-5xl
            lg:text-[58px]

            font-bold

            leading-[1.08]
            tracking-tight

            text-white
          "
        >
          Sustenabilitate aplicată în administrarea proprietăților.
        </h1>


        <p
          class="
            mx-auto
            mt-6
            max-w-4xl

            text-base
            sm:text-lg

            leading-8

            text-[#C9DDE2]
          "
        >
          Pentru noi, sustenabilitatea înseamnă prevenție, utilizarea
          responsabilă a resurselor, documentare și o administrare care ajută
          proprietatea să își păstreze valoarea și funcționalitatea în timp.
        </p>


        <!-- ODD ICONS -->

        <div
          class="
            mt-9

            flex
            flex-wrap

            justify-center

            gap-3
          "
        >

          {
            heroOdds.map((odd) => (

              <a
                href={
                  odd.number === 9
                    ? '#digitalizare'
                    : `#odd-${odd.number}`
                }

                class="
                  rounded-xl

                  bg-white

                  p-1.5

                  shadow-[0_6px_18px_rgba(0,0,0,0.14)]

                  transition

                  hover:-translate-y-1
                "
              >

                <img
                  src={`/odd-${odd.number}-ro.png`}

                  alt={`ODD ${odd.number} — ${odd.title}`}

                  class="
                    h-[62px]
                    w-[62px]

                    sm:h-[70px]
                    sm:w-[70px]

                    object-contain
                  "
                />

              </a>

            ))
          }

        </div>


        <p
          class="
            mt-6

            text-sm
            font-semibold

            text-[#D8E6EA]
          "
        >
          ODD 6 · ODD 7 · ODD 9 · ODD 11 · ODD 12 · ODD 13 · ODD 17
        </p>


        <div
          class="
            mt-8

            flex
            flex-col
            sm:flex-row

            justify-center

            gap-3
          "
        >

          <a
            href="#abordare"

            class="
              inline-flex
              min-h-[52px]

              items-center
              justify-center

              rounded-xl

              bg-[#D99B26]

              px-7
              py-3

              text-sm
              font-bold

              text-[#0E3846]

              transition

              hover:bg-[#E7AA38]
            "
          >
            DESCOPERĂ ABORDAREA NOASTRĂ
          </a>


          <a
            href="/services"

            class="
              inline-flex
              min-h-[52px]

              items-center
              justify-center

              rounded-xl

              border
              border-white/25

              px-7
              py-3

              text-sm
              font-bold

              text-white

              transition

              hover:bg-white/10
            "
          >
            VEZI PACHETELE
          </a>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================================
       APPROACH
  ====================================================== -->

  <section
    id="abordare"

    class="
      scroll-mt-24

      bg-white

      py-16
      sm:py-20

      font-heading
    "
  >

    <div
      class="
        mx-auto
        max-w-site

        px-4
        sm:px-6
        lg:px-8
      "
    >

      <!-- INTRO -->

      <div
        class="
          mx-auto
          max-w-4xl
          text-center
        "
      >

        <p
          class="
            text-sm
            font-bold
            uppercase
            tracking-[0.17em]

            text-[#D99B26]
          "
        >
          CUM INTEGRĂM SUSTENABILITATEA
        </p>


        <h2
          class="
            mt-3

            text-[30px]
            sm:text-4xl
            lg:text-[44px]

            font-bold

            tracking-tight

            text-[#0E3846]
          "
        >
          Două direcții operaționale. Două dimensiuni transversale.
        </h2>


        <p
          class="
            mx-auto
            mt-5
            max-w-3xl

            text-base
            sm:text-lg

            leading-8

            text-[#526B74]
          "
        >
          Activitatea noastră se concentrează pe gestionarea resurselor și
          reziliența proprietății. Digitalizarea și parteneriatele locale
          susțin întregul proces.
        </p>

      </div>


      <!-- =================================================
           MAIN AXES
      ================================================== -->

      <div
        class="
          mx-auto
          mt-12

          grid
          max-w-5xl

          grid-cols-1
          lg:grid-cols-2

          gap-6
        "
      >

        <!-- =================================================
             RESOURCES
        ================================================== -->

        <article
          class="
            rounded-2xl

            border
            border-[#D2E1E5]

            bg-[#F7FAFA]

            p-6
            sm:p-8
          "
        >

          <!-- ICON -->

          <div
            class="
              flex
              h-16
              w-16

              items-center
              justify-center

              rounded-full

              bg-[#E5F2F5]

              text-[#0E3846]
            "
          >

            <svg
              viewBox="0 0 64 64"
              fill="none"
              stroke="currentColor"

              class="
                h-9
                w-9
              "

              aria-hidden="true"
            >

              <!-- WATER -->

              <path
                d="M18 9S8 21 8 30a10 10 0 0020 0C28 21 18 9 18 9z"
                stroke-width="3"
                stroke-linejoin="round"
              />


              <!-- ENERGY -->

              <path
                d="M43 8L31 34h11l-5 22 19-30H44l7-18z"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              />

            </svg>

          </div>


          <!-- ODD ICONS -->

          <div
            class="
              mt-6

              flex
              flex-wrap

              gap-2
            "
          >

            {
              [6, 7].map((odd) => (

                <img
                  src={`/odd-${odd}-ro.png`}

                  alt={`ODD ${odd}`}

                  class="
                    h-[58px]
                    w-[58px]

                    object-contain
                  "
                />

              ))
            }

          </div>


          <p
            class="
              mt-5

              text-xs
              font-bold
              uppercase
              tracking-[0.13em]

              text-[#D99B26]
            "
          >
            ODD 6 + ODD 7
          </p>


          <h3
            class="
              mt-2

              text-2xl
              font-bold

              text-[#0E3846]
            "
          >
            Resurse
          </h3>


          <p
            class="
              mt-4

              text-[15px]
              leading-7

              text-[#526B74]
            "
          >
            Monitorizăm elementele relevante legate de apă și energie,
            documentăm consumurile și urmărim schimbările care pot indica
            pierderi, consum anormal sau funcționare ineficientă.
          </p>

        </article>


        <!-- =================================================
             PROPERTY & RESILIENCE
        ================================================== -->

        <article
          class="
            rounded-2xl

            border
            border-[#D2E1E5]

            bg-[#F7FAFA]

            p-6
            sm:p-8
          "
        >

          <!-- ICON -->

          <div
            class="
              flex
              h-16
              w-16

              items-center
              justify-center

              rounded-full

              bg-[#E5F2F5]

              text-[#0E3846]
            "
          >

            <svg
              viewBox="0 0 64 64"
              fill="none"
              stroke="currentColor"

              class="
                h-9
                w-9
              "

              aria-hidden="true"
            >

              <!-- HOUSE -->

              <path
                d="M7 30L26 14l19 16v22H7z"
                stroke-width="3"
                stroke-linejoin="round"
              />


              <path
                d="M20 52V38h12v14"
                stroke-width="3"
                stroke-linejoin="round"
              />


              <!-- SHIELD -->

              <path
                d="M46 26l11 4v10c0 8-5 13-11 17-6-4-11-9-11-17V30l11-4z"
                fill="#F7FAFA"
                stroke-width="3"
                stroke-linejoin="round"
              />


              <path
                d="M41.5 40l3.5 3.5 6-7"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              />

            </svg>

          </div>


          <!-- ODD ICONS -->

          <div
            class="
              mt-6

              flex
              flex-wrap

              gap-2
            "
          >

            {
              [11, 12, 13].map((odd) => (

                <img
                  src={`/odd-${odd}-ro.png`}

                  alt={`ODD ${odd}`}

                  class="
                    h-[58px]
                    w-[58px]

                    object-contain
                  "
                />

              ))
            }

          </div>


          <p
            class="
              mt-5

              text-xs
              font-bold
              uppercase
              tracking-[0.13em]

              text-[#D99B26]
            "
          >
            ODD 11 + ODD 12 + ODD 13
          </p>


          <h3
            class="
              mt-2

              text-2xl
              font-bold

              text-[#0E3846]
            "
          >
            Proprietate &amp; reziliență
          </h3>


          <p
            class="
              mt-4

              text-[15px]
              leading-7

              text-[#526B74]
            "
          >
            Verificările preventive, observarea schimbărilor și intervenția
            la timp contribuie la reducerea degradării și la prelungirea
            duratei de viață a proprietății și echipamentelor.
          </p>

        </article>

      </div>


      <!-- =================================================
           TRANSVERSAL DIMENSIONS
      ================================================== -->

      <div
        class="
          mx-auto
          mt-12
          max-w-5xl
        "
      >

        <div class="text-center">

          <p
            class="
              text-xs
              font-bold
              uppercase
              tracking-[0.17em]

              text-[#D99B26]
            "
          >
            DIMENSIUNI TRANSVERSALE
          </p>


          <h3
            class="
              mt-2

              text-2xl
              sm:text-3xl

              font-bold

              text-[#0E3846]
            "
          >
            Două elemente susțin întregul nostru proces.
          </h3>


          <p
            class="
              mx-auto
              mt-3
              max-w-3xl

              text-base
              leading-7

              text-[#526B74]
            "
          >
            Digitalizarea și colaborarea locală nu aparțin unei singure
            verificări. Ele traversează întregul sistem de administrare.
          </p>

        </div>


        <div
          class="
            mt-7

            grid
            grid-cols-1
            lg:grid-cols-2

            gap-5
          "
        >

          <!-- =================================================
               DIGITALISATION / ODD 9
          ================================================== -->

          <article
            class="
              flex
              gap-5

              rounded-2xl

              border
              border-[#BFD7DE]

              bg-[#EEF7F9]

              p-6
            "
          >

            <div
              class="
                flex
                h-12
                w-12

                shrink-0

                items-center
                justify-center

                rounded-full

                bg-white

                text-[#0E3846]
              "
            >

              <svg
                viewBox="0 0 64 64"
                fill="none"
                stroke="currentColor"

                class="
                  h-7
                  w-7
                "

                aria-hidden="true"
              >

                <rect
                  x="10"
                  y="8"
                  width="34"
                  height="44"
                  rx="4"
                  stroke-width="3"
                />

                <path
                  d="M18 19h18M18 27h12"
                  stroke-width="3"
                  stroke-linecap="round"
                />

                <path
                  d="M18 42l7-8 6 5 11-13"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />

                <circle
                  cx="48"
                  cy="44"
                  r="9"
                  fill="#EEF7F9"
                  stroke-width="3"
                />

                <path
                  d="M44 44l3 3 5-6"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />

              </svg>

            </div>


            <div class="flex-1">

              <div
                class="
                  flex
                  items-start
                  justify-between
                  gap-4
                "
              >

                <div>

                  <p
                    class="
                      text-[10px]
                      font-bold
                      uppercase
                      tracking-[0.12em]

                      text-[#397C92]
                    "
                  >
                    TRANSVERSAL ÎN TOATE PACHETELE
                  </p>


                  <h4
                    class="
                      mt-1

                      text-xl
                      font-bold

                      text-[#0E3846]
                    "
                  >
                    Digitalizare &amp; trasabilitate
                  </h4>

                </div>


                <img
                  src="/odd-9-ro.png"

                  alt="ODD 9 — Industrie, inovație și infrastructură"

                  class="
                    hidden
                    sm:block

                    h-[64px]
                    w-[64px]

                    shrink-0

                    object-contain
                  "
                />

              </div>


              <p
                class="
                  mt-2

                  text-sm
                  leading-6

                  text-[#526B74]
                "
              >
                Fotografiile, valorile măsurate, rapoartele și istoricul
                vizitelor creează continuitate între verificări și permit
                compararea stării proprietății în timp.
              </p>


              <p
                class="
                  mt-3

                  text-xs
                  font-bold
                  uppercase
                  tracking-[0.1em]

                  text-[#397C92]
                "
              >
                ODD 9
              </p>

            </div>

          </article>


          <!-- =================================================
               PARTNERSHIPS / ODD 17
          ================================================== -->

          <article
            class="
              flex
              gap-5

              rounded-2xl

              border
              border-[#E2D3A9]

              bg-[#FFF9ED]

              p-6
            "
          >

            <div
              class="
                flex
                h-12
                w-12

                shrink-0

                items-center
                justify-center

                rounded-full

                bg-white

                text-[#0E3846]
              "
            >

              <svg
                viewBox="0 0 64 64"
                fill="none"
                stroke="currentColor"

                class="
                  h-8
                  w-8
                "

                aria-hidden="true"
              >

                <path
                  d="M7 28l11-10 12 5"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />

                <path
                  d="M57 28L46 18l-13 6"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />

                <path
                  d="M24 25l8-5c3-2 6-1 8 1l5 5"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />

                <path
                  d="M17 34l14 13c2 2 5 2 7 0l11-11"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />

              </svg>

            </div>


            <div class="flex-1">

              <div
                class="
                  flex
                  items-start
                  justify-between
                  gap-4
                "
              >

                <div>

                  <p
                    class="
                      text-[10px]
                      font-bold
                      uppercase
                      tracking-[0.12em]

                      text-[#D18D13]
                    "
                  >
                    TRANSVERSAL ÎN ADMINISTRAREA PROPRIETĂȚII
                  </p>


                  <h4
                    class="
                      mt-1

                      text-xl
                      font-bold

                      text-[#0E3846]
                    "
                  >
                    Parteneriate locale
                  </h4>

                </div>


                <img
                  src="/odd-17-ro.png"

                  alt="ODD 17 — Parteneriate pentru realizarea obiectivelor"

                  class="
                    hidden
                    sm:block

                    h-[64px]
                    w-[64px]

                    shrink-0

                    object-contain
                  "
                />

              </div>


              <p
                class="
                  mt-2

                  text-sm
                  leading-6

                  text-[#526B74]
                "
              >
                Colaborarea cu tehnicieni, furnizori și profesioniști locali
                ne permite să transformăm o problemă identificată într-o
                acțiune coordonată atunci când este necesar.
              </p>


              <p
                class="
                  mt-3

                  text-xs
                  font-bold
                  uppercase
                  tracking-[0.1em]

                  text-[#D99B26]
                "
              >
                ODD 17
              </p>

            </div>

          </article>

        </div>

      </div>

