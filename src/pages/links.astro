---
const pageTitle = "Stay in Costa Blanca";
const phone = "+34 624 110 656";
const whatsAppUrl = `https://wa.me/34624110656?text=Hi,%20I%20need%20more%20information%20about%20your%20property%20services.`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --grad-a: #0f4c75;
        --grad-b: #1b6ca8;
        --grad-c: #0d7377;
        --grad-d: #14a085;
        --card-bg: rgba(255,255,255,0.12);
        --card-border: rgba(255,255,255,0.28);
        --card-hover-bg: rgba(255,255,255,0.22);
        --text: #ffffff;
        --text-muted: rgba(255,255,255,0.72);
        --wa-green: #25d366;
      }

      html { scroll-behavior: smooth; }

      body {
        min-height: 100vh;
        font-family: 'DM Sans', sans-serif;
        color: var(--text);
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 0 0 60px;
        background:
          radial-gradient(ellipse at 20% 0%, rgba(20,160,133,0.55) 0%, transparent 55%),
          radial-gradient(ellipse at 80% 10%, rgba(11,76,117,0.7) 0%, transparent 55%),
          radial-gradient(ellipse at 50% 80%, rgba(27,108,168,0.5) 0%, transparent 60%),
          linear-gradient(160deg, #0f4c75 0%, #1b6ca8 35%, #0d7377 65%, #14a085 100%);
        background-attachment: fixed;
      }

      .page {
        width: 100%;
        max-width: 480px;
        padding: 52px 20px 40px;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      /* ── HEADER ── */
      .header {
        text-align: center;
        margin-bottom: 36px;
        animation: fadeUp 0.5s ease both;
      }

      .logo-wrap {
        width: 96px;
        height: 96px;
        border-radius: 50%;
        border: 2px solid rgba(255,255,255,0.4);
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(8px);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 18px;
        overflow: hidden;
        box-shadow: 0 4px 24px rgba(0,0,0,0.2);
      }

      .logo-wrap img {
        width: 88px;
        height: 88px;
        object-fit: contain;
        border-radius: 50%;
      }

      .brand-name {
        font-family: 'Cormorant Garamond', serif;
        font-size: 26px;
        font-weight: 600;
        letter-spacing: 0.02em;
        margin-bottom: 5px;
        text-shadow: 0 1px 8px rgba(0,0,0,0.25);
      }

      .brand-sub {
        font-size: 11px;
        font-weight: 400;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.75);
        margin-bottom: 8px;
      }

      .brand-desc {
        font-size: 13px;
        color: rgba(255,255,255,0.72);
        font-weight: 300;
        line-height: 1.6;
      }

      /* ── LINKS ── */
      .links {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 14px;
      }

      .link-card {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 15px 18px;
        background: var(--card-bg);
        border: 1.5px solid var(--card-border);
        border-radius: 14px;
        text-decoration: none;
        color: var(--text);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        transition: background 0.2s, border-color 0.2s, transform 0.2s, box-shadow 0.2s;
        animation: fadeUp 0.5s ease both;
        cursor: pointer;
      }

      .link-card:hover, .link-card:active {
        background: var(--card-hover-bg);
        border-color: rgba(255,255,255,0.55);
        transform: translateY(-2px);
        box-shadow: 0 8px 28px rgba(0,0,0,0.18);
      }

      .link-card:nth-child(1) { animation-delay: 0.12s; }
      .link-card:nth-child(2) { animation-delay: 0.20s; }
      .link-card:nth-child(3) { animation-delay: 0.28s; }
      .link-card:nth-child(4) { animation-delay: 0.36s; }

      .link-emoji {
        font-size: 22px;
        flex-shrink: 0;
        width: 36px;
        text-align: center;
      }

      .link-text { flex: 1; }
      .link-title { font-size: 15px; font-weight: 500; line-height: 1.3; }
      .link-hint { font-size: 12px; color: rgba(255,255,255,0.65); font-weight: 300; margin-top: 2px; }

      .link-arrow {
        font-size: 20px;
        color: rgba(255,255,255,0.5);
        transition: transform 0.2s, color 0.2s;
        flex-shrink: 0;
      }
      .link-card:hover .link-arrow { transform: translateX(3px); color: rgba(255,255,255,0.9); }

      /* WhatsApp accent */
      .wa-card {
        background: rgba(37,211,102,0.18);
        border-color: rgba(37,211,102,0.45);
      }
      .wa-card:hover {
        background: rgba(37,211,102,0.28);
        border-color: rgba(37,211,102,0.7);
      }

      /* ── QR SECTION ── */
      .qr-section {
        margin-top: 32px;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        animation: fadeUp 0.5s 0.44s ease both;
      }

      .qr-label {
        font-size: 11px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.65);
        margin-bottom: 14px;
        font-weight: 400;
      }

      .qr-frame {
        background: rgba(255,255,255,0.14);
        border: 1.5px solid rgba(255,255,255,0.3);
        border-radius: 18px;
        padding: 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
      }

      .qr-inner {
        background: #fff;
        border-radius: 10px;
        padding: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      #qr-placeholder {
        width: 150px;
        height: 150px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: rgba(255,255,255,0.5);
        font-size: 12px;
      }

      .qr-url {
        font-family: 'Cormorant Garamond', serif;
        font-size: 14px;
        color: rgba(255,255,255,0.85);
        letter-spacing: 0.04em;
      }

      /* ── FOOTER ── */
      .footer {
        margin-top: 32px;
        text-align: center;
        font-size: 11px;
        color: rgba(255,255,255,0.45);
        font-weight: 300;
        animation: fadeUp 0.5s 0.55s ease both;
      }

      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      @media (max-width: 420px) {
        .page { padding: 40px 16px 40px; }
        .brand-name { font-size: 22px; }
      }
    </style>
  </head>
  <body>
    <div class="page">

      <header class="header">
        <div class="logo-wrap">
          <img src="../assets/images/gallery/SICB logo.webp" alt="Stay in Costa Blanca logo" />
        </div>
        <div class="brand-name">Stay in Costa Blanca</div>
        <div class="brand-sub">Property Management</div>
        <p class="brand-desc">High-tech &amp; scientific property care<br/>Orihuela Costa &amp; Torrevieja</p>
      </header>

      <nav class="links" aria-label="Quick links">

        <a href="/request-inspection" class="link-card">
          <div class="link-emoji">📋</div>
          <div class="link-text">
            <div class="link-title">Request a Property Inspection</div>
            <div class="link-hint">Book your digital control checkup</div>
          </div>
          <span class="link-arrow" aria-hidden="true">›</span>
        </a>

        <a href="/services" class="link-card">
          <div class="link-emoji">🛡️</div>
          <div class="link-text">
            <div class="link-title">Our Management Packages</div>
            <div class="link-hint">Standard, Optimum &amp; Prestige plans</div>
          </div>
          <span class="link-arrow" aria-hidden="true">›</span>
        </a>

        <a href="/emergency" class="link-card">
          <div class="link-emoji">🔑</div>
          <div class="link-text">
            <div class="link-title">Emergency &amp; Key Services</div>
            <div class="link-hint">On-demand call-out protocols</div>
          </div>
          <span class="link-arrow" aria-hidden="true">›</span>
        </a>

        <a href="https://wa.me/34624110656?text=Hi,%20I%20need%20more%20information%20about%20your%20property%20services." target="_blank" rel="noopener" class="link-card wa-card">
          <div class="link-emoji">💬</div>
          <div class="link-text">
            <div class="link-title">Chat Live on WhatsApp</div>
            <div class="link-hint">+34 624 110 656</div>
          </div>
          <span class="link-arrow" aria-hidden="true">›</span>
        </a>

      </nav>

      <section class="qr-section" aria-label="QR code for website">
        <p class="qr-label">Scan to visit our website</p>
        <div class="qr-frame">
          <div class="qr-inner">
            <div id="qr-placeholder"></div>
          </div>
          <div class="qr-url">stayincostablanca.com</div>
        </div>
      </section>

      <footer class="footer">
        <p>© 2025 Stay in Costa Blanca &nbsp;·&nbsp; Costa Blanca, España</p>
      </footer>

    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
      (function() {
        function initQR() {
          var placeholder = document.getElementById('qr-placeholder');
          if (!placeholder || typeof QRCode === 'undefined') {
            setTimeout(initQR, 100);
            return;
          }
          placeholder.innerHTML = '';
          placeholder.style.width = 'auto';
          placeholder.style.height = 'auto';
          new QRCode(placeholder, {
            text: 'https://www.stayincostablanca.com',
            width: 150,
            height: 150,
            colorDark: '#0f4c75',
            colorLight: '#ffffff',
            correctLevel: QRCode.CorrectLevel.H
          });
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initQR);
        } else {
          initQR();
        }
      })();
    </script>

  </body>
</html>
