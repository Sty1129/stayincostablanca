---
const pageTitle = "Stay in Costa Blanca";
const phone = "+34 624 110 656";
const siteUrl = "https://www.stayincostablanca.com";
const whatsAppUrl = `https://wa.me/34624110656?text=Hi,%20I%20need%20more%20information%20about%20your%20property%20services.`;
const qrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=${encodeURIComponent(siteUrl)}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />

    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --text: #ffffff;
        --muted: rgba(255,255,255,0.74);
        --card: rgba(255,255,255,0.16);
        --card-border: rgba(255,255,255,0.34);
        --card-hover: rgba(255,255,255,0.26);
        --wa: #25d366;
        --blue: #0f4c75;
      }

      body {
        min-height: 100vh;
        font-family: 'DM Sans', sans-serif;
        color: var(--text);
        display: flex;
        justify-content: center;
        background:
          radial-gradient(circle at top left, rgba(20,160,133,0.55), transparent 34%),
          radial-gradient(circle at top right, rgba(15,76,117,0.78), transparent 38%),
          linear-gradient(160deg, #0f4c75 0%, #1b6ca8 38%, #0d7377 72%, #14a085 100%);
        background-attachment: fixed;
        padding: 32px 14px;
      }

      .page {
        width: 100%;
        max-width: 460px;
      }

      .tap-card {
        width: 100%;
        padding: 26px 18px 22px;
        border: 1.5px solid rgba(255,255,255,0.38);
        border-radius: 28px;
        background: rgba(255,255,255,0.13);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        box-shadow: 0 24px 70px rgba(0,0,0,0.22);
      }

      .header {
        text-align: center;
        margin-bottom: 22px;
      }

      .logo-wrap {
        width: 118px;
        height: 118px;
        border-radius: 30px;
        margin: 0 auto 16px;
        padding: 10px;
        background: rgba(255,255,255,0.92);
        border: 1px solid rgba(255,255,255,0.75);
        box-shadow: 0 14px 38px rgba(0,0,0,0.22);
      }

      .logo-wrap img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
      }

      .brand-box {
        border: 1px solid rgba(255,255,255,0.34);
        background: rgba(255,255,255,0.10);
        border-radius: 22px;
        padding: 16px 14px;
      }

      .brand-name {
        font-family: 'Cormorant Garamond', serif;
        font-size: 31px;
        font-weight: 600;
        line-height: 1.05;
        margin-bottom: 6px;
      }

      .brand-sub {
        font-size: 11px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.78);
        margin-bottom: 10px;
      }

      .brand-desc {
        font-size: 13px;
        line-height: 1.55;
        color: var(--muted);
      }

      .links {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-top: 20px;
      }

      .link-card {
        display: flex;
        align-items: center;
        gap: 13px;
        width: 100%;
        padding: 15px 16px;
        color: var(--text);
        text-decoration: none;
        border-radius: 18px;
        border: 1.4px solid var(--card-border);
        background: var(--card);
        box-shadow: 0 8px 24px rgba(0,0,0,0.12);
        transition: 0.2s ease;
      }

      .link-card:hover {
        transform: translateY(-2px);
        background: var(--card-hover);
        border-color: rgba(255,255,255,0.62);
      }

      .wa-card {
        background: rgba(37,211,102,0.20);
        border-color: rgba(37,211,102,0.58);
      }

      .link-emoji {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        border-radius: 12px;
        background: rgba(255,255,255,0.16);
        font-size: 19px;
        flex-shrink: 0;
      }

      .link-text { flex: 1; }
      .link-title { font-size: 15px; font-weight: 600; }
      .link-hint { font-size: 12px; margin-top: 3px; color: rgba(255,255,255,0.68); }
      .link-arrow { font-size: 23px; color: rgba(255,255,255,0.58); }

      .qr-section {
        margin-top: 24px;
        text-align: center;
      }

      .qr-label {
        font-size: 11px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.72);
        margin-bottom: 12px;
      }

      .qr-frame {
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        padding: 14px;
        border-radius: 22px;
        background: rgba(255,255,255,0.94);
        border: 1px solid rgba(255,255,255,0.75);
        box-shadow: 0 16px 40px rgba(0,0,0,0.18);
      }

      .qr-frame img {
        width: 180px;
        height: 180px;
        display: block;
      }

      .qr-url {
        color: var(--blue);
        font-size: 13px;
        font-weight: 600;
      }

      .footer {
        margin-top: 18px;
        text-align: center;
        font-size: 11px;
        color: rgba(255,255,255,0.56);
      }

      @media (max-width: 420px) {
        body { padding: 20px 12px; }
        .tap-card { border-radius: 24px; padding: 22px 14px; }
        .brand-name { font-size: 27px; }
      }
    </style>
  </head>

  <body>
    <main class="page">
      <div class="tap-card">

        <header class="header">
          <div class="logo-wrap">
            <img src="/assets/images/gallery/SICB logo.webp" alt="Stay in Costa Blanca logo" />
          </div>

          <div class="brand-box">
            <div class="brand-name">Stay in Costa Blanca</div>
            <div class="brand-sub">Property Management</div>
            <p class="brand-desc">
              High-tech &amp; scientific property care<br />
              Orihuela Costa &amp; Torrevieja
            </p>
          </div>
        </header>

        <nav class="links" aria-label="Quick links">
          <a href={whatsAppUrl} target="_blank" rel="noopener" class="link-card wa-card">
            <div class="link-emoji">💬</div>
            <div class="link-text">
              <div class="link-title">Chat Live on WhatsApp</div>
              <div class="link-hint">{phone}</div>
            </div>
            <span class="link-arrow">›</span>
          </a>

          <a href="/request-inspection" class="link-card">
            <div class="link-emoji">📋</div>
            <div class="link-text">
              <div class="link-title">Request a Property Inspection</div>
              <div class="link-hint">Book your digital control checkup</div>
            </div>
            <span class="link-arrow">›</span>
          </a>

          <a href="/services" class="link-card">
            <div class="link-emoji">🛡️</div>
            <div class="link-text">
              <div class="link-title">Our Management Packages</div>
              <div class="link-hint">Standard, Optimum &amp; Prestige plans</div>
            </div>
            <span class="link-arrow">›</span>
          </a>

          <a href="/emergency" class="link-card">
            <div class="link-emoji">🔑</div>
            <div class="link-text">
              <div class="link-title">Emergency &amp; Key Services</div>
              <div class="link-hint">On-demand call-out protocols</div>
            </div>
            <span class="link-arrow">›</span>
          </a>
        </nav>

        <section class="qr-section" aria-label="QR code for website">
          <p class="qr-label">Scan to visit our website</p>
          <div class="qr-frame">
            <img src={qrUrl} alt="QR code for Stay in Costa Blanca website" />
            <div class="qr-url">stayincostablanca.com</div>
          </div>
        </section>

        <footer class="footer">
          © 2026 Stay in Costa Blanca · Costa Blanca, España
        </footer>

      </div>
    </main>
  </body>
</html>
