---
const pageTitle = "Stay in Costa Blanca";
const phone = "+34 624 110 656";
const siteUrl = "https://www.stayincostablanca.com";
const whatsAppUrl = `https://wa.me/34624110656?text=Hi,%20I%20would%20like%20a%20free%20property%20assessment%20for%20my%20property%20in%20Costa%20Blanca.`;
const qrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=190x190&data=${encodeURIComponent(siteUrl)}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --navy: #0D2D52;
        --navy-2: #123A66;
        --gold: #C8A05A;
        --ivory: #F8F5EF;
        --sand: #EDE5D8;
        --white: #ffffff;
        --muted: rgba(13,45,82,0.68);
      }

      body {
        min-height: 100vh;
        font-family: 'DM Sans', sans-serif;
        color: var(--navy);
        display: flex;
        justify-content: center;
        padding: 28px 14px;
        background:
          radial-gradient(circle at top left, rgba(200,160,90,0.30), transparent 34%),
          radial-gradient(circle at top right, rgba(13,45,82,0.22), transparent 38%),
          linear-gradient(160deg, var(--ivory) 0%, var(--sand) 100%);
      }

      .page {
        width: 100%;
        max-width: 460px;
      }

      .card {
        width: 100%;
        padding: 28px 18px 24px;
        border-radius: 30px;
        background: rgba(255,255,255,0.74);
        border: 1.5px solid rgba(200,160,90,0.42);
        box-shadow: 0 24px 70px rgba(13,45,82,0.18);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
      }

      .header {
        text-align: center;
        margin-bottom: 22px;
      }

      .logo-wrap {
        width: 148px;
        margin: 0 auto 14px;
      }

      .logo-wrap img {
        width: 100%;
        height: auto;
        display: block;
        object-fit: contain;
        filter: drop-shadow(0 10px 20px rgba(13,45,82,0.16));
      }

      .stars {
        color: var(--gold);
        font-size: 18px;
        letter-spacing: 4px;
        margin-bottom: 12px;
      }

      .hero-box {
        border: 1.4px solid rgba(200,160,90,0.46);
        border-radius: 24px;
        padding: 18px 14px;
        background: rgba(248,245,239,0.72);
      }

      .hero-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 33px;
        font-weight: 700;
        line-height: 0.98;
        margin-bottom: 10px;
        color: var(--navy);
      }

      .hero-subtitle {
        font-size: 13px;
        line-height: 1.5;
        color: var(--muted);
        margin-bottom: 10px;
      }

      .phone {
        font-size: 14px;
        font-weight: 700;
        color: var(--navy);
      }

      .links {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-top: 20px;
      }

      .link-card {
        display: flex;
        align-items: center;
        gap: 13px;
        width: 100%;
        padding: 15px 16px;
        color: var(--navy);
        text-decoration: none;
        border-radius: 18px;
        border: 1.3px solid rgba(13,45,82,0.13);
        background: rgba(255,255,255,0.82);
        box-shadow: 0 8px 22px rgba(13,45,82,0.08);
        transition: 0.2s ease;
      }

      .link-card:hover {
        transform: translateY(-2px);
        border-color: rgba(200,160,90,0.7);
        box-shadow: 0 12px 30px rgba(13,45,82,0.13);
      }

      .primary-cta {
        background: var(--gold);
        color: var(--navy);
        border-color: rgba(13,45,82,0.12);
        box-shadow: 0 12px 30px rgba(200,160,90,0.32);
      }

      .primary-cta .link-hint {
        color: rgba(13,45,82,0.76);
      }

      .link-emoji {
        width: 36px;
        height: 36px;
        display: grid;
        place-items: center;
        border-radius: 13px;
        background: rgba(13,45,82,0.08);
        font-size: 19px;
        flex-shrink: 0;
      }

      .primary-cta .link-emoji {
        background: rgba(255,255,255,0.34);
      }

      .link-text { flex: 1; }

      .link-title {
        font-size: 14px;
        font-weight: 800;
        letter-spacing: 0.02em;
        text-transform: uppercase;
      }

      .link-hint {
        font-size: 12px;
        margin-top: 3px;
        color: var(--muted);
      }

      .link-arrow {
        font-size: 23px;
        color: rgba(13,45,82,0.45);
      }

      .trust {
        margin-top: 20px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 9px;
      }

      .trust-item {
        border-radius: 15px;
        padding: 10px 8px;
        text-align: center;
        background: rgba(13,45,82,0.06);
        border: 1px solid rgba(13,45,82,0.08);
        font-size: 12px;
        font-weight: 700;
        color: var(--navy);
      }

      .qr-section {
        margin-top: 24px;
        text-align: center;
      }

      .qr-label {
        font-size: 12px;
        font-weight: 700;
        color: var(--navy);
        margin-bottom: 12px;
      }

      .qr-frame {
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        padding: 14px;
        border-radius: 24px;
        background: var(--white);
        border: 1px solid rgba(200,160,90,0.42);
        box-shadow: 0 16px 38px rgba(13,45,82,0.13);
      }

      .qr-frame img {
        width: 190px;
        height: 190px;
        display: block;
      }

      .qr-url {
        color: var(--navy);
        font-size: 13px;
        font-weight: 800;
      }

      .footer {
        margin-top: 20px;
        text-align: center;
      }

      .footer-main {
        font-family: 'Cormorant Garamond', serif;
        font-size: 22px;
        font-weight: 700;
        color: var(--navy);
      }

      .footer-sub {
        font-size: 12px;
        color: var(--muted);
        margin-top: 3px;
      }

      @media (max-width: 420px) {
        body { padding: 18px 10px; }
        .card { border-radius: 26px; padding: 22px 14px; }
        .logo-wrap { width: 132px; }
        .hero-title { font-size: 29px; }
        .trust { grid-template-columns: 1fr 1fr; }
      }
    </style>
  </head>

  <body>
    <main class="page">
      <div class="card">

        <header class="header">
          <div class="logo-wrap">
            <img src="/sicb.png" alt="Stay in Costa Blanca logo" />
          </div>

          <div class="stars">★★★★★</div>

          <div class="hero-box">
            <h1 class="hero-title">Your Property.<br />Professionally Cared For.</h1>
            <p class="hero-subtitle">
              Premium Property Management<br />
              in Orihuela Costa &amp; Torrevieja
            </p>
            <div class="phone">📞 {phone}</div>
          </div>
        </header>

        <nav class="links" aria-label="Quick links">
          <a href={whatsAppUrl} target="_blank" rel="noopener" class="link-card primary-cta">
            <div class="link-emoji">💬</div>
            <div class="link-text">
              <div class="link-title">Free Property Assessment</div>
              <div class="link-hint">Get expert advice in WhatsApp</div>
            </div>
            <span class="link-arrow">›</span>
          </a>

          <a href="/services" class="link-card">
            <div class="link-emoji">🏠</div>
            <div class="link-text">
              <div class="link-title">Property Management Packages</div>
              <div class="link-hint">Compare Standard, Optimum &amp; Prestige</div>
            </div>
            <span class="link-arrow">›</span>
          </a>

          <a href="/request-inspection" class="link-card">
            <div class="link-emoji">📋</div>
            <div class="link-text">
              <div class="link-title">Book an Inspection</div>
              <div class="link-hint">Request a digital property check</div>
            </div>
            <span class="link-arrow">›</span>
          </a>

          <a href="/emergency" class="link-card">
            <div class="link-emoji">🔑</div>
            <div class="link-text">
              <div class="link-title">Key Holding & Emergency Support</div>
              <div class="link-hint">Fast local assistance when you need it</div>
            </div>
            <span class="link-arrow">›</span>
          </a>

          <a href={siteUrl} class="link-card">
            <div class="link-emoji">🌐</div>
            <div class="link-text">
              <div class="link-title">Visit Our Website</div>
              <div class="link-hint">Explore all services & owner resources</div>
            </div>
            <span class="link-arrow">›</span>
          </a>
        </nav>

        <section class="trust" aria-label="Trust points">
          <div class="trust-item">🛡️ Fully Insured</div>
          <div class="trust-item">📱 Digital Reports</div>
          <div class="trust-item">📍 Local Team</div>
          <div class="trust-item">⏰ Rapid Response</div>
        </section>

        <section class="qr-section" aria-label="QR code for website">
          <p class="qr-label">Scan & discover how we protect your property</p>
          <div class="qr-frame">
            <img src={qrUrl} alt="QR code for Stay in Costa Blanca website" />
            <div class="qr-url">stayincostablanca.com</div>
          </div>
        </section>

        <footer class="footer">
          <div class="footer-main">More time for you.</div>
          <div class="footer-sub">We take care of the rest.</div>
        </footer>

      </div>
    </main>
  </body>
</html>
