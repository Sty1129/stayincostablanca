
---
import { getCollection } from 'astro:content';

import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CTA from '../../../components/CTA.astro';


/* =========================================================
   POSTS — ENGLISH ONLY
========================================================= */

const posts = (
  await getCollection(
    'blog',
    ({ data }) =>
      !data.draft &&
      data.lang === 'en'
  )
).sort(
  (a, b) =>
    b.data.date.getTime() -
    a.data.date.getTime()
);


/* =========================================================
   FEATURED POST
========================================================= */

const featuredPost =
  posts.find((post) => post.data.featured === true)
  ?? posts[0]
  ?? null;


const remainingPosts =
  featuredPost
    ? posts.filter((post) => post.id !== featuredPost.id)
    : [];


/* =========================================================
   URL HELPERS

   Internal:
   en/how-to-protect-an-unoccupied-property...

   Public:
   /en/blog/how-to-protect-an-unoccupied-property...
========================================================= */

const articleSlug = (post: typeof posts[number]) =>
  post.id.replace(/^en\//, '');


const articleUrl = (post: typeof posts[number]) =>
  `/en/blog/${articleSlug(post)}`;


/* =========================================================
   DATE
========================================================= */

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });


/* =========================================================
   TAGS / CATEGORIES
========================================================= */

const categories = Array.from(
  new Set(
    posts.flatMap((post) => post.data.tags ?? [])
  )
);
---

<BaseLayout
  title="Blog | Property Owner Guides | Stay in Costa Blanca"
  description="Practical guides and resources for Costa Blanca property owners: prevention, maintenance, property management and caring for a home while you are away."
>

  <Header slot="header" />


  <!-- =====================================================
       HERO
  ====================================================== -->

  <section
    class="
      relative
      overflow-hidden
      bg-[#0E3846]
      py-16
      sm:py-20
      lg:py-24
      font-heading
    "
  >

    <div
      class="
        pointer-events-none
        absolute
        -right-24
        -top-24
        h-96
        w-96
        rounded-full
        bg-[#5B9EB5]/20
        blur-3xl
      "
    ></div>


    <div
      class="
        pointer-events-none
        absolute
        -bottom-32
        -left-24
        h-80
        w-80
        rounded-full
        bg-[#D99B26]/10
        blur-3xl
      "
    ></div>


    <div
      class="
        relative
        mx-auto
        max-w-site
        px-4
        sm:px-6
        lg:px-8
      "
    >

      <div
        class="
          mx-auto
          max-w-4xl
          text-center
        "
      >

        <p
          class="
            text-sm
            font-bold
            uppercase
            tracking-[0.18em]
            text-[#F3C76B]
          "
        >
          GUIDES &amp; RESOURCES
        </p>


        <h1
          class="
            mt-4
            text-[36px]
            sm:text-5xl
            lg:text-[56px]
            font-bold
            leading-[1.08]
            tracking-tight
            text-white
          "
        >
          Practical information for Costa Blanca property owners.
        </h1>


        <p
          class="
            mx-auto
            mt-6
            max-w-3xl
            text-base
            sm:text-lg
            leading-8
            text-[#C9DDE2]
          "
        >
          Prevention, property care, maintenance and practical guidance for
          homes that remain unoccupied for longer periods.
        </p>


        <div
          class="
            mt-7
            inline-flex
            rounded-full
            border
            border-white/15
            bg-white/5
            px-5
            py-2.5
            text-xs
            sm:text-sm
            font-semibold
            text-[#E0ECEF]
          "
        >
          Preventive · Documented · Practical
        </div>

      </div>

    </div>

  </section>


  <!-- =====================================================
       FEATURED ARTICLE
  ====================================================== -->

  {
    featuredPost && (

      <section
        class="
          bg-white
          py-16
          sm:py-20
          font-heading
        "
      >

        <div
          class="
            mx-auto
            max-w-site
            px-4
            sm:px-6
            lg:px-8
          "
        >

          <div
            class="
              mb-8
              flex
              flex-col
              sm:flex-row
              sm:items-end
              sm:justify-between
              gap-4
            "
          >

            <div>

              <p
                class="
                  text-sm
                  font-bold
                  uppercase
                  tracking-[0.17em]
                  text-[#D99B26]
                "
              >
                FEATURED ARTICLE
              </p>


              <h2
                class="
                  mt-2
                  text-[28px]
                  sm:text-3xl
                  font-bold
                  text-[#0E3846]
                "
              >
                Recommended reading
              </h2>

            </div>

          </div>


          <a
            href={articleUrl(featuredPost)}
            class="
              group
              block
              overflow-hidden
              rounded-3xl
              border
              border-[#D2E1E5]
              bg-[#F7FAFA]
              shadow-[0_10px_30px_rgba(14,56,70,0.07)]
              transition
              hover:-translate-y-1
              hover:shadow-[0_18px_38px_rgba(14,56,70,0.12)]
            "
          >

            <div
              class="
                grid
                grid-cols-1
                lg:grid-cols-[0.72fr_1.28fr]
              "
            >

              <!-- LEFT VISUAL -->

              <div
                class="
                  relative
                  flex
                  min-h-[250px]
                  sm:min-h-[300px]
                  items-center
                  justify-center
                  overflow-hidden
                  bg-[#0E3846]
                  p-8
                "
              >

                <div
                  class="
                    absolute
                    -right-16
                    -top-16
                    h-56
                    w-56
                    rounded-full
                    bg-[#5B9EB5]/25
                    blur-3xl
                  "
                ></div>


                <div
                  class="
                    absolute
                    -bottom-20
                    -left-16
                    h-52
                    w-52
                    rounded-full
                    bg-[#D99B26]/15
                    blur-3xl
                  "
                ></div>


                <div
                  class="
                    relative
                    text-center
                  "
                >

                  <div
                    class="
                      mx-auto
                      flex
                      h-16
                      w-16
                      items-center
                      justify-center
                      rounded-2xl
                      bg-white/10
                      text-[#F3C76B]
                    "
                  >

                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      class="h-8 w-8"
                      aria-hidden="true"
                    >
                      <path
                        d="M4 5.5A2.5 2.5 0 016.5 3H11v16H6.5A2.5 2.5 0 004 21.5v-16z"
                        stroke-width="1.7"
                        stroke-linejoin="round"
                      />

                      <path
                        d="M20 5.5A2.5 2.5 0 0017.5 3H13v16h4.5a2.5 2.5 0 012.5 2.5v-16z"
                        stroke-width="1.7"
                        stroke-linejoin="round"
                      />
                    </svg>

                  </div>


                  <p
                    class="
                      mt-5
                      text-xs
                      font-bold
                      uppercase
                      tracking-[0.15em]
                      text-[#F3C76B]
                    "
                  >
                    {
                      featuredPost.data.tags?.[0]
                      ?? 'Property Care'
                    }
                  </p>


                  <p
                    class="
                      mt-2
                      text-sm
                      text-[#C9DDE2]
                    "
                  >
                    Practical guide for property owners
                  </p>

                </div>

              </div>


              <!-- CONTENT -->

              <div
                class="
                  flex
                  flex-col
                  justify-center
                  p-7
                  sm:p-9
                  lg:p-11
                "
              >

                <div
                  class="
                    flex
                    flex-wrap
                    items-center
                    gap-x-4
                    gap-y-2
                    text-xs
                    font-semibold
                    uppercase
                    tracking-[0.08em]
                    text-[#758991]
                  "
                >

                  <span>
                    {formatDate(featuredPost.data.date)}
                  </span>

                  <span
                    class="
                      h-1
                      w-1
                      rounded-full
                      bg-[#D99B26]
                    "
                  ></span>

                  <span>
                    {featuredPost.data.author}
                  </span>

                </div>


                <h3
                  class="
                    mt-5
                    text-[28px]
                    sm:text-3xl
                    lg:text-[38px]
                    font-bold
                    leading-[1.15]
                    tracking-tight
                    text-[#0E3846]
                    transition
                    group-hover:text-[#397C92]
                  "
                >
                  {featuredPost.data.title}
                </h3>


                <p
                  class="
                    mt-5
                    text-base
                    sm:text-lg
                    leading-8
                    text-[#526B74]
                  "
                >
                  {featuredPost.data.description}
                </p>


                <div
                  class="
                    mt-7
                    flex
                    flex-wrap
                    gap-2
                  "
                >

                  {
                    featuredPost.data.tags?.map((tag) => (

                      <span
                        class="
                          rounded-full
                          border
                          border-[#D1E0E4]
                          bg-white
                          px-3
                          py-1.5
                          text-xs
                          font-semibold
                          text-[#526B74]
                        "
                      >
                        {tag}
                      </span>

                    ))
                  }

                </div>


                <div
                  class="
                    mt-8
                    inline-flex
                    items-center
                    gap-2
                    text-sm
                    font-bold
                    uppercase
                    tracking-[0.06em]
                    text-[#D99B26]
                  "
                >
                  Read article

                  <span
                    class="
                      text-xl
                      transition
                      group-hover:translate-x-1
                    "
                  >
                    →
                  </span>
                </div>

              </div>

            </div>

          </a>

        </div>

      </section>

    )
  }


  <!-- =====================================================
       CATEGORIES
  ====================================================== -->

  {
    categories.length > 0 && (

      <section
        class="
          border-y
          border-[#D8E4E7]
          bg-[#F7FAFA]
          py-8
          font-heading
        "
      >

        <div
          class="
            mx-auto
            max-w-site
            px-4
            sm:px-6
            lg:px-8
          "
        >

          <div
            class="
              flex
              flex-col
              md:flex-row
              md:items-center
              gap-4
            "
          >

            <p
              class="
                shrink-0
                text-xs
                font-bold
                uppercase
                tracking-[0.14em]
                text-[#0E3846]
              "
            >
              Topics
            </p>


            <div
              class="
                flex
                flex-wrap
                gap-2
              "
            >

              {
                categories.map((category) => (

                  <span
                    class="
                      rounded-full
                      border
                      border-[#C9DADF]
                      bg-white
                      px-4
                      py-2
                      text-xs
                      font-semibold
                      text-[#526B74]
                    "
                  >
                    {category}
                  </span>

                ))
              }

            </div>

          </div>

        </div>

      </section>

    )
  }


  <!-- =====================================================
       OTHER POSTS
  ====================================================== -->

  {
    remainingPosts.length > 0 && (

      <section
        class="
          bg-white
          py-16
          sm:py-20
          font-heading
        "
      >

        <div
          class="
            mx-auto
            max-w-site
            px-4
            sm:px-6
            lg:px-8
          "
        >

          <div
            class="
              mx-auto
              mb-10
              max-w-4xl
              text-center
            "
          >

            <p
              class="
                text-sm
                font-bold
                uppercase
                tracking-[0.17em]
                text-[#D99B26]
              "
            >
              MORE GUIDES
            </p>


            <h2
              class="
                mt-3
                text-[30px]
                sm:text-4xl
                font-bold
                tracking-tight
                text-[#0E3846]
              "
            >
              Resources for caring for your property.
            </h2>

          </div>


          <div
            class="
              grid
              grid-cols-1
              md:grid-cols-2
              xl:grid-cols-3
              gap-6
            "
          >

            {
              remainingPosts.map((post) => (

                <a
                  href={articleUrl(post)}
                  class="
                    group
                    flex
                    h-full
                    flex-col
                    overflow-hidden
                    rounded-2xl
                    border
                    border-[#D2E1E5]
                    bg-[#F7FAFA]
                    transition
                    hover:-translate-y-1
                    hover:shadow-[0_12px_28px_rgba(14,56,70,0.10)]
                  "
                >

                  <div
                    class="
                      border-b
                      border-[#D8E4E7]
                      bg-[#EEF6F8]
                      p-6
                    "
                  >

                    <div
                      class="
                        flex
                        items-center
                        justify-between
                        gap-4
                      "
                    >

                      <div
                        class="
                          flex
                          h-11
                          w-11
                          items-center
                          justify-center
                          rounded-xl
                          bg-white
                          text-[#0E3846]
                        "
                      >

                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          class="h-5 w-5"
                          aria-hidden="true"
                        >
                          <path
                            d="M5 4h10l4 4v12H5z"
                            stroke-width="1.7"
                            stroke-linejoin="round"
                          />

                          <path
                            d="M15 4v5h5M8 13h8M8 16h5"
                            stroke-width="1.7"
                            stroke-linecap="round"
                          />
                        </svg>

                      </div>


                      <span
                        class="
                          text-xs
                          font-bold
                          uppercase
                          tracking-[0.1em]
                          text-[#D99B26]
                        "
                      >
                        {
                          post.data.tags?.[0]
                          ?? 'Guide'
                        }
                      </span>

                    </div>

                  </div>


                  <div
                    class="
                      flex
                      flex-1
                      flex-col
                      p-6
                    "
                  >

                    <p
                      class="
                        text-xs
                        font-semibold
                        text-[#7B8D94]
                      "
                    >
                      {formatDate(post.data.date)}
                    </p>


                    <h3
                      class="
                        mt-3
                        text-xl
                        font-bold
                        leading-snug
                        text-[#0E3846]
                        transition
                        group-hover:text-[#397C92]
                      "
                    >
                      {post.data.title}
                    </h3>


                    <p
                      class="
                        mt-3
                        flex-1
                        text-sm
                        leading-6
                        text-[#526B74]
                      "
                    >
                      {post.data.description}
                    </p>


                    <div
                      class="
                        mt-6
                        flex
                        items-center
                        justify-between
                        gap-4
                      "
                    >

                      <span
                        class="
                          text-xs
                          font-semibold
                          text-[#758991]
                        "
                      >
                        {post.data.author}
                      </span>


                      <span
                        class="
                          text-lg
                          font-bold
                          text-[#D99B26]
                          transition
                          group-hover:translate-x-1
                        "
                      >
                        →
                      </span>

                    </div>

                  </div>

                </a>

              ))
            }

          </div>

        </div>

      </section>

    )
  }


  <!-- =====================================================
       EMPTY STATE
  ====================================================== -->

  {
    posts.length === 0 && (

      <section
        class="
          bg-white
          py-20
          font-heading
        "
      >

        <div
          class="
            mx-auto
            max-w-2xl
            px-4
            text-center
          "
        >

          <h2
            class="
              text-3xl
              font-bold
              text-[#0E3846]
            "
          >
            Our first guides are coming soon.
          </h2>


          <p
            class="
              mt-4
              text-base
              leading-7
              text-[#526B74]
            "
          >
            Here you will find practical information about caring for and
            protecting properties in Costa Blanca.
          </p>

        </div>

      </section>

    )
  }


  <!-- =====================================================
       CTA
  ====================================================== -->

  <CTA />


  <Footer slot="footer" />

</BaseLayout>
