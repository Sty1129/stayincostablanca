---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTA from '../../components/CTA.astro';
import { getCollection } from 'astro:content';
import { brand } from '../../config/brand';


/* =========================================================
   LANGUAGE
========================================================= */

const currentLang = Astro.currentLocale || 'ro';

const lang =
  currentLang === 'en' || currentLang === 'es'
    ? currentLang
    : 'ro';


/* =========================================================
   TRANSLATIONS
========================================================= */

const translations = {

  /* =======================================================
     ROMÂNĂ
  ======================================================= */

  ro: {
    seoTitle:
      `Blog | Ghiduri pentru proprietari | ${brand.name}`,

    seoDescription:
      'Ghiduri practice despre Key Holding, întreținerea proprietății, prevenție, umiditate, consum de apă și energie și administrarea proprietăților din Costa Blanca.',

    topper:
      'GHIDURI & RESURSE',

    title:
      'Informații utile pentru proprietarii din Costa Blanca.',

    intro:
      'Ghiduri practice despre protejarea unei proprietăți nelocuite, întreținere preventivă, Key Holding, umiditate, consumuri și administrare responsabilă.',

    audience:
      'Pentru proprietarii care nu locuiesc permanent în Costa Blanca.',

    categories:
      'SUBIECTE',

    featured:
      'ARTICOL RECOMANDAT',

    latest:
      'ULTIMELE ARTICOLE',

    latestTitle:
      'Ghiduri practice și informații utile.',

    latestText:
      'Publicăm articole bazate pe probleme reale pe care proprietarii le pot întâlni atunci când locuința rămâne neocupată perioade mai lungi.',

    read:
      'CITEȘTE ARTICOLUL',

    allArticles:
      'TOATE ARTICOLELE',

    emptyTitle:
      'Pregătim primele articole.',

    emptyText:
      'Vom publica în curând ghiduri practice pentru proprietarii din Costa Blanca.',

    dateLocale:
      'ro-RO',

    blogBase:
      '/blog/',
  },


  /* =======================================================
     ENGLISH
  ======================================================= */

  en: {
    seoTitle:
      `Blog | Property Owner Guides | ${brand.name}`,

    seoDescription:
      'Practical guides about Key Holding, preventive property care, humidity, water and energy monitoring and property management in Costa Blanca.',

    topper:
      'GUIDES & RESOURCES',

    title:
      'Useful information for property owners in Costa Blanca.',

    intro:
      'Practical guides about protecting an unoccupied property, preventive care, Key Holding, humidity, consumption monitoring and responsible property management.',

    audience:
      'For owners who do not live permanently in Costa Blanca.',

    categories:
      'TOPICS',

    featured:
      'FEATURED ARTICLE',

    latest:
      'LATEST ARTICLES',

    latestTitle:
      'Practical guides and useful information.',

    latestText:
      'We publish articles based on real issues property owners may face when their home is left unoccupied for longer periods.',

    read:
      'READ ARTICLE',

    allArticles:
      'ALL ARTICLES',

    emptyTitle:
      'Our first articles are coming soon.',

    emptyText:
      'We will soon publish practical guides for property owners in Costa Blanca.',

    dateLocale:
      'en-GB',

    blogBase:
      '/en/blog/',
  },


  /* =======================================================
     ESPAÑOL
  ======================================================= */

  es: {
    seoTitle:
      `Blog | Guías para propietarios | ${brand.name}`,

    seoDescription:
      'Guías prácticas sobre Key Holding, mantenimiento preventivo, humedad, consumo de agua y energía y gestión de propiedades en Costa Blanca.',

    topper:
      'GUÍAS & RECURSOS',

    title:
      'Información útil para propietarios en Costa Blanca.',

    intro:
      'Guías prácticas sobre cómo proteger una propiedad desocupada, mantenimiento preventivo, Key Holding, humedad, consumos y gestión responsable.',

    audience:
      'Para propietarios que no viven permanentemente en Costa Blanca.',

    categories:
      'TEMAS',

    featured:
      'ARTÍCULO DESTACADO',

    latest:
      'ÚLTIMOS ARTÍCULOS',

    latestTitle:
      'Guías prácticas e información útil.',

    latestText:
      'Publicamos artículos basados en problemas reales que pueden surgir cuando una propiedad permanece desocupada durante largos periodos.',

    read:
      'LEER ARTÍCULO',

    allArticles:
      'TODOS LOS ARTÍCULOS',

    emptyTitle:
      'Estamos preparando los primeros artículos.',

    emptyText:
      'Muy pronto publicaremos guías prácticas para propietarios en Costa Blanca.',

    dateLocale:
      'es-ES',

    blogBase:
      '/es/blog/',
  },
};

const t = translations[lang];


/* =========================================================
   POSTS
========================================================= */

const posts = (
  await getCollection(
    'blog',
    ({ data }) => !data.draft
  )
).sort(
  (a, b) =>
    b.data.date.valueOf() -
    a.data.date.valueOf()
);


/* =========================================================
   FEATURED + REST
========================================================= */

const featuredPost =
  posts.find((post) => post.data.featured === true)
  ?? posts[0]
  ?? null;

const remainingPosts =
  featuredPost
    ? posts.filter((post) => post.id !== featuredPost.id)
    : [];


/* =========================================================
   CATEGORIES
========================================================= */

const categories =
  Array.from(
    new Set(
      posts.flatMap(
        (post) => post.data.tags || []
      )
    )
  ).slice(0, 6);


/* =========================================================
   HELPERS
========================================================= */

const formatDate = (date: Date) =>
  date.toLocaleDateString(
    t.dateLocale,
    {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }
  );

const articleUrl = (id: string) =>
  `${t.blogBase}${id}`;
---

<BaseLayout
  title={t.seoTitle}
  description={t.seoDescription}
>

  <Header slot="header" />


  <!-- =====================================================
       BLOG HERO
  ====================================================== -->

  <section
    class="
      relative
      overflow-hidden
      border-b
      border-[#D7E2E5]
      bg-[#F7FAFA]
      py-14
      sm:py-16
      lg:py-20
      font-heading
    "
  >

    <!-- DECORATIVE BACKGROUND -->

    <div
      class="
        pointer-events-none
        absolute
        -right-24
        -top-24
        h-80
        w-80
        rounded-full
        bg-[#5B9EB5]/10
        blur-3xl
      "
    ></div>

    <div
      class="
        pointer-events-none
        absolute
        -bottom-32
        -left-20
        h-72
        w-72
        rounded-full
        bg-[#D99B26]/10
        blur-3xl
      "
    ></div>


    <div
      class="
        relative
        mx-auto
        max-w-site
        px-4
        sm:px-6
        lg:px-8
      "
    >

      <div
        class="
          mx-auto
          max-w-4xl
          text-center
        "
      >

        <p
          class="
            text-sm
            font-bold
            uppercase
            tracking-[0.18em]
            text-[#D99B26]
          "
        >
          {t.topper}
        </p>


        <h1
          class="
            mt-4
            text-[36px]
            font-bold
            leading-[1.08]
            tracking-tight
            text-[#0E3846]
            sm:text-5xl
            lg:text-[54px]
          "
        >
          {t.title}
        </h1>


        <p
          class="
            mx-auto
            mt-6
            max-w-3xl
            text-base
            leading-8
            text-[#526B74]
            sm:text-lg
          "
        >
          {t.intro}
        </p>


        <div
          class="
            mt-7
            inline-flex
            items-center
            gap-2
            rounded-full
            border
            border-[#CFE0E4]
            bg-white
            px-5
            py-2.5
            text-sm
            font-semibold
            text-[#0E3846]
            shadow-sm
          "
        >

          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            class="h-4 w-4 text-[#D99B26]"
            aria-hidden="true"
          >
            <path
              d="M12 21s7-5.1 7-11a7 7 0 10-14 0c0 5.9 7 11 7 11z"
              stroke-width="1.7"
            />

            <circle
              cx="12"
              cy="10"
              r="2.3"
              stroke-width="1.7"
            />
          </svg>

          {t.audience}

        </div>

      </div>


      <!-- =================================================
           CATEGORIES / TAGS
      ================================================== -->

      {
        categories.length > 0 && (

          <div
            class="
              mt-10
              flex
              flex-col
              items-center
              gap-4
            "
          >

            <p
              class="
                text-[11px]
                font-bold
                uppercase
                tracking-[0.16em]
                text-[#82969D]
              "
            >
              {t.categories}
            </p>


            <div
              class="
                flex
                flex-wrap
                justify-center
                gap-2.5
              "
            >

              {categories.map((category) => (

                <span
                  class="
                    rounded-full
                    border
                    border-[#CBDDE1]
                    bg-white
                    px-4
                    py-2
                    text-xs
                    font-semibold
                    text-[#405963]
                  "
                >
                  {category}
                </span>

              ))}

            </div>

          </div>

        )
      }

    </div>

  </section>


  <!-- =====================================================
       CONTENT
  ====================================================== -->

  {
    posts.length === 0 ? (

      <!-- =================================================
           EMPTY STATE
      ================================================== -->

      <section
        class="
          bg-white
          py-20
          sm:py-24
          font-heading
        "
      >

        <div
          class="
            mx-auto
            max-w-2xl
            px-4
            text-center
            sm:px-6
          "
        >

          <div
            class="
              mx-auto
              flex
              h-16
              w-16
              items-center
              justify-center
              rounded-full
              bg-[#E8F3F5]
              text-[#0E3846]
            "
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              class="h-8 w-8"
              aria-hidden="true"
            >
              <path
                d="M5 4h10l4 4v12H5z"
                stroke-width="1.7"
                stroke-linejoin="round"
              />

              <path
                d="M15 4v5h5M8 13h8M8 16h6"
                stroke-width="1.7"
                stroke-linecap="round"
              />
            </svg>
          </div>


          <h2
            class="
              mt-6
              text-3xl
              font-bold
              text-[#0E3846]
            "
          >
            {t.emptyTitle}
          </h2>


          <p
            class="
              mt-4
              text-base
              leading-7
              text-[#526B74]
            "
          >
            {t.emptyText}
          </p>

        </div>

      </section>

    ) : (

      <>


        <!-- =================================================
             FEATURED ARTICLE
        ================================================== -->

        <section
          class="
            bg-white
            py-16
            sm:py-20
            font-heading
          "
        >

          <div
            class="
              mx-auto
              max-w-site
              px-4
              sm:px-6
              lg:px-8
            "
          >

            <p
              class="
                text-sm
                font-bold
                uppercase
                tracking-[0.17em]
                text-[#D99B26]
              "
            >
              {t.featured}
            </p>


            {
              featuredPost && (

                <article
                  class="
                    group
                    relative
                    mt-6
                    grid
                    overflow-hidden
                    rounded-3xl
                    border
                    border-[#D1E0E4]
                    bg-[#F7FAFA]
                    shadow-[0_12px_36px_rgba(14,56,70,0.08)]
                    lg:grid-cols-[0.82fr_1.18fr]
                  "
                >

                  <!-- VISUAL -->

                  <div
                    class="
                      relative
                      flex
                      min-h-[280px]
                      items-center
                      justify-center
                      overflow-hidden
                      bg-[#0E3846]
                      p-8
                      sm:min-h-[320px]
                      lg:min-h-[420px]
                    "
                  >

                    <div
                      class="
                        absolute
                        -right-16
                        -top-16
                        h-64
                        w-64
                        rounded-full
                        bg-[#5B9EB5]/25
                        blur-3xl
                      "
                    ></div>

                    <div
                      class="
                        absolute
                        -bottom-16
                        -left-16
                        h-56
                        w-56
                        rounded-full
                        bg-[#D99B26]/20
                        blur-3xl
                      "
                    ></div>


                    <!-- DOCUMENT / HOUSE ICON -->

                    <div
                      class="
                        relative
                        flex
                        h-32
                        w-32
                        items-center
                        justify-center
                        rounded-3xl
                        border
                        border-white/15
                        bg-white/10
                        text-[#F3C76B]
                        shadow-2xl
                        backdrop-blur
                      "
                    >

                      <svg
                        viewBox="0 0 64 64"
                        fill="none"
                        stroke="currentColor"
                        class="h-20 w-20"
                        aria-hidden="true"
                      >
                        <path
                          d="M12 29L32 13l20 16v23H12z"
                          stroke-width="2.3"
                          stroke-linejoin="round"
                        />

                        <path
                          d="M25 52V37h14v15"
                          stroke-width="2.3"
                          stroke-linejoin="round"
                        />

                        <path
                          d="M20 24v-8h8"
                          stroke-width="2.3"
                          stroke-linejoin="round"
                        />

                        <circle
                          cx="46"
                          cy="18"
                          r="8"
                          fill="#0E3846"
                          stroke-width="2.3"
                        />

                        <path
                          d="M42.5 18l2.3 2.3 4-4.5"
                          stroke-width="2.3"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>

                    </div>

                  </div>


                  <!-- CONTENT -->

                  <div
                    class="
                      flex
                      flex-col
                      justify-center
                      p-7
                      sm:p-9
                      lg:p-12
                    "
                  >

                    <div
                      class="
                        flex
                        flex-wrap
                        items-center
                        gap-2.5
                        text-xs
                        font-semibold
                        text-[#6F858D]
                      "
                    >

                      <time
                        datetime={featuredPost.data.date.toISOString()}
                      >
                        {formatDate(featuredPost.data.date)}
                      </time>


                      {
                        featuredPost.data.tags.length > 0 && (
                          <>
                            <span
                              class="
                                h-1
                                w-1
                                rounded-full
                                bg-[#D99B26]
                              "
                            ></span>

                            <span
                              class="
                                rounded-full
                                bg-[#E7F2F5]
                                px-3
                                py-1
                                text-[#0E3846]
                              "
                            >
                              {featuredPost.data.tags[0]}
                            </span>
                          </>
                        )
                      }

                    </div>


                    <h2
                      class="
                        mt-5
                        text-[28px]
                        font-bold
                        leading-[1.18]
                        tracking-tight
                        text-[#0E3846]
                        transition-colors
                        group-hover:text-[#397C92]
                        sm:text-4xl
                      "
                    >
                      {featuredPost.data.title}
                    </h2>


                    <p
                      class="
                        mt-5
                        text-base
                        leading-8
                        text-[#526B74]
                        sm:text-lg
                      "
                    >
                      {featuredPost.data.description}
                    </p>


                    <a
                      href={articleUrl(featuredPost.id)}
                      class="
                        mt-7
                        inline-flex
                        w-fit
                        items-center
                        gap-2.5
                        rounded-xl
                        bg-[#0E3846]
                        px-6
                        py-3.5
                        text-sm
                        font-bold
                        text-white
                        transition-all
                        duration-200
                        hover:-translate-y-0.5
                        hover:bg-[#164D5D]
                      "
                    >

                      {t.read}

                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        class="
                          h-4
                          w-4
                          transition-transform
                          group-hover:translate-x-1
                        "
                        aria-hidden="true"
                      >
                        <path
                          d="M5 12h14m-5-5l5 5-5 5"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>

                    </a>

                  </div>

                </article>

              )
            }

          </div>

        </section>


        <!-- =================================================
             LATEST ARTICLES
        ================================================== -->

        {
          remainingPosts.length > 0 && (

            <section
              class="
                bg-[#F7FAFA]
                py-16
                sm:py-20
                font-heading
              "
            >

              <div
                class="
                  mx-auto
                  max-w-site
                  px-4
                  sm:px-6
                  lg:px-8
                "
              >

                <!-- SECTION HEADING -->

                <div
                  class="
                    mx-auto
                    max-w-4xl
                    text-center
                  "
                >

                  <p
                    class="
                      text-sm
                      font-bold
                      uppercase
                      tracking-[0.17em]
                      text-[#D99B26]
                    "
                  >
                    {t.latest}
                  </p>


                  <h2
                    class="
                      mt-3
                      text-[30px]
                      font-bold
                      tracking-tight
                      text-[#0E3846]
                      sm:text-4xl
                    "
                  >
                    {t.latestTitle}
                  </h2>


                  <p
                    class="
                      mx-auto
                      mt-4
                      max-w-3xl
                      text-base
                      leading-7
                      text-[#526B74]
                      sm:text-lg
                    "
                  >
                    {t.latestText}
                  </p>

                </div>


                <!-- GRID -->

                <div
                  class="
                    mt-10
                    grid
                    grid-cols-1
                    gap-6
                    md:grid-cols-2
                    lg:grid-cols-3
                  "
                >

                  {
                    remainingPosts.map((post) => (

                      <article
                        class="
                          group
                          relative
                          flex
                          min-h-full
                          flex-col
                          overflow-hidden
                          rounded-2xl
                          border
                          border-[#D2E1E5]
                          bg-white
                          shadow-[0_6px_20px_rgba(14,56,70,0.06)]
                          transition-all
                          duration-200
                          hover:-translate-y-1
                          hover:shadow-[0_14px_32px_rgba(14,56,70,0.10)]
                        "
                      >

                        <!-- CARD TOP -->

                        <div
                          class="
                            h-2
                            w-full
                            bg-gradient-to-r
                            from-[#D99B26]
                            via-[#5B9EB5]
                            to-[#0E3846]
                          "
                        ></div>


                        <div
                          class="
                            flex
                            flex-1
                            flex-col
                            p-6
                            sm:p-7
                          "
                        >

                          <!-- META -->

                          <div
                            class="
                              flex
                              flex-wrap
                              items-center
                              gap-2
                              text-xs
                              font-semibold
                              text-[#82969D]
                            "
                          >

                            <time
                              datetime={post.data.date.toISOString()}
                            >
                              {formatDate(post.data.date)}
                            </time>


                            {
                              post.data.tags.length > 0 && (
                                <>
                                  <span
                                    class="
                                      h-1
                                      w-1
                                      rounded-full
                                      bg-[#D99B26]
                                    "
                                  ></span>

                                  <span
                                    class="
                                      text-[#397C92]
                                    "
                                  >
                                    {post.data.tags[0]}
                                  </span>
                                </>
                              )
                            }

                          </div>


                          <!-- TITLE -->

                          <h3
                            class="
                              mt-4
                              text-xl
                              font-bold
                              leading-snug
                              text-[#0E3846]
                              transition-colors
                              group-hover:text-[#397C92]
                              sm:text-[22px]
                            "
                          >
                            {post.data.title}
                          </h3>


                          <!-- DESCRIPTION -->

                          <p
                            class="
                              mt-3
                              flex-1
                              text-[15px]
                              leading-7
                              text-[#526B74]
                            "
                          >
                            {post.data.description}
                          </p>


                          <!-- READ MORE -->

                          <a
                            href={articleUrl(post.id)}
                            class="
                              mt-6
                              inline-flex
                              items-center
                              gap-2
                              text-sm
                              font-bold
                              text-[#0E3846]
                            "
                          >

                            {t.read}

                            <svg
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              class="
                                h-4
                                w-4
                                transition-transform
                                group-hover:translate-x-1
                              "
                              aria-hidden="true"
                            >
                              <path
                                d="M5 12h14m-5-5l5 5-5 5"
                                stroke-width="1.8"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>

                          </a>

                        </div>

                      </article>

                    ))
                  }

                </div>

              </div>

            </section>

          )
        }

      </>

    )
  }


  <!-- =====================================================
       CTA
  ====================================================== -->

  <CTA />


  <Footer slot="footer" />

</BaseLayout>
