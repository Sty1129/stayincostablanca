const t = translations[lang];

const whatsappUrl =
  `https://wa.me/34624110656?text=${encodeURIComponent(t.whatsappMessage)}`;
---

<BaseLayout
  title={t.seoTitle}
  description={t.seoDescription}
>

  <Header slot="header" />


  <!-- =====================================================
       PAGE INTRO
  ====================================================== -->

  <section
    class="
      bg-[#F7FAFA]
      border-b
      border-[#D8E1E5]
      font-heading
      py-14
      sm:py-16
      lg:py-20
    "
  >

    <div
      class="
        mx-auto
        max-w-site
        px-4
        sm:px-6
        lg:px-8
      "
    >

      <div
        class="
          mx-auto
          max-w-4xl
          text-center
        "
      >

        <p
          class="
            text-sm
            font-bold
            uppercase
            tracking-[0.18em]
            text-[#D99B26]
          "
        >
          {t.topper}
        </p>


        <h1
          class="
            mt-3

            text-[36px]
            sm:text-5xl
            lg:text-[56px]

            font-bold
            tracking-tight
            leading-[1.08]

            text-[#0E3846]
          "
        >
          {t.title}
        </h1>


        <p
          class="
            mt-6

            mx-auto
            max-w-3xl

            text-base
            sm:text-lg

            leading-8

            text-[#526B74]
          "
        >
          {t.intro}
        </p>

      </div>

    </div>

  </section>


  <!-- =====================================================
       CONTACT CONTENT
  ====================================================== -->

  <section
    class="
      bg-white
      py-14
      sm:py-16
      lg:py-20
      font-heading
    "
  >

    <div
      class="
        mx-auto
        max-w-site
        px-4
        sm:px-6
        lg:px-8
      "
    >

      <div
        class="
          grid
          grid-cols-1
          lg:grid-cols-[1.15fr_0.85fr]

          gap-10
          lg:gap-12
          xl:gap-16

          items-start
        "
      >

        <!-- =================================================
             LEFT — FORM
        ================================================== -->

        <div>

          <p
            class="
              text-xs
              font-bold
              uppercase
              tracking-[0.16em]
              text-[#D99B26]
            "
          >
            {t.formTopper}
          </p>


          <h2
            class="
              mt-3
              text-[30px]
              sm:text-4xl
              font-bold
              tracking-tight
              text-[#0E3846]
            "
          >
            {t.formTitle}
          </h2>


          <p
            class="
              mt-3
              mb-8
              max-w-2xl
              text-base
              leading-7
              text-[#526B74]
            "
          >
            {t.formText}
          </p>


          <!-- FORM -->

          <form
            id="contact-form"

            class="
              flex
              flex-col
              gap-5
            "

            data-success-url={r.success}
            data-default-label={t.submit}
            data-sending-label={t.sending}
            data-error-message={t.error}
            data-network-message={t.networkError}
          >

            <!-- LANGUAGE INFO -->

            <input
              type="hidden"
              name="language"
              value={lang}
            />

            <input
              type="hidden"
              name="source"
              value="Stay in Costa Blanca website contact form"
            />


            <!-- NAME + EMAIL -->

            <div
              class="
                grid
                grid-cols-1
                sm:grid-cols-2
                gap-5
              "
            >

              <label
                class="
                  flex
                  flex-col
                  gap-2
                "
              >

                <span
                  class="
                    text-sm
                    font-semibold
                    text-[#294A55]
                  "
                >
                  {t.name}
                </span>

                <input
                  type="text"
                  name="name"
                  required
                  autocomplete="name"
                  placeholder={t.namePlaceholder}

                  class="
                    min-h-[52px]
                    rounded-xl

                    border
                    border-[#CBDCE1]

                    bg-[#F9FBFB]

                    px-4
                    py-3

                    text-base
                    text-[#0E3846]

                    outline-none

                    transition

                    placeholder:text-[#91A2A8]

                    focus:border-[#5B9EB5]
                    focus:bg-white
                    focus:ring-2
                    focus:ring-[#5B9EB5]/15
                  "
                />

              </label>


              <label
                class="
                  flex
                  flex-col
                  gap-2
                "
              >

                <span
                  class="
                    text-sm
                    font-semibold
                    text-[#294A55]
                  "
                >
                  {t.email}
                </span>

                <input
                  type="email"
                  name="email"
                  required
                  autocomplete="email"
                  placeholder={t.emailPlaceholder}

                  class="
                    min-h-[52px]
                    rounded-xl

                    border
                    border-[#CBDCE1]

                    bg-[#F9FBFB]

                    px-4
                    py-3

                    text-base
                    text-[#0E3846]

                    outline-none

                    transition

                    placeholder:text-[#91A2A8]

                    focus:border-[#5B9EB5]
                    focus:bg-white
                    focus:ring-2
                    focus:ring-[#5B9EB5]/15
                  "
                />

              </label>

            </div>


            <!-- PHONE + AREA -->

            <div
              class="
                grid
                grid-cols-1
                sm:grid-cols-2
                gap-5
              "
            >

              <label
                class="
                  flex
                  flex-col
                  gap-2
                "
              >

                <span
                  class="
                    text-sm
                    font-semibold
                    text-[#294A55]
                  "
                >
                  {t.phone}
                </span>

                <input
                  type="tel"
                  name="phone"
                  autocomplete="tel"
                  placeholder={t.phonePlaceholder}

                  class="
                    min-h-[52px]
                    rounded-xl

                    border
                    border-[#CBDCE1]

                    bg-[#F9FBFB]

                    px-4
                    py-3

                    text-base
                    text-[#0E3846]

                    outline-none

                    transition

                    placeholder:text-[#91A2A8]

                    focus:border-[#5B9EB5]
                    focus:bg-white
                    focus:ring-2
                    focus:ring-[#5B9EB5]/15
                  "
                />

              </label>


              <label
                class="
                  flex
                  flex-col
                  gap-2
                "
              >

                <span
                  class="
                    text-sm
                    font-semibold
                    text-[#294A55]
                  "
                >
                  {t.area}
                </span>

                <input
                  type="text"
                  name="property_area"
                  placeholder={t.areaPlaceholder}

                  class="
                    min-h-[52px]
                    rounded-xl

                    border
                    border-[#CBDCE1]

                    bg-[#F9FBFB]

                    px-4
                    py-3

                    text-base
                    text-[#0E3846]

                    outline-none

                    transition

                    placeholder:text-[#91A2A8]

                    focus:border-[#5B9EB5]
                    focus:bg-white
                    focus:ring-2
                    focus:ring-[#5B9EB5]/15
                  "
                />

              </label>

            </div>


            <!-- PROPERTY TYPE -->

            <label
              class="
                flex
                flex-col
                gap-2
              "
            >

              <span
                class="
                  text-sm
                  font-semibold
                  text-[#294A55]
                "
              >
                {t.propertyType}
              </span>


              <select
                name="property_type"

                class="
                  min-h-[52px]
                  rounded-xl

                  border
                  border-[#CBDCE1]

                  bg-[#F9FBFB]

                  px-4
                  py-3

                  text-base
                  text-[#0E3846]

                  outline-none

                  transition

                  focus:border-[#5B9EB5]
                  focus:bg-white
                  focus:ring-2
                  focus:ring-[#5B9EB5]/15
                "
              >

                <option value="">
                  {t.propertyPlaceholder}
                </option>

                {
                  t.propertyOptions.map((option) => (

                    <option value={option}>
                      {option}
                    </option>

                  ))
                }

              </select>

            </label>


            <!-- MESSAGE -->

            <label
              class="
                flex
                flex-col
                gap-2
              "
            >

              <span
                class="
                  text-sm
                  font-semibold
                  text-[#294A55]
                "
              >
                {t.message}
              </span>


              <textarea
                name="message"
                rows="6"
                required
                placeholder={t.messagePlaceholder}

                class="
                  min-h-[150px]

                  resize-y

                  rounded-xl

                  border
                  border-[#CBDCE1]

                  bg-[#F9FBFB]

                  px-4
                  py-3

                  text-base
                  leading-7
                  text-[#0E3846]

                  outline-none

                  transition

                  placeholder:text-[#91A2A8]

                  focus:border-[#5B9EB5]
                  focus:bg-white
                  focus:ring-2
                  focus:ring-[#5B9EB5]/15
                "
              ></textarea>

            </label>


            <!-- SUBMIT -->

            <button
              id="submit-btn"
              type="submit"

              class="
                mt-1

                inline-flex
                min-h-[54px]

                items-center
                justify-center

                rounded-xl

                bg-[#0E3846]

                px-8
                py-3.5

                text-sm
                font-bold
                uppercase
                tracking-[0.04em]

                text-white

                shadow-[0_8px_20px_rgba(14,56,70,0.18)]

                transition-all
                duration-200

                hover:-translate-y-0.5
                hover:bg-[#164D5D]

                disabled:cursor-not-allowed
                disabled:opacity-60
              "
            >
              {t.submit}
            </button>

          </form>

        </div>


        <!-- =================================================
             RIGHT
        ================================================== -->

        <aside
          class="
            space-y-5
          "
        >

          <!-- =================================================
               WHATSAPP
          ================================================== -->

          <div
            class="
              overflow-hidden
              rounded-2xl

              border
              border-[#C8DDE1]

              bg-[#F7FAFA]

              shadow-[0_10px_28px_rgba(14,56,70,0.08)]
            "
          >

            <!-- TOP -->

            <div
              class="
                bg-[#0E3846]

                px-6
                sm:px-7

                py-6
              "
            >

              <div
                class="
                  flex
                  items-center
                  gap-3
                "
              >

                <!-- WHATSAPP BADGE -->

                <div
                  class="
                    flex
                    h-12
                    w-12
                    shrink-0
                    items-center
                    justify-center

                    rounded-full

                    bg-[#25D366]

                    text-white

                    shadow-[0_5px_14px_rgba(37,211,102,0.25)]
                  "
                >

                  <svg
                    viewBox="0 0 32 32"
                    fill="currentColor"
                    class="h-7 w-7"
                    aria-hidden="true"
                  >
                    <path
                      d="M16 3C8.83 3 3 8.55 3 15.39c0 2.41.73 4.77 2.11 6.77L3.74 29 10.9 27.1A13.55 13.55 0 0016 28.08c7.17 0 13-5.55 13-12.39C29 8.55 23.17 3 16 3zm0 22.86c-1.82 0-3.6-.47-5.16-1.36l-.37-.21-4.25 1.13.83-4.13-.24-.4a9.84 9.84 0 01-1.55-5.5C5.26 10 10.08 5.22 16 5.22S26.74 10 26.74 15.39 21.92 25.86 16 25.86zm5.9-7.84c-.32-.15-1.9-.89-2.2-.99-.29-.1-.5-.15-.71.15-.21.29-.82.99-1 1.19-.18.2-.37.22-.69.07-.32-.15-1.35-.47-2.57-1.51-.95-.8-1.59-1.78-1.78-2.08-.19-.29-.02-.45.14-.6.15-.14.32-.37.48-.55.16-.17.21-.29.32-.49.1-.2.05-.37-.03-.52-.08-.15-.71-1.63-.98-2.23-.26-.62-.52-.53-.71-.54h-.61c-.21 0-.56.07-.85.37-.29.3-1.11 1.04-1.11 2.53s1.14 2.93 1.3 3.13c.16.2 2.24 3.28 5.43 4.6.76.31 1.35.5 1.81.64.76.23 1.45.2 2 .12.61-.09 1.9-.74 2.17-1.46.27-.72.27-1.33.19-1.46-.08-.13-.29-.2-.61-.35z"
                    />
                  </svg>

                </div>


                <div>

                  <p
                    class="
                      text-[11px]
                      font-bold
                      uppercase
                      tracking-[0.16em]
                      text-[#F3C76B]
                    "
                  >
                    {t.quickTopper}
                  </p>

                  <h2
                    class="
                      mt-1
                      text-xl
                      sm:text-2xl
                      font-bold
                      leading-tight
                      text-white
                    "
                  >
                    {t.quickTitle}
                  </h2>

                </div>

              </div>

            </div>


            <!-- BODY -->

            <div
              class="
                p-6
                sm:p-7
              "
            >

              <p
                class="
                  text-base
                  leading-7
                  text-[#526B74]
                "
              >
                {t.quickText}
              </p>


              <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"

                class="
                  mt-6

                  flex
                  min-h-[56px]

                  w-full

                  items-center
                  justify-center

                  gap-3

                  rounded-xl

                  bg-[#25D366]

                  px-5
                  py-3.5

                  text-center

                  text-sm
                  font-bold
                  uppercase
                  tracking-[0.03em]

                  text-[#073B27]

                  shadow-[0_7px_18px_rgba(37,211,102,0.22)]

                  transition-all
                  duration-200

                  hover:-translate-y-0.5
                  hover:bg-[#2DE071]
                "
              >

                <svg
                  viewBox="0 0 32 32"
                  fill="currentColor"
                  class="h-5 w-5"
                  aria-hidden="true"
