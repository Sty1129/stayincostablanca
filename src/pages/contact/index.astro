<!-- =========================================================
     FORMSPREE
========================================================= -->

<script is:inline>
  const FORMSPREE_URL = "https://formspree.io/f/xjgjyjdk";

  function initForm() {

    const form = document.getElementById('contact-form');
    const btn = document.getElementById('submit-btn');

    if (!form || !btn || form.dataset.listener === "true") {
      return;
    }

    const defaultLabel =
      form.dataset.defaultLabel || 'Send';

    const sendingLabel =
      form.dataset.sendingLabel || 'Sending...';

    const errorMessage =
      form.dataset.errorMessage || 'Something went wrong.';

    const networkMessage =
      form.dataset.networkMessage || 'Network error.';

    const successUrl =
      form.dataset.successUrl || '/contact/success';


    form.addEventListener('submit', async (event) => {

      event.preventDefault();
      event.stopPropagation();

      btn.disabled = true;
      btn.innerText = sendingLabel;


      const formData = new FormData(form);

      const data =
        Object.fromEntries(formData.entries());


      try {

        const response =
          await fetch(FORMSPREE_URL, {

            method: 'POST',

            body:
              JSON.stringify(data),

            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            }

          });


        if (response.ok) {

          window.location.replace(successUrl);

        } else {

          alert(errorMessage);

          btn.disabled = false;
          btn.innerText = defaultLabel;

        }

      } catch (error) {

        alert(networkMessage);

        btn.disabled = false;
        btn.innerText = defaultLabel;

      }

    });


    form.dataset.listener = "true";
  }


  initForm();

  document.addEventListener(
    'astro:after-swap',
    initForm
  );

  document.addEventListener(
    'astro:page-load',
    initForm
  );
</script>
