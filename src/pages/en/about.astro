---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { brand } from '../../config/brand';
---

<BaseLayout
  title={`About Us | ${brand.name}`}
  description="Discover the philosophy behind Stay in Costa Blanca and our approach based on local presence, rigour, prevention and responsible property management."
>
  <Header slot="header" />


  <!-- =========================================================
       1. INTRO / STORY
  ========================================================== -->

  <section
    class="
      bg-[#F7FAFA]
      py-14
      sm:py-16
      md:py-20
      font-heading
      border-b
      border-[#D8E1E5]
    "
  >
    <div
      class="
        mx-auto
        max-w-site
        px-4
        sm:px-6
        lg:px-8
      "
    >
      <div
        class="
          grid
          grid-cols-1
          lg:grid-cols-2
          gap-10
          lg:gap-16
          items-center
        "
      >

        <!-- TEXT -->
        <div class="order-1">

          <p
            class="
              text-sm
              font-bold
              uppercase
              tracking-[0.16em]
              text-[#D99B26]
              mb-3
            "
          >
            ABOUT STAY IN COSTA BLANCA
          </p>


          <h1
            class="
              text-[34px]
              sm:text-[42px]
              lg:text-[50px]
              font-bold
              text-[#0E3846]
              tracking-tight
              leading-[1.1]
            "
          >
            Property management begins with trust.
          </h1>


          <p
            class="
              mt-6
              text-[18px]
              sm:text-xl
              font-semibold
              text-[#294A55]
              leading-8
            "
          >
            Stay in Costa Blanca started from a simple reality:
            when you do not live permanently near your property,
            you need someone local you can trust.
          </p>


          <p
            class="
              mt-4
              text-base
              sm:text-[17px]
              text-[#526B74]
              leading-7
              sm:leading-8
            "
          >
            Not simply to hold a key or open a door,
            but to notice what changes, document the condition of the
            property and be able to act when something requires attention.
          </p>


          <p
            class="
              mt-4
              text-base
              sm:text-[17px]
              text-[#526B74]
              leading-7
              sm:leading-8
            "
          >
            This is where the idea of local property management based on
            prevention, documentation and continuity came from — rather than
            isolated visits and simple confirmations that “everything looks fine”.
          </p>


          <!-- BRAND LINE -->
          <div
            class="
              mt-7
              pt-5
              border-t
              border-[#D4E1E5]
            "
          >
            <p
              class="
                text-sm
                sm:text-base
                font-bold
                text-[#0E3846]
              "
            >
              More time for you.
              <span class="text-[#D99B26]">
                We take care of the rest.
              </span>
            </p>
          </div>

        </div>


        <!-- PROPERTY PHOTO -->
        <div class="order-2">

          <div
            class="
              overflow-hidden
              rounded-2xl
              border
              border-[#D1E0E5]
              shadow-[0_18px_40px_rgba(14,56,70,0.14)]
            "
          >
            <img
              src="/palmhouse.jpg"
              alt="Mediterranean property in Costa Blanca"
              loading="eager"
              class="
                block
                w-full
                aspect-[4/3]
                object-cover
              "
            />
          </div>

        </div>

      </div>
    </div>
  </section>



  <!-- =========================================================
       2. ABOUT STELIAN
  ========================================================== -->

  <section
    class="
      bg-white
      py-14
      sm:py-16
      md:py-20
      font-heading
      border-b
      border-[#D8E1E5]
    "
  >
    <div
      class="
        mx-auto
        max-w-site
        px-4
        sm:px-6
        lg:px-8
      "
    >

      <div
        class="
          grid
          grid-cols-1
          lg:grid-cols-[0.9fr_1.1fr]
          gap-10
          lg:gap-16
          items-start
        "
      >

        <!-- PHOTO -->
        <div>

          <div
            class="
              overflow-hidden
              rounded-2xl
              border
              border-[#D1E0E5]
              shadow-[0_18px_40px_rgba(14,56,70,0.14)]
            "
          >
            <img
              src="/aboutme.png"
              alt="Stelian Matei"
              loading="lazy"
              class="
                block
                w-full
                aspect-[4/3]
                object-cover
                object-center
              "
            />
          </div>


          <!-- IDENTIFICATION -->
          <div
            class="
              relative
              -mt-5
              mx-4
              bg-white
              rounded-xl
              border
              border-[#D4E1E5]
              shadow-[0_8px_24px_rgba(14,56,70,0.10)]
              px-5
              py-4
            "
          >

            <p
              class="
                text-xl
                font-bold
                text-[#0E3846]
              "
            >
              Stelian Matei
            </p>

            <p
              class="
                mt-1
                text-sm
                font-semibold
                text-[#526B74]
              "
            >
              Managing Director & Property Specialist
            </p>

          </div>

        </div>


        <!-- TEXT -->
        <div>

          <p
            class="
              text-sm
              font-bold
              uppercase
              tracking-[0.16em]
              text-[#D99B26]
              mb-3
            "
          >
            THE PERSON BEHIND THE BRAND
          </p>


          <h2
            class="
              text-[30px]
              sm:text-4xl
              lg:text-[42px]
              font-bold
              text-[#0E3846]
              tracking-tight
              leading-[1.15]
            "
          >
            Different fields of experience, brought together in one way of working.
          </h2>


          <p
            class="
              mt-5
              text-base
              sm:text-[18px]
              text-[#294A55]
              leading-8
              font-medium
            "
          >
            I am Stelian Matei, founder of Stay in Costa Blanca.
            My professional background did not begin in property management,
            and that is precisely what shapes the way I work today.
          </p>


          <p
            class="
              mt-4
              text-base
              sm:text-[17px]
              text-[#526B74]
              leading-7
              sm:leading-8
            "
          >
            My experience brings together more than 15 years in the legal field
            and public administration, research activity in environmental
            protection and expertise in sustainable development.
          </p>


          <p
            class="
              mt-4
              text-base
              sm:text-[17px]
              text-[#526B74]
              leading-7
              sm:leading-8
            "
          >
            These fields taught me to work with procedures, documentation,
            clear responsibilities, verifiable observations and
            information-based decisions — principles I now apply to
            property management.
          </p>


          <!-- CREDENTIAL CARDS -->
          <div
            class="
              mt-7
              grid
              grid-cols-1
              sm:grid-cols-3
              gap-3
            "
          >

            <!-- LEGAL -->
            <div
              class="
                rounded-xl
                border
                border-[#D7E3E6]
                bg-[#F7FAFA]
                p-4
              "
            >
              <div
                class="
                  w-10
                  h-10
                  rounded-full
                  bg-[#E4F1F4]
                  flex
                  items-center
                  justify-center
                  text-[#0E3846]
                  mb-3
                "
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  class="w-5 h-5"
                  aria-hidden="true"
                >
                  <path
                    d="M6 3h12v18H6zM9 7h6M9 11h6M9 15h4"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </div>

              <h3 class="font-bold text-[#0E3846]">
                Legal
              </h3>

              <p
                class="
                  mt-1
                  text-sm
                  text-[#607983]
                  leading-6
                "
              >
                Rigour, documentation and responsibility.
              </p>
            </div>


            <!-- RESEARCH -->
            <div
              class="
                rounded-xl
                border
                border-[#D7E3E6]
                bg-[#F7FAFA]
                p-4
              "
            >
              <div
                class="
                  w-10
                  h-10
                  rounded-full
                  bg-[#E4F1F4]
                  flex
                  items-center
                  justify-center
                  text-[#0E3846]
                  mb-3
                "
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  class="w-5 h-5"
                  aria-hidden="true"
                >
                  <path
                    d="M9 3h6M10 3v6l-5 9a2 2 0 001.8 3h10.4a2 2 0 001.8-3l-5-9V3"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  <path
                    d="M8 15h8"
                    stroke-width="1.7"
                    stroke-linecap="round"
                  />
                </svg>
              </div>

              <h3 class="font-bold text-[#0E3846]">
                Research
              </h3>

              <p
                class="
                  mt-1
                  text-sm
                  text-[#607983]
                  leading-6
                "
              >
                Observation, comparison and analysis.
              </p>
            </div>


            <!-- SUSTAINABILITY -->
            <div
              class="
                rounded-xl
                border
                border-[#D7E3E6]
                bg-[#F7FAFA]
                p-4
              "
            >
              <div
                class="
                  w-10
                  h-10
                  rounded-full
                  bg-[#FFF2D8]
                  flex
                  items-center
                  justify-center
                  text-[#A86C00]
                  mb-3
                "
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  class="w-5 h-5"
                  aria-hidden="true"
                >
                  <path
                    d="M20 4C12 4 6 7 5 14c4 1 8 0 11-3M5 20c1-6 5-10 11-13"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </div>

              <h3 class="font-bold text-[#0E3846]">
                Sustainable development
              </h3>

              <p
                class="
                  mt-1
                  text-sm
                  text-[#607983]
                  leading-6
                "
              >
                Resources, prevention and long-term thinking.
              </p>
            </div>

          </div>

        </div>

      </div>

    </div>
  </section>



  <!-- =========================================================
       3. FILOZOFIA / A DOUA PHOTOGRAFIE
  ========================================================== -->

  <section
    class="
      bg-[#0E3846]
      py-14
      sm:py-16
      md:py-20
      font-heading
    "
  >
    <div
      class="
        mx-auto
        max-w-site
        px-4
        sm:px-6
        lg:px-8
      "
    >

      <div
        class="
          grid
          grid-cols-1
          lg:grid-cols-2
          gap-10
          lg:gap-16
          items-center
        "
      >

        <!-- TEXT -->
        <div>

          <p
            class="
              text-sm
              font-bold
              uppercase
              tracking-[0.16em]
              text-[#F3C76B]
              mb-3
            "
          >
            HOW WE WORK
          </p>


          <h2
            class="
              text-[30px]
              sm:text-4xl
              lg:text-[42px]
              font-bold
              text-white
              tracking-tight
              leading-[1.15]
            "
          >
            A property is not a checklist.
          </h2>


          <p
            class="
              mt-5
              text-[18px]
              sm:text-xl
              font-semibold
              text-[#E4EFF1]
              leading-8
            "
          >
            It is a system that changes over time.
          </p>


          <p
            class="
              mt-4
              text-base
              sm:text-[17px]
              text-[#C6DBDF]
              leading-7
              sm:leading-8
            "
          >
            Humidity, water and energy consumption, access, installations,
            air conditioning and exterior conditions should not be assessed
            only at the moment of a visit.
          </p>


          <p
            class="
              mt-4
              text-base
              sm:text-[17px]
              text-[#C6DBDF]
              leading-7
              sm:leading-8
            "
          >
            The real value appears when observations can be compared over time.
            That is why we document, maintain a history and track relevant
            changes in the property.
          </p>


          <!-- PROCESS -->
          <div
            class="
              mt-7
              flex
              flex-wrap
              gap-2
            "
          >
            {[
              'MEASURE',
              'COMPARE',
              'DOCUMENT',
              'DETECT',
              'ACT'
            ].map((item, index) => (
              <span
                class:list={[
                  "rounded-lg",
                  "px-3",
                  "py-2",
                  "text-xs",
                  "sm:text-[13px]",
                  "font-bold",
                  "tracking-[0.06em]",
                  index === 4
                    ? "bg-[#D99B26] text-[#0E3846]"
                    : "bg-[#174C5C] text-white border border-[#316878]"
                ]}
              >
                {item}
              </span>
            ))}
          </div>

        </div>


        <!-- =================================================
             SECOND PHOTO
        ================================================== -->

        <div>

          <div
            class="
              overflow-hidden
              rounded-2xl
              border
              border-white/10
              shadow-[0_20px_45px_rgba(0,0,0,0.25)]
              bg-[#174C5C]
            "
          >

            <!--
              AICI PUI A DOUA PHOTOGRAFIE CU TINE.

              Suggested file:
              public/check-wall.webp

              Ideal:
              - outdoors
              - near a property
              - optionally with a tablet / keys
              - natural, not a studio portrait
            -->

            <img
              src="/check-wall.webp"
              alt="Technician measuring wall moisture during a property inspection"
              loading="lazy"
              class="
                block
                w-full
                aspect-[4/3]
                object-cover
                object-center
              "
            />

          </div>

        </div>

      </div>

    </div>
  </section>



  <!-- =========================================================
       4. WHAT THIS MEANS FOR THE CLIENT
  ========================================================== -->

  <section
    class="
      bg-white
      py-14
      sm:py-16
      md:py-20
      font-heading
      border-b
      border-[#D8E1E5]
    "
  >
    <div
      class="
        mx-auto
        max-w-4xl
        px-4
        sm:px-6
        text-center
      "
    >

      <p
        class="
          text-sm
          font-bold
          uppercase
          tracking-[0.16em]
          text-[#D99B26]
          mb-3
        "
      >
        WHAT THIS MEANS FOR YOU
      </p>


      <h2
        class="
          text-[30px]
          sm:text-4xl
          lg:text-[42px]
          font-bold
          text-[#0E3846]
          tracking-tight
          leading-[1.15]
        "
      >
        Know what is happening with your property, even when you are not here.
      </h2>


      <p
        class="
          mt-5
          max-w-3xl
          mx-auto
          text-base
          sm:text-lg
          text-[#526B74]
          leading-7
          sm:leading-8
        "
      >
        Our role is to be present locally, document what we observe
        and give you the information you need so that decisions about
        your property are not made blindly.
      </p>


      <div
        class="
          mt-9
          flex
          flex-col
          sm:flex-row
          justify-center
          gap-3
        "
      >

        <a
          href="/en/contact"
          class="
            inline-flex
            min-h-[52px]
            items-center
            justify-center
            rounded-xl
            bg-[#0E3846]
            px-7
            py-3.5
            text-sm
            sm:text-[15px]
            font-bold
            text-white
            uppercase
            tracking-[0.05em]
            transition-all
            hover:bg-[#164D5D]
            hover:-translate-y-0.5
          "
        >
          REQUEST A PROPERTY ASSESSMENT
        </a>


        <a
          href="/en/services"
          class="
            inline-flex
            min-h-[52px]
            items-center
            justify-center
            rounded-xl
            border-2
            border-[#0E3846]
            bg-white
            px-7
            py-3.5
            text-sm
            sm:text-[15px]
            font-bold
            text-[#0E3846]
            uppercase
            tracking-[0.05em]
            transition-all
            hover:bg-[#EAF4F6]
          "
        >
          VIEW SERVICES & PRICING
        </a>

      </div>

    </div>
  </section>


  <Footer slot="footer" />

</BaseLayout>
