    launchAfter:
      'After this date: €99 VAT included',

    basicShort:
      'For owners who want one documented monthly check and secure key holding.',

    smartShort:
      'For properties left unoccupied for longer periods and owners who want more frequent preventive monitoring.',

    premiumShort:
      'For owners who want preventive monitoring combined with extended local management and coordination.',

    basicFeatures: [
      '12 scheduled documented visits / year',
      'Secure Key Holding',
      'Access & security check',
      'Basic water, electricity and AC checks',
      'Visual damp and infiltration observations',
      'Meter photographs',
      'Digital report after each visit',
      '1 severe-weather check / year',
    ],

    smartFeatures: [
      '24 physical presences / year',
      '12 Preventive Property Visits',
      '12 Monitoring & Assisted Ventilation visits',
      'Temperature and relative humidity monitoring',
      'Comparative moisture reference readings',
      'Preventive AC screening',
      'Terrace and drainage monitoring',
      '2 severe-weather checks / year',
      'Quarterly water & energy reviews',
    ],

    premiumFeatures: [
      '24 routine physical presences / year',
      '4 Extended Property Reviews',
      'Monthly water & energy reviews',
      '4 severe-weather checks / year',
      '2 contractor access & coordination services',
      '2 pre-arrival property preparations',
      'Annual Property Health Report',
      'Priority incident coordination',
      'Monthly administrative review',
    ],

    methodTopper:
      'OUR METHOD',

    methodTitle:
      'Measure. Compare. Document. Detect. Act.',

    methodText:
      'We do not assess a property from a single snapshot. We build a history that helps us identify changes over time.',

    compareTopper:
      'DETAILED COMPARISON',

    compareTitle:
      'See exactly what each level includes.',

    compareText:
      'The table below highlights the key differences between the three plans.',

    tableService:
      'Service / check',

    onboardingTable:
      'Onboarding / initial assessment',

    onboardingFreeTable:
      'FREE*',

    compareFootnote:
      '* Property Onboarding & Baseline Assessment is free for all three plans until 31 October 2026. After this date: €99 VAT included.',

    downloadTopper:
      'FULL COMPARISON',

    downloadTitle:
      'Keep the comparison table handy.',

    downloadText:
      'Download the PDF version to compare the plans, print it or review it later.',

    downloadButton:
      'DOWNLOAD COMPARISON PDF',

    downloadHint:
      'PDF · optimised for viewing and printing',

    rows: [
      ['Scheduled visits', '12 / year', '24 / year', '24 / year'],
      ['Secure Key Holding', '✓', '✓', '✓'],
      ['Digital report with photos', '✓', '✓', '✓'],
      ['Access & security', '✓', '✓', '✓'],
      ['Water / WC / drains', 'Basic', 'Preventive', 'Extended'],
      ['Electrical panel', 'Visual check', 'Preventive check', 'Extended check'],
      ['Air conditioning', 'Basic functional', 'Preventive screening', 'Extended screening'],
      ['Temperature & relative humidity', '—', '✓', '✓'],
      ['Assisted ventilation', '—', '12 / year', '12 / year'],
      ['Comparative moisture readings', '—', '✓', '✓'],
      ['Meter photographs', '✓', '✓', '✓'],
      ['Water & energy consumption review', '—', 'Quarterly', 'Monthly'],
      ['Terrace / exterior', 'Visual', 'Preventive', 'Extended'],
      ['Severe-weather checks', '1 / year', '2 / year', '4 / year'],
      ['Administrative review', '—', 'Quarterly', 'Monthly'],
      ['Extended Property Review', '—', '—', '4 / year'],
      ['Contractor access & coordination', 'On request', 'On request', '2 / year'],
      ['Pre-arrival preparation', 'On request', 'On request', '2 / year'],
      ['Annual Property Health Report', '—', '—', '✓'],
    ],

    visitTopper:
      'WHAT A VISIT MEANS',

    visitTitle:
      'A visit is a process, not simply stopping by the property.',

    visitIntro:
      'The exact scope depends on the plan and property configuration, but every visit follows a documented structure.',

    visitSteps: [
      {
        number: '01',
        title: 'Access',
        text: 'We check access points, doors, windows, shutters and visible changes.',
      },

      {
        number: '02',
        title: 'Utilities',
        text: 'We check relevant water, electricity, sanitary and equipment points covered by the plan.',
      },

      {
        number: '03',
        title: 'Indoor climate',
        text: 'We observe damp, condensation and infiltration signs and, depending on the plan, monitor temperature and relative humidity.',
      },

      {
        number: '04',
        title: 'Exterior',
        text: 'We inspect terraces, drainage and applicable exterior areas.',
      },

      {
        number: '05',
        title: 'Documentation',
        text: 'We record photographs, observations and relevant values for the property history.',
      },
    ],

    onboardingTopper:
      'BEFORE THE FIRST VISIT',

    onboardingTitle:
      'Property Onboarding & Baseline Assessment',

    onboardingPrice:
      '€99',

    onboardingVat:
      'VAT included',

    onboardingText:
      'Before monitoring begins, we carry out an initial assessment to understand the property and establish the baseline for future visits.',

    onboardingItems: [
      'Access and key handover registration',
      'Identification of relevant areas and equipment',
      'Baseline reference photos',
      'Initial meter readings, where possible',
      'Notes on the initial condition',
      'Defining property-specific details and access protocol',
    ],

    addonsTopper:
      'ADDITIONAL SERVICES',

    addonsTitle:
      'Need something extra?',

    addonsText:
      'Additional services are available on request and quoted separately according to time, travel and complexity.',

    addonGroups: [
      {
        title: 'Property Care',
        items: [
          'Additional property visit',
          'Additional severe-weather check',
          'Additional pre-arrival preparation',
          'Special property check',
        ],
      },

      {
        title: 'Access & Coordination',
        items: [
          'Additional contractor access',
          'Waiting / intervention supervision',
          'Key handover',
          'Additional local coordination',
        ],
      },

      {
        title: 'Convenience',
        items: [
          'Cleaning coordination',
          'Laundry coordination',
          'Mail collection / forwarding',
          'Other individually agreed requests',
        ],
      },
    ],

    excludedTopper:
      'TRANSPARENCY',

    excludedTitle:
      'What is not automatically included',

    excluded: [
      'Repairs, materials and parts',
      'Contractor or technician labour',
      'Cleaning and laundry',
      'Shopping and consumables',
      'Airport transfers',
      'Rental check-in / check-out',
      'Tax filings or legal services',
      'Unlimited intervention or coordination',
    ],

    sustainabilityTopper:
      'RESPONSIBLE MANAGEMENT',

    sustainabilityTitle:
      'Prevention, resources and resilience.',

    sustainabilityText:
      'We integrate sustainable-development principles into water and energy monitoring, preventive maintenance and collaboration with local providers.',

    sustainabilityCta:
      'EXPLORE OUR SUSTAINABILITY APPROACH',

    faqTopper:
      'PLAN QUESTIONS',

    faqTitle:
      'Useful to know before choosing.',

    faqs: [
      {
        q: 'What is the main difference between BASIC and SMART?',
        a: 'ECO-BASIC provides one documented visit per month. ECO-SMART doubles physical presence and adds preventive monitoring, assisted ventilation, temperature and humidity monitoring and quarterly consumption reviews.',
      },

      {
        q: 'Why does ECO-PREMIUM also have 24 routine visits?',
        a: 'The difference is not simply visit count. PREMIUM adds Extended Property Reviews, monthly consumption and administrative reviews, more severe-weather checks, contractor coordination, pre-arrival preparations and an annual Property Health Report.',
      },

      {
        q: 'Is onboarding included in the subscription?',
        a: 'Property Onboarding & Baseline Assessment has a standard price of €99 VAT included, regardless of plan. As a launch offer, it is free for every plan until 31 October 2026.',
      },

      {
        q: 'Can I purchase additional visits?',
        a: 'Yes. Additional visits and special checks can be requested separately.',
      },

      {
        q: 'Are repairs included?',
        a: 'No. We identify and document issues and may coordinate intervention according to your service, but third-party labour and materials are charged separately.',
      },

      {
        q: 'What if my property is unusually large or complex?',
        a: 'Published pricing is intended for standard property configurations. Very large properties, extensive exterior areas or specialist systems may require a custom quotation.',
      },

      {
        q: 'Do I need to choose the plan myself?',
        a: 'No. Tell us about the property and how long it is normally unoccupied and we can recommend the appropriate monitoring level.',
      },
    ],
};


/* =========================================================
   PACKAGE DATA
========================================================= */

const packages = [
  {
    id: 'eco-basic',
    name: 'ECO-BASIC',
    level: 'WATCH',
    priceMain: '649 €',
    priceUnit: `/${t.year}`,
    subprice: t.annualOnly,
    description: t.basicShort,
    features: t.basicFeatures,
    featured: false,
  },

  {
    id: 'eco-smart',
    name: 'ECO-SMART',
    level: 'PREVENT',
    priceMain: '125 €',
    priceUnit: `/${t.month}`,
    subprice: `${t.contract12} · 1.425 €/${t.year} ${t.prepaid} · ${t.save5}`,
    description: t.smartShort,
    features: t.smartFeatures,
    featured: true,
  },

  {
    id: 'eco-premium',
    name: 'ECO-PREMIUM',
    level: 'MANAGE',
    priceMain: '185 €',
    priceUnit: `/${t.month}`,
    subprice: `${t.contract12} · 2.099 €/${t.year} ${t.prepaid} · ${t.saveMore5}`,
    description: t.premiumShort,
    features: t.premiumFeatures,
    featured: false,
  },
];
---

<BaseLayout
  title={t.seoTitle}
  description={t.seoDescription}
>

  <Header slot="header" />


  <!-- =====================================================
       HERO
  ====================================================== -->

  <section
    class="
      bg-[#F7FAFA]
      border-b
      border-[#D8E1E5]
      font-heading
      py-14
      sm:py-16
      lg:py-20
    "
  >

    <div class="mx-auto max-w-site px-4 sm:px-6 lg:px-8">

      <div class="mx-auto max-w-4xl text-center">

        <div
          class="
            inline-flex
            flex-col
            sm:flex-row
            items-center
            gap-2
            sm:gap-3
            rounded-xl
            bg-[#0E3846]
            px-5
            py-3
            text-white
          "
        >
          <span class="text-xs sm:text-sm font-bold tracking-[0.1em]">
            {t.heroTopper}
          </span>

          <span class="hidden sm:inline text-[#D99B26]">
            •
          </span>

          <span class="text-xs sm:text-sm font-semibold">
            {t.heroLocation}
          </span>
        </div>


        <h1
          class="
            mt-7
            text-[36px]
            sm:text-5xl
            lg:text-[56px]
            font-bold
            tracking-tight
            leading-[1.08]
            text-[#0E3846]
          "
        >
          {t.heroTitle}
        </h1>


        <p
          class="
            mt-6
            mx-auto
            max-w-3xl
            text-base
            sm:text-lg
            leading-8
            text-[#526B74]
          "
        >
          {t.heroText}
        </p>


        <div
          class="
            mt-8
            flex
            flex-col
            sm:flex-row
            justify-center
            gap-3
          "
        >

          <a
            href="#comparison"
            class="
              inline-flex
              min-h-[52px]
              items-center
              justify-center
              rounded-xl
              bg-[#0E3846]
              px-7
              py-3
              text-sm
              font-bold
              text-white
              transition
              hover:bg-[#164D5D]
            "
          >
            {t.heroCta}
          </a>


          <a
            href={r.contact}
            class="
              inline-flex
              min-h-[52px]
              items-center
              justify-center
              rounded-xl
              border-2
              border-[#0E3846]
              bg-white
              px-7
              py-3
              text-sm
              font-bold
              text-[#0E3846]
              transition
              hover:bg-[#EAF4F6]
            "
          >
            {t.heroSecondary}
          </a>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================================
       PACKAGES
  ====================================================== -->

  <section
    class="
      bg-white
      py-16
      sm:py-20
      font-heading
    "
  >

    <div class="mx-auto max-w-site px-4 sm:px-6 lg:px-8">

      <div class="mx-auto max-w-4xl text-center">

        <p
          class="
            text-sm
            font-bold
            uppercase
            tracking-[0.16em]
            text-[#D99B26]
          "
        >
          {t.packagesTopper}
        </p>


        <h2
          class="
            mt-3
            text-[30px]
            sm:text-4xl
            lg:text-[44px]
            font-bold
            tracking-tight
            leading-[1.15]
            text-[#0E3846]
          "
        >
          {t.packagesTitle}
        </h2>


        <p
          class="
            mt-5
            mx-auto
            max-w-3xl
            text-base
            sm:text-lg
            leading-8
            text-[#526B74]
          "
        >
          {t.packagesText}
        </p>

      </div>


      <div
        class="
          mt-12
          grid
          grid-cols-1
          lg:grid-cols-3
          gap-6
          lg:items-stretch
        "
      >

        {
          packages.map((pkg) => (

            <article
              id={pkg.id}
              class:list={[
                "relative",
                "flex",
                "flex-col",
                "rounded-2xl",
                "border",
                "p-6",
                "sm:p-7",
                "scroll-mt-28",

                pkg.featured
                  ? "border-[#5B9EB5] bg-[#F1F8FA] shadow-[0_16px_36px_rgba(14,56,70,0.13)] lg:-translate-y-2"
                  : "border-[#D2E0E4] bg-white shadow-[0_8px_24px_rgba(14,56,70,0.07)]",
              ]}
            >

              {pkg.featured && (

                <div
                  class="
                    absolute
                    -top-3
                    left-1/2
                    -translate-x-1/2
                    rounded-full
                    bg-[#5B9EB5]
                    px-4
                    py-1.5
                    text-[10px]
                    font-bold
                    uppercase
                    tracking-[0.12em]
                    text-white
                  "
                >
                  {t.popular}
                </div>

              )}


              <div>

                <p
                  class="
                    text-xs
                    font-bold
                    uppercase
                    tracking-[0.15em]
                    text-[#D99B26]
                  "
                >
                  {pkg.level}
                </p>

                <h3
                  class="
                    mt-2
                    text-2xl
                    font-bold
                    text-[#0E3846]
                  "
                >
                  {pkg.name}
                </h3>


                <p
                  class="
                    mt-4
                    min-h-[72px]
                    text-[15px]
                    leading-7
                    text-[#526B74]
                  "
                >
                  {pkg.description}
                </p>

              </div>


              <!-- PRICE -->

              <div
                class="
                  mt-6
                  border-y
                  border-[#D8E3E6]
                  py-5
                "
              >

                <div class="flex items-end gap-1.5">

                  <span
                    class="
                      text-[38px]
                      sm:text-[42px]
                      font-bold
                      tracking-tight
                      text-[#0E3846]
                    "
                  >
                    {pkg.priceMain}
                  </span>

                  <span
                    class="
                      pb-1.5
                      text-sm
                      font-semibold
                      text-[#6A838C]
                    "
                  >
                    {pkg.priceUnit}
                  </span>

                </div>


                <p
                  class="
                    mt-1
                    text-xs
                    leading-5
                    text-[#6A838C]
                  "
                >
                  {pkg.subprice}
                </p>


                <p
                  class="
                    mt-1
                    text-xs
                    font-semibold
                    text-[#0E3846]
                  "
                >
                  {t.vat}
                </p>

              </div>


              <!-- FEATURES -->

              <ul class="mt-6 space-y-3 flex-1">

                {pkg.features.map((feature) => (

                  <li
                    class="
                      flex
                      items-start
                      gap-3
                      text-[14px]
                      leading-6
                      text-[#405963]
                    "
                  >

                    <span
                      class="
                        mt-1
                        flex
                        h-5
                        w-5
                        shrink-0
                        items-center
                        justify-center
                        rounded-full
                        bg-[#E5F2F5]
                        text-[#0E3846]
                      "
                    >
                      ✓
                    </span>

                    <span>{feature}</span>

                  </li>

                ))}

              </ul>


              <!-- =================================================
                   ONBOARDING PRICE / LAUNCH OFFER
              ================================================== -->

              <div
                class="
                  mt-7
                  rounded-xl
                  border
                  border-[#E5C16D]
                  bg-[#FFF9ED]
                  p-4
                "
              >

                <p
                  class="
                    text-[11px]
                    font-bold
                    uppercase
                    tracking-[0.1em]
                    text-[#0E3846]
                  "
                >
                  {t.onboardingLabel}
                </p>


                <div
                  class="
                    mt-2
                    flex
                    items-center
                    justify-between
                    gap-3
                  "
                >

                  <span
                    class="
                      text-sm
                      font-semibold
                      text-[#6A838C]
                      line-through
                    "
                  >
                    {t.onboardingStandard}
                  </span>


                  <span
                    class="
                      rounded-full
                      bg-[#D99B26]
                      px-3
                      py-1
                      text-[10px]
                      font-bold
                      uppercase
                      tracking-[0.05em]
                      text-[#0E3846]
                    "
                  >
                    {t.launchOffer}
                  </span>

                </div>


                <p
                  class="
                    mt-3
                    text-[14px]
                    font-bold
                    leading-5
                    text-[#0E3846]
                  "
                >
                  {t.launchFree}
                </p>

              </div>


              <!-- CTA -->

              <a
                href={r.contact}
                class:list={[
                  "mt-6",
                  "inline-flex",
                  "min-h-[52px]",
                  "items-center",
                  "justify-center",
                  "rounded-xl",
                  "px-5",
                  "py-3",
                  "text-center",
                  "text-sm",
                  "font-bold",
                  "transition",

                  pkg.featured
                    ? "bg-[#0E3846] text-white hover:bg-[#164D5D]"
                    : "border-2 border-[#0E3846] text-[#0E3846] hover:bg-[#EAF4F6]",
                ]}
              >
                {t.choose}
              </a>

            </article>

          ))
        }

      </div>

    </div>

  </section>


  <!-- =====================================================
       METHOD
  ====================================================== -->

  <section
    class="
      bg-[#0E3846]
      py-10
      sm:py-12
      font-heading
    "
  >

    <div
      class="
        mx-auto
        max-w-site
        px-4
        sm:px-6
        lg:px-8
        text-center
      "
    >

      <p
        class="
          text-xs
          font-bold
          uppercase
          tracking-[0.16em]
          text-[#F3C76B]
        "
      >
        {t.methodTopper}
      </p>


      <h2
        class="
          mt-3
          text-2xl
          sm:text-3xl
          font-bold
          text-white
        "
      >
        {t.methodTitle}
      </h2>


      <p
        class="
          mt-4
          mx-auto
          max-w-3xl
          text-base
          leading-7
          text-[#CFE0E4]
        "
      >
        {t.methodText}
      </p>

    </div>

  </section>


  <!-- =====================================================
       COMPARISON
  ====================================================== -->

  <section
    id="comparison"
    class="
      scroll-mt-24
      bg-[#F7FAFA]
      py-16
      sm:py-20
      font-heading
    "
  >

    <div class="mx-auto max-w-site px-4 sm:px-6 lg:px-8">

      <div class="mx-auto max-w-4xl text-center">

        <p
          class="
            text-sm
            font-bold
            uppercase
            tracking-[0.16em]
            text-[#D99B26]
          "
        >
          {t.compareTopper}
        </p>


        <h2
          class="
            mt-3
            text-[30px]
            sm:text-4xl
            lg:text-[44px]
            font-bold
            tracking-tight
            text-[#0E3846]
          "
        >
          {t.compareTitle}
        </h2>


        <p
          class="
            mt-4
            text-base
            sm:text-lg
            text-[#526B74]
          "
        >
          {t.compareText}
        </p>

      </div>


      <!-- =================================================
           DESKTOP TABLE
      ================================================== -->

      <div class="hidden lg:block">

        <div
          class="
            mt-10
            overflow-hidden
            rounded-2xl
            border
            border-[#D1E0E5]
            bg-white
            shadow-[0_8px_24px_rgba(14,56,70,0.07)]
          "
        >

          <table class="w-full border-collapse">

            <thead>

              <tr class="bg-[#0E3846] text-white">

                <th
                  class="
                    w-[37%]
                    px-5
                    py-5
                    text-left
                    text-sm
                    font-bold
                  "
                >
                  {t.tableService}
                </th>


                <th class="px-4 py-5 text-center text-sm font-bold">

                  ECO-BASIC

                  <span
                    class="
                      block
                      mt-1
                      text-[10px]
                      tracking-[0.12em]
                      text-[#F3C76B]
                    "
                  >
                    WATCH
                  </span>

                </th>


                <th
                  class="
                    bg-[#155165]
                    px-4
                    py-5
                    text-center
                    text-sm
                    font-bold
                  "
                >

                  ECO-SMART

                  <span
                    class="
                      block
                      mt-1
                      text-[10px]
                      tracking-[0.12em]
                      text-[#F3C76B]
                    "
                  >
                    PREVENT
                  </span>

                </th>


                <th class="px-4 py-5 text-center text-sm font-bold">

                  ECO-PREMIUM

                  <span
                    class="
                      block
                      mt-1
                      text-[10px]
                      tracking-[0.12em]
                      text-[#F3C76B]
                    "
                  >
                    MANAGE
                  </span>

                </th>

              </tr>

            </thead>


            <tbody>

