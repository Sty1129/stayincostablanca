    heroCta:
      'COMPARE PLANS',

    heroSecondary:
      'REQUEST A PROPERTY ASSESSMENT',

    packagesTopper:
      'OUR PLANS',

    packagesTitle:
      'Three levels of management. One working method.',

    packagesText:
      'Every plan is built around documented visits and prevention. The difference is frequency, depth of monitoring and the level of coordination included.',

    vat:
      'VAT included',

    year:
      'year',

    month:
      'month',

    annualOnly:
      'Annual contract',

