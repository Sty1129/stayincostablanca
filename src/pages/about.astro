---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { brand } from '../config/brand';
---

<BaseLayout
  title={`Despre noi | ${brand.name}`}
  description="Cunoaște filosofia Stay in Costa Blanca și abordarea bazată pe prezență locală, rigoare, prevenție și administrare responsabilă a proprietăților."
>
  <Header slot="header" />


  <!-- =========================================================
       1. INTRO / POVESTEA
  ========================================================== -->

  <section
    class="
      bg-[#F7FAFA]
      py-14
      sm:py-16
      md:py-20
      font-heading
      border-b
      border-[#D8E1E5]
    "
  >
    <div
      class="
        mx-auto
        max-w-site
        px-4
        sm:px-6
        lg:px-8
      "
    >
      <div
        class="
          grid
          grid-cols-1
          lg:grid-cols-2
          gap-10
          lg:gap-16
          items-center
        "
      >

        <!-- TEXT -->
        <div class="order-1">

          <p
            class="
              text-sm
              font-bold
              uppercase
              tracking-[0.16em]
              text-[#D99B26]
              mb-3
            "
          >
            DESPRE STAY IN COSTA BLANCA
          </p>


          <h1
            class="
              text-[34px]
              sm:text-[42px]
              lg:text-[50px]
              font-bold
              text-[#0E3846]
              tracking-tight
              leading-[1.1]
            "
          >
            Administrarea unei proprietăți începe cu încrederea.
          </h1>


          <p
            class="
              mt-6
              text-[18px]
              sm:text-xl
              font-semibold
              text-[#294A55]
              leading-8
            "
          >
            Stay in Costa Blanca a pornit de la o realitate simplă:
            atunci când nu locuiești permanent lângă proprietatea ta,
            ai nevoie de cineva local în care să poți avea încredere.
          </p>


          <p
            class="
              mt-4
              text-base
              sm:text-[17px]
              text-[#526B74]
              leading-7
              sm:leading-8
            "
          >
            Nu doar pentru a păstra o cheie sau pentru a deschide o ușă,
            ci pentru a observa ce se schimbă, a documenta starea
            proprietății și a putea acționa atunci când apare o situație
            care necesită atenție.
          </p>


          <p
            class="
              mt-4
              text-base
              sm:text-[17px]
              text-[#526B74]
              leading-7
              sm:leading-8
            "
          >
            De aici a apărut ideea unei administrări locale bazate pe
            prevenție, documentare și continuitate — nu pe vizite izolate
            și simple confirmări că „totul pare în regulă”.
          </p>


          <!-- BRAND LINE -->
          <div
            class="
              mt-7
              pt-5
              border-t
              border-[#D4E1E5]
            "
          >
            <p
              class="
                text-sm
                sm:text-base
                font-bold
                text-[#0E3846]
              "
            >
              More time for you.
              <span class="text-[#D99B26]">
                We take care of the rest.
              </span>
            </p>
          </div>

        </div>


        <!-- FOTO PROPRIETATE -->
        <div class="order-2">

          <div
            class="
              overflow-hidden
              rounded-2xl
              border
              border-[#D1E0E5]
              shadow-[0_18px_40px_rgba(14,56,70,0.14)]
            "
          >
            <img
              src="/palmhouse.jpg"
              alt="Proprietate mediteraneană în Costa Blanca"
              loading="eager"
              class="
                block
                w-full
                aspect-[4/3]
                object-cover
              "
            />
          </div>

        </div>

      </div>
    </div>
  </section>



  <!-- =========================================================
       2. CINE ESTE STELIAN
  ========================================================== -->

  <section
    class="
      bg-white
      py-14
      sm:py-16
      md:py-20
      font-heading
      border-b
      border-[#D8E1E5]
    "
  >
    <div
      class="
        mx-auto
        max-w-site
        px-4
        sm:px-6
        lg:px-8
      "
    >

      <div
        class="
          grid
          grid-cols-1
          lg:grid-cols-[0.9fr_1.1fr]
          gap-10
          lg:gap-16
          items-start
        "
      >

        <!-- FOTO -->
        <div>

          <div
            class="
              overflow-hidden
              rounded-2xl
              border
              border-[#D1E0E5]
              shadow-[0_18px_40px_rgba(14,56,70,0.14)]
            "
          >
            <img
              src="/aboutme.png"
              alt="Stelian Matei"
              loading="lazy"
              class="
                block
                w-full
                aspect-[4/3]
                object-cover
                object-center
              "
            />
          </div>


          <!-- IDENTIFICARE -->
          <div
            class="
              relative
              -mt-5
              mx-4
              bg-white
              rounded-xl
              border
              border-[#D4E1E5]
              shadow-[0_8px_24px_rgba(14,56,70,0.10)]
              px-5
              py-4
            "
          >

            <p
              class="
                text-xl
                font-bold
                text-[#0E3846]
              "
            >
              Stelian Matei
            </p>

            <p
              class="
                mt-1
                text-sm
                font-semibold
                text-[#526B74]
              "
            >
              Director General & Specialist în Administrarea Proprietăților
            </p>

          </div>

        </div>


        <!-- TEXT -->
        <div>

          <p
            class="
              text-sm
              font-bold
              uppercase
              tracking-[0.16em]
              text-[#D99B26]
              mb-3
            "
          >
            CINE SE AFLĂ ÎN SPATELE BRANDULUI
          </p>


          <h2
            class="
              text-[30px]
              sm:text-4xl
              lg:text-[42px]
              font-bold
              text-[#0E3846]
              tracking-tight
              leading-[1.15]
            "
          >
            Experiențe diferite, reunite într-un singur mod de lucru.
          </h2>


          <p
            class="
              mt-5
              text-base
              sm:text-[18px]
              text-[#294A55]
              leading-8
              font-medium
            "
          >
            Sunt Stelian Matei, fondatorul Stay in Costa Blanca.
            Parcursul meu profesional nu a început în property management,
            iar tocmai acest lucru definește modul în care lucrez astăzi.
          </p>


          <p
            class="
              mt-4
              text-base
              sm:text-[17px]
              text-[#526B74]
              leading-7
              sm:leading-8
            "
          >
            Experiența mea reunește peste 15 ani în domeniul juridic și
            administrația publică, activitate în cercetare în domeniul
            protecției mediului și expertiză în dezvoltare durabilă.
          </p>


          <p
            class="
              mt-4
              text-base
              sm:text-[17px]
              text-[#526B74]
              leading-7
              sm:leading-8
            "
          >
            Aceste domenii m-au învățat să lucrez cu proceduri, documente,
            responsabilități clare, observații verificabile și decizii bazate
            pe informații — principii pe care le aplic acum administrării
            proprietăților.
          </p>


          <!-- CREDENTIAL CARDS -->
          <div
            class="
              mt-7
              grid
              grid-cols-1
              sm:grid-cols-3
              gap-3
            "
          >

            <!-- JURIDIC -->
            <div
              class="
                rounded-xl
                border
                border-[#D7E3E6]
                bg-[#F7FAFA]
                p-4
              "
            >
              <div
                class="
                  w-10
                  h-10
                  rounded-full
                  bg-[#E4F1F4]
                  flex
                  items-center
                  justify-center
                  text-[#0E3846]
                  mb-3
                "
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  class="w-5 h-5"
                  aria-hidden="true"
                >
                  <path
                    d="M6 3h12v18H6zM9 7h6M9 11h6M9 15h4"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </div>

              <h3 class="font-bold text-[#0E3846]">
                Juridic
              </h3>

              <p
                class="
                  mt-1
                  text-sm
                  text-[#607983]
                  leading-6
                "
              >
                Rigoare, documentare și responsabilitate.
              </p>
            </div>


            <!-- CERCETARE -->
            <div
              class="
                rounded-xl
                border
                border-[#D7E3E6]
                bg-[#F7FAFA]
                p-4
              "
            >
              <div
                class="
                  w-10
                  h-10
                  rounded-full
                  bg-[#E4F1F4]
                  flex
                  items-center
                  justify-center
                  text-[#0E3846]
                  mb-3
                "
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  class="w-5 h-5"
                  aria-hidden="true"
                >
                  <path
                    d="M9 3h6M10 3v6l-5 9a2 2 0 001.8 3h10.4a2 2 0 001.8-3l-5-9V3"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  <path
                    d="M8 15h8"
                    stroke-width="1.7"
                    stroke-linecap="round"
                  />
                </svg>
              </div>

              <h3 class="font-bold text-[#0E3846]">
                Cercetare
              </h3>

              <p
                class="
                  mt-1
                  text-sm
                  text-[#607983]
                  leading-6
                "
              >
                Observație, comparație și analiză.
              </p>
            </div>


            <!-- SUSTENABILITATE -->
            <div
              class="
                rounded-xl
                border
                border-[#D7E3E6]
                bg-[#F7FAFA]
                p-4
              "
            >
              <div
                class="
                  w-10
                  h-10
                  rounded-full
                  bg-[#FFF2D8]
                  flex
                  items-center
                  justify-center
                  text-[#A86C00]
                  mb-3
                "
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  class="w-5 h-5"
                  aria-hidden="true"
                >
                  <path
                    d="M20 4C12 4 6 7 5 14c4 1 8 0 11-3M5 20c1-6 5-10 11-13"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </div>

              <h3 class="font-bold text-[#0E3846]">
                Dezvoltare durabilă
              </h3>

              <p
                class="
                  mt-1
                  text-sm
                  text-[#607983]
                  leading-6
                "
              >
                Resurse, prevenție și gândire pe termen lung.
              </p>
            </div>

          </div>

        </div>

      </div>

    </div>
  </section>



  <!-- =========================================================
       3. FILOZOFIA / A DOUA FOTOGRAFIE
  ========================================================== -->

  <section
    class="
      bg-[#0E3846]
      py-14
      sm:py-16
      md:py-20
      font-heading
    "
  >
    <div
      class="
        mx-auto
        max-w-site
        px-4
        sm:px-6
        lg:px-8
      "
    >

      <div
        class="
          grid
          grid-cols-1
          lg:grid-cols-2
          gap-10
          lg:gap-16
          items-center
        "
      >

        <!-- TEXT -->
        <div>

          <p
            class="
              text-sm
              font-bold
              uppercase
              tracking-[0.16em]
              text-[#F3C76B]
              mb-3
            "
          >
            MODUL NOSTRU DE LUCRU
          </p>


          <h2
            class="
              text-[30px]
              sm:text-4xl
              lg:text-[42px]
              font-bold
              text-white
              tracking-tight
              leading-[1.15]
            "
          >
            O proprietate nu este o listă de bife.
          </h2>


          <p
            class="
              mt-5
              text-[18px]
              sm:text-xl
              font-semibold
              text-[#E4EFF1]
              leading-8
            "
          >
            Este un sistem care se schimbă în timp.
          </p>


          <p
            class="
              mt-4
              text-base
              sm:text-[17px]
              text-[#C6DBDF]
              leading-7
              sm:leading-8
            "
          >
            Umiditatea, consumul de apă și energie, accesul, instalațiile,
            climatizarea sau starea exteriorului nu trebuie privite doar
            în momentul unei vizite.
          </p>


          <p
            class="
              mt-4
              text-base
              sm:text-[17px]
              text-[#C6DBDF]
              leading-7
              sm:leading-8
            "
          >
            Valoarea apare atunci când observațiile pot fi comparate în timp.
            De aceea documentăm, păstrăm istoricul și urmărim schimbările
            relevante ale proprietății.
          </p>


          <!-- PROCES -->
          <div
            class="
              mt-7
              flex
              flex-wrap
              gap-2
            "
          >
            {[
              'MĂSURĂM',
              'COMPARĂM',
              'DOCUMENTĂM',
              'DETECTĂM',
              'ACȚIONĂM'
            ].map((item, index) => (
              <span
                class:list={[
                  "rounded-lg",
                  "px-3",
                  "py-2",
                  "text-xs",
                  "sm:text-[13px]",
                  "font-bold",
                  "tracking-[0.06em]",
                  index === 4
                    ? "bg-[#D99B26] text-[#0E3846]"
                    : "bg-[#174C5C] text-white border border-[#316878]"
                ]}
              >
                {item}
              </span>
            ))}
          </div>

        </div>


        <!-- =================================================
             A DOUA POZĂ CU TINE
        ================================================== -->

        <div>

          <div
            class="
              overflow-hidden
              rounded-2xl
              border
              border-white/10
              shadow-[0_20px_45px_rgba(0,0,0,0.25)]
              bg-[#174C5C]
            "
          >

            <!--
              AICI PUI A DOUA FOTOGRAFIE CU TINE.

              Recomandare:
              public/stelian-property.jpg

              Ideal:
              - în exterior
              - lângă o proprietate
              - eventual cu tabletă / chei
              - naturală, nu fotografie de studio
            -->

            <img
              src="/stelian-property.jpg"
              alt="Stelian Matei în Costa Blanca"
              loading="lazy"
              class="
                block
                w-full
                aspect-[4/3]
                object-cover
                object-center
              "
            />

          </div>

        </div>

      </div>

    </div>
  </section>



  <!-- =========================================================
       4. CE ÎNSEAMNĂ PENTRU CLIENT
  ========================================================== -->

  <section
    class="
      bg-white
      py-14
      sm:py-16
      md:py-20
      font-heading
      border-b
      border-[#D8E1E5]
    "
  >
    <div
      class="
        mx-auto
        max-w-4xl
        px-4
        sm:px-6
        text-center
      "
    >

      <p
        class="
          text-sm
          font-bold
          uppercase
          tracking-[0.16em]
          text-[#D99B26]
          mb-3
        "
      >
        CE ÎNSEAMNĂ ASTA PENTRU TINE
      </p>


      <h2
        class="
          text-[30px]
          sm:text-4xl
          lg:text-[42px]
          font-bold
          text-[#0E3846]
          tracking-tight
          leading-[1.15]
        "
      >
        Să știi ce se întâmplă cu proprietatea ta, chiar dacă nu ești aici.
      </h2>


      <p
        class="
          mt-5
          max-w-3xl
          mx-auto
          text-base
          sm:text-lg
          text-[#526B74]
          leading-7
          sm:leading-8
        "
      >
        Rolul nostru este să fim prezenți local, să documentăm ceea ce
        observăm și să îți oferim informația necesară pentru ca deciziile
        privind proprietatea să nu fie luate în orb.
      </p>


      <div
        class="
          mt-9
          flex
          flex-col
          sm:flex-row
          justify-center
          gap-3
        "
      >

        <a
          href="/contact"
          class="
            inline-flex
            min-h-[52px]
            items-center
            justify-center
            rounded-xl
            bg-[#0E3846]
            px-7
            py-3.5
            text-sm
            sm:text-[15px]
            font-bold
            text-white
            uppercase
            tracking-[0.05em]
            transition-all
            hover:bg-[#164D5D]
            hover:-translate-y-0.5
          "
        >
          SOLICITĂ EVALUAREA PROPRIETĂȚII
        </a>


        <a
          href="/services"
          class="
            inline-flex
            min-h-[52px]
            items-center
            justify-center
            rounded-xl
            border-2
            border-[#0E3846]
            bg-white
            px-7
            py-3.5
            text-sm
            sm:text-[15px]
            font-bold
            text-[#0E3846]
            uppercase
            tracking-[0.05em]
            transition-all
            hover:bg-[#EAF4F6]
          "
        >
          VEZI SERVICIILE ȘI PREȚURILE
        </a>

      </div>

    </div>
  </section>


  <Footer slot="footer" />

</BaseLayout>
