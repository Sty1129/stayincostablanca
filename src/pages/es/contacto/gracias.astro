
---
/* src/pages/es/contacto/gracias.astro */

import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { brand } from '../../../config/brand';
---

<BaseLayout
  title={`Gracias | ${brand.name}`}
  description="Hemos recibido tu mensaje. Stay in Costa Blanca se pondrá en contacto contigo lo antes posible."
>
  <Header slot="header" />

  <section
    class="
      bg-[#F7FAFA]
      py-16
      sm:py-20
      lg:py-24
      font-heading
      border-b
      border-[#D8E1E5]
    "
  >
    <div
      class="
        mx-auto
        max-w-site
        px-4
        sm:px-6
        lg:px-8
      "
    >
      <div
        class="
          mx-auto
          max-w-3xl
          text-center
        "
      >
        <!-- SUCCESS ICON -->
        <div
          class="
            mx-auto
            flex
            h-20
            w-20
            items-center
            justify-center
            rounded-full
            bg-[#E6F2F5]
            text-[#0E3846]
            shadow-[0_8px_24px_rgba(14,56,70,0.08)]
          "
          aria-hidden="true"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            class="h-10 w-10"
          >
            <path
              d="M5 12l4 4L19 6"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </div>

        <p
          class="
            mt-7
            text-sm
            font-bold
            uppercase
            tracking-[0.18em]
            text-[#D99B26]
          "
        >
          MENSAJE ENVIADO
        </p>

        <h1
          class="
            mt-3
            text-[36px]
            sm:text-5xl
            lg:text-[54px]
            font-bold
            tracking-tight
            leading-[1.08]
            text-[#0E3846]
          "
        >
          Gracias por contactar con nosotros.
        </h1>

        <p
          class="
            mx-auto
            mt-6
            max-w-2xl
            text-base
            sm:text-lg
            leading-8
            text-[#526B74]
          "
        >
          Hemos recibido tu mensaje correctamente. Revisaremos la información
          sobre tu propiedad y nos pondremos en contacto contigo lo antes posible.
        </p>

        <div
          class="
            mx-auto
            mt-8
            max-w-2xl
            rounded-2xl
            border
            border-[#E3C773]
            bg-[#FFF9ED]
            px-6
            py-5
          "
        >
          <p
            class="
              text-sm
              sm:text-base
              leading-7
              text-[#405963]
            "
          >
            Si necesitas añadir algún detalle mientras tanto, puedes escribirnos
            directamente por WhatsApp o responder cuando nos pongamos en contacto contigo.
          </p>
        </div>

        <div
          class="
            mt-9
            flex
            flex-col
            sm:flex-row
            justify-center
            gap-3
          "
        >
          <a
            href="/es/"
            class="
              inline-flex
              min-h-[52px]
              items-center
              justify-center
              rounded-xl
              bg-[#0E3846]
              px-7
              py-3.5
              text-sm
              font-bold
              uppercase
              tracking-[0.04em]
              text-white
              transition-all
              duration-200
              hover:-translate-y-0.5
              hover:bg-[#164D5D]
            "
          >
            VOLVER AL INICIO
          </a>

          <a
            href="https://wa.me/34624110656?text=%C2%A1Hola%21%20Acabo%20de%20enviar%20el%20formulario%20de%20contacto%20de%20Stay%20in%20Costa%20Blanca%20y%20quer%C3%ADa%20a%C3%B1adir%20un%20detalle."
            target="_blank"
            rel="noopener noreferrer"
            class="
              inline-flex
              min-h-[52px]
              items-center
              justify-center
              rounded-xl
              border-2
              border-[#0E3846]
              bg-white
              px-7
              py-3.5
              text-sm
              font-bold
              uppercase
              tracking-[0.04em]
              text-[#0E3846]
              transition-all
              duration-200
              hover:-translate-y-0.5
              hover:bg-[#EAF4F6]
            "
          >
            ESCRIBIR POR WHATSAPP
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
