
---
/* src/pages/es/servicios.astro */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTA from '../../components/CTA.astro';
import { brand } from '../../config/brand';

const r = {
  contact: '/es/contacto',
  sustainability: '/es/sostenibilidad',
  pdf: '/compare-es.pdf',
};

const t = {
    seoTitle:
      `Servicios y Precios | ${brand.name}`,

    seoDescription:
      'Compara los planes ECO-BASIC, ECO-SMART y ECO-PREMIUM de Custodia de Llaves y Gestión de Propiedades en Orihuela Costa y Torrevieja.',

    heroTopper:
      'CUSTODIA DE LLAVES & GESTIÓN DE PROPIEDADES',

    heroLocation:
      'Orihuela Costa & Torrevieja',

    heroTitle:
      'Elige el nivel de protección adecuado para tu propiedad.',

    heroText:
      'Desde revisiones periódicas y custodia segura de llaves hasta monitorización preventiva y coordinación local, cada plan ofrece un nivel diferente de presencia y control.',

    heroCta:
      'COMPARAR PLANES',

    heroSecondary:
      'SOLICITAR EVALUACIÓN',

    packagesTopper:
      'NUESTROS PLANES',

    packagesTitle:
      'Tres niveles de gestión. Un único método de trabajo.',

    packagesText:
      'Todos los planes se basan en visitas documentadas y prevención. La diferencia está en la frecuencia, profundidad de la monitorización y nivel de coordinación incluido.',

    vat:
      'IVA incluido',

    year:
      'año',

    month:
      'mes',

    annualOnly:
      'Contrato anual',

    contract12:
      'Contrato de 12 meses',

    prepaid:
      'pagado por adelantado',

    save5:
      'ahorro 5%',

    saveMore5:
      'ahorro >5%',

    popular:
      'MÁS ELEGIDO',

    choose:
      'SOLICITAR EVALUACIÓN',

    onboardingLabel:
      'Alta de la Propiedad y Evaluación de Referencia',

    onboardingStandard:
      '99 € IVA incluido',

    launchOffer:
      'OFERTA DE LANZAMIENTO',

    launchFree:
      'GRATIS hasta el 31 de octubre de 2026',

    launchAfter:
      'Después de esta fecha: 99 € IVA incluido',

    basicShort:
      'Para propietarios que quieren una revisión mensual documentada y custodia segura de llaves.',

    smartShort:
      'Para propiedades desocupadas durante periodos más largos y propietarios que desean una monitorización preventiva más frecuente.',

    premiumShort:
      'Para propietarios que buscan monitorización preventiva junto con una gestión y coordinación local más completa.',

    basicFeatures: [
      '12 visitas programadas y documentadas / año',
      'Custodia segura de llaves',
      'Revisión de acceso y seguridad',
      'Revisiones básicas de agua, electricidad y AC',
      'Observación visual de humedad e infiltraciones',
      'Fotografías de contadores',
      'Informe digital tras cada visita',
      '1 revisión tras condiciones meteorológicas adversas / año',
    ],

    smartFeatures: [
      '24 presencias físicas / año',
      '12 visitas preventivas completas',
      '12 visitas de monitorización y ventilación asistida',
      'Monitorización de temperatura y humedad relativa',
      'Lecturas comparativas de referencia de humedad',
      'Revisión preventiva del aire acondicionado',
      'Monitorización de terraza y drenaje',
      '2 revisiones tras condiciones meteorológicas adversas / año',
      'Revisión trimestral de agua y energía',
    ],

    premiumFeatures: [
      '24 presencias físicas rutinarias / año',
      '4 revisiones ampliadas de la propiedad',
      'Revisión mensual de agua y energía',
      '4 revisiones tras condiciones meteorológicas adversas / año',
      '2 accesos y coordinaciones con técnicos',
      '2 preparaciones antes de la llegada',
      'Informe anual sobre el estado de la propiedad',
      'Coordinación prioritaria de incidencias',
      'Revisión administrativa mensual',
    ],

    methodTopper:
      'NUESTRO MÉTODO',

    methodTitle:
      'Medimos. Comparamos. Documentamos. Detectamos. Actuamos.',

    methodText:
      'No evaluamos una propiedad a partir de una única fotografía. Creamos un historial que nos ayuda a identificar cambios a lo largo del tiempo.',

    compareTopper:
      'COMPARACIÓN DETALLADA',

    compareTitle:
      'Mira exactamente qué incluye cada nivel.',

    compareText:
      'La siguiente tabla muestra las principales diferencias entre los tres planes.',

    tableService:
      'Servicio / revisión',

    onboardingTable:
      'Alta de la propiedad / evaluación inicial',

    onboardingFreeTable:
      'GRATIS*',

    compareFootnote:
      '* El Alta de la Propiedad y la Evaluación de Referencia son gratuitas para los tres planes hasta el 31 de octubre de 2026. Después de esta fecha: 99 € IVA incluido.',

    downloadTopper:
      'COMPARACIÓN COMPLETA',

    downloadTitle:
      'Guarda la tabla comparativa.',

    downloadText:
      'Descarga la versión PDF para comparar los planes, imprimirla o consultarla más adelante.',

    downloadButton:
      'DESCARGAR COMPARATIVA PDF',

    downloadHint:
      'PDF · optimizado para visualización e impresión',

    rows: [
      ['Visitas programadas', '12 / año', '24 / año', '24 / año'],
      ['Custodia segura de llaves', '✓', '✓', '✓'],
      ['Informe digital con fotografías', '✓', '✓', '✓'],
      ['Acceso y seguridad', '✓', '✓', '✓'],
      ['Agua / WC / desagües', 'Básico', 'Preventivo', 'Ampliado'],
      ['Cuadro eléctrico', 'Revisión visual', 'Revisión preventiva', 'Revisión ampliada'],
      ['Aire acondicionado', 'Funcional básico', 'Revisión preventiva', 'Revisión ampliada'],
      ['Temperatura y humedad relativa', '—', '✓', '✓'],
      ['Ventilación asistida', '—', '12 / año', '12 / año'],
      ['Lecturas comparativas de humedad', '—', '✓', '✓'],
      ['Fotografías de contadores', '✓', '✓', '✓'],
      ['Revisión consumo agua y energía', '—', 'Trimestral', 'Mensual'],
      ['Terraza / exterior', 'Visual', 'Preventivo', 'Ampliado'],
      ['Revisiones tras condiciones meteorológicas adversas', '1 / año', '2 / año', '4 / año'],
      ['Revisión administrativa', '—', 'Trimestral', 'Mensual'],
      ['Revisión ampliada de la propiedad', '—', '—', '4 / año'],
      ['Acceso y coordinación de técnicos', 'Bajo petición', 'Bajo petición', '2 / año'],
      ['Preparación antes de llegada', 'Bajo petición', 'Bajo petición', '2 / año'],
      ['Informe anual sobre el estado de la propiedad', '—', '—', '✓'],
    ],

    visitTopper:
      'QUÉ SIGNIFICA UNA VISITA',

    visitTitle:
      'Una visita es un proceso, no simplemente pasar por la propiedad.',

    visitIntro:
      'El contenido exacto depende del plan y de la configuración de la propiedad, pero cada visita sigue una estructura documentada.',

    visitSteps: [
      {
        number: '01',
        title: 'Acceso',
        text: 'Revisamos accesos, puertas, ventanas, persianas y cambios visibles.',
      },

      {
        number: '02',
        title: 'Suministros',
        text: 'Revisamos los puntos relevantes de agua, electricidad, instalaciones sanitarias y equipos incluidos en el plan.',
      },

      {
        number: '03',
        title: 'Clima interior',
        text: 'Observamos humedad, condensación e infiltraciones y, según el plan, monitorizamos temperatura y humedad relativa.',
      },

      {
        number: '04',
        title: 'Exterior',
        text: 'Revisamos terrazas, drenaje y zonas exteriores aplicables.',
      },

      {
        number: '05',
        title: 'Documentación',
        text: 'Registramos fotografías, observaciones y valores relevantes para el historial de la propiedad.',
      },
    ],

    onboardingTopper:
      'ANTES DE LA PRIMERA VISITA',

    onboardingTitle:
      'Alta de la Propiedad y Evaluación de Referencia',

    onboardingPrice:
      '99 €',

    onboardingVat:
      'IVA incluido',

    onboardingText:
      'Antes de iniciar la monitorización, realizamos una evaluación inicial para comprender la propiedad y crear el punto de referencia para las visitas posteriores.',

    onboardingItems: [
      'Recepción y registro del acceso y las llaves',
      'Identificación de las zonas y equipos relevantes',
      'Fotografías de referencia',
      'Lectura inicial de contadores, cuando sea posible',
      'Observaciones sobre el estado inicial',
      'Definición de las particularidades de la propiedad y del protocolo de acceso',
    ],

    addonsTopper:
      'SERVICIOS ADICIONALES',

    addonsTitle:
      '¿Necesitas algo más?',

    addonsText:
      'Los servicios adicionales están disponibles bajo petición y se presupuestan aparte según tiempo, desplazamiento y complejidad.',

    addonGroups: [
      {
        title: 'Cuidado de la Propiedad',
        items: [
          'Visita adicional',
          'Revisión adicional tras condiciones meteorológicas adversas',
          'Preparación adicional antes de llegada',
          'Revisión especial bajo petición',
        ],
      },

      {
        title: 'Acceso y Coordinación',
        items: [
          'Acceso adicional para técnico',
          'Espera / supervisión de intervención',
          'Entrega o recogida de llaves',
          'Coordinación local adicional',
        ],
      },

      {
        title: 'Servicios de Apoyo',
        items: [
          'Coordinación de limpieza',
          'Coordinación de lavandería',
          'Recogida / reenvío de correo',
          'Otras solicitudes acordadas individualmente',
        ],
      },
    ],

    excludedTopper:
      'TRANSPARENCIA',

    excludedTitle:
      'Qué no está incluido automáticamente',

    excluded: [
      'Reparaciones, materiales y piezas',
      'Mano de obra de técnicos o contratistas',
      'Limpieza y lavandería',
      'Compras y consumibles',
      'Traslados al aeropuerto',
      'Entrada / salida de huéspedes en alquileres',
      'Declaraciones fiscales o servicios jurídicos',
      'Intervención o coordinación ilimitada',
    ],

    sustainabilityTopper:
      'GESTIÓN RESPONSABLE',

    sustainabilityTitle:
      'Prevención, recursos y resiliencia.',

    sustainabilityText:
      'Integramos principios de desarrollo sostenible en la monitorización del agua y la energía, el mantenimiento preventivo y la colaboración con proveedores locales.',

    sustainabilityCta:
      'VER NUESTRO ENFOQUE DE SOSTENIBILIDAD',

    faqTopper:
      'PREGUNTAS SOBRE LOS PLANES',

    faqTitle:
      'Conviene saberlo antes de elegir.',

    faqs: [
      {
        q: '¿Cuál es la principal diferencia entre BASIC y SMART?',
        a: 'ECO-BASIC ofrece una visita documentada al mes. ECO-SMART duplica la presencia física y añade monitorización preventiva, ventilación asistida, seguimiento de temperatura y humedad y revisiones trimestrales de consumo.',
      },

      {
        q: '¿Por qué ECO-PREMIUM también tiene 24 presencias rutinarias?',
        a: 'La diferencia no es solo el número de visitas. PREMIUM añade revisiones ampliadas de la propiedad, revisiones mensuales de consumo y administración, más revisiones tras condiciones meteorológicas adversas, coordinación de técnicos, preparaciones antes de la llegada y un informe anual sobre el estado de la propiedad.',
      },

      {
        q: '¿Está incluido el onboarding en la suscripción?',
        a: 'El Alta de la Propiedad y la Evaluación de Referencia tienen un precio estándar de 99 € IVA incluido, independientemente del plan. Como oferta de lanzamiento, son gratuitas para todos los planes hasta el 31 de octubre de 2026.',
      },

      {
        q: '¿Puedo solicitar visitas adicionales?',
        a: 'Sí. Las visitas adicionales y revisiones especiales pueden contratarse por separado.',
      },

      {
        q: '¿Están incluidas las reparaciones?',
        a: 'No. Identificamos y documentamos el problema y podemos coordinar la intervención según el servicio contratado, pero los materiales y la mano de obra de terceros se facturan aparte.',
      },

      {
        q: '¿Qué ocurre si mi propiedad es muy grande o compleja?',
        a: 'Los precios publicados están pensados para propiedades con una configuración estándar. Propiedades muy grandes, con amplias zonas exteriores o instalaciones especiales pueden requerir un presupuesto personalizado.',
      },

      {
        q: '¿Tengo que elegir el plan por mi cuenta?',
        a: 'No. Cuéntanos cómo es la propiedad y cuánto tiempo suele permanecer desocupada y podremos recomendarte el nivel de monitorización adecuado.',
      },
    ],
};

/* =========================================================
   PACKAGE DATA
========================================================= */

const packages = [
  {
    id: 'eco-basic',
    name: 'ECO-BASIC',
    level: 'WATCH',
    priceMain: '649 €',
    priceUnit: `/${t.year}`,
    subprice: t.annualOnly,
    description: t.basicShort,
    features: t.basicFeatures,
    featured: false,
  },

  {
    id: 'eco-smart',
    name: 'ECO-SMART',
    level: 'PREVENT',
    priceMain: '125 €',
    priceUnit: `/${t.month}`,
    subprice: `${t.contract12} · 1.425 €/${t.year} ${t.prepaid} · ${t.save5}`,
    description: t.smartShort,
    features: t.smartFeatures,
    featured: true,
  },

  {
    id: 'eco-premium',
    name: 'ECO-PREMIUM',
    level: 'MANAGE',
    priceMain: '185 €',
    priceUnit: `/${t.month}`,
    subprice: `${t.contract12} · 2.099 €/${t.year} ${t.prepaid} · ${t.saveMore5}`,
    description: t.premiumShort,
    features: t.premiumFeatures,
    featured: false,
  },
];
---

<BaseLayout
  title={t.seoTitle}
  description={t.seoDescription}
>

  <Header slot="header" />


  <!-- =====================================================
       HERO
  ====================================================== -->

  <section
    class="
      bg-[#F7FAFA]
      border-b
      border-[#D8E1E5]
      font-heading
      py-14
      sm:py-16
      lg:py-20
    "
  >

    <div class="mx-auto max-w-site px-4 sm:px-6 lg:px-8">

      <div class="mx-auto max-w-4xl text-center">

        <div
          class="
            inline-flex
            flex-col
            sm:flex-row
            items-center
            gap-2
            sm:gap-3
            rounded-xl
            bg-[#0E3846]
            px-5
            py-3
            text-white
          "
        >
          <span class="text-xs sm:text-sm font-bold tracking-[0.1em]">
            {t.heroTopper}
          </span>

          <span class="hidden sm:inline text-[#D99B26]">
            •
          </span>

          <span class="text-xs sm:text-sm font-semibold">
            {t.heroLocation}
          </span>
        </div>


        <h1
          class="
            mt-7
            text-[36px]
            sm:text-5xl
            lg:text-[56px]
            font-bold
            tracking-tight
            leading-[1.08]
            text-[#0E3846]
          "
        >
          {t.heroTitle}
        </h1>


        <p
          class="
            mt-6
            mx-auto
            max-w-3xl
            text-base
            sm:text-lg
            leading-8
            text-[#526B74]
          "
        >
          {t.heroText}
        </p>


        <div
          class="
            mt-8
            flex
            flex-col
            sm:flex-row
            justify-center
            gap-3
          "
        >

          <a
            href="#comparacion"
            class="
              inline-flex
              min-h-[52px]
              items-center
              justify-center
              rounded-xl
              bg-[#0E3846]
              px-7
              py-3
              text-sm
              font-bold
              text-white
              transition
              hover:bg-[#164D5D]
            "
          >
            {t.heroCta}
          </a>


          <a
            href={r.contact}
            class="
              inline-flex
              min-h-[52px]
              items-center
              justify-center
              rounded-xl
              border-2
              border-[#0E3846]
              bg-white
              px-7
              py-3
              text-sm
              font-bold
              text-[#0E3846]
              transition
              hover:bg-[#EAF4F6]
            "
          >
            {t.heroSecondary}
          </a>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================================
       PACKAGES
  ====================================================== -->

  <section
    class="
      bg-white
      py-16
      sm:py-20
      font-heading
    "
  >

    <div class="mx-auto max-w-site px-4 sm:px-6 lg:px-8">

      <div class="mx-auto max-w-4xl text-center">

        <p
          class="
            text-sm
            font-bold
            uppercase
            tracking-[0.16em]
            text-[#D99B26]
          "
        >
          {t.packagesTopper}
        </p>


        <h2
          class="
            mt-3
            text-[30px]
            sm:text-4xl
            lg:text-[44px]
            font-bold
            tracking-tight
            leading-[1.15]
            text-[#0E3846]
          "
        >
          {t.packagesTitle}
        </h2>


        <p
          class="
            mt-5
            mx-auto
            max-w-3xl
            text-base
            sm:text-lg
            leading-8
            text-[#526B74]
          "
        >
          {t.packagesText}
        </p>

      </div>


      <div
        class="
          mt-12
          grid
          grid-cols-1
          lg:grid-cols-3
          gap-6
          lg:items-stretch
        "
      >

        {
          packages.map((pkg) => (

            <article
              id={pkg.id}
              class:list={[
                "relative",
                "flex",
                "flex-col",
                "rounded-2xl",
                "border",
                "p-6",
                "sm:p-7",
                "scroll-mt-28",

                pkg.featured
                  ? "border-[#5B9EB5] bg-[#F1F8FA] shadow-[0_16px_36px_rgba(14,56,70,0.13)] lg:-translate-y-2"
                  : "border-[#D2E0E4] bg-white shadow-[0_8px_24px_rgba(14,56,70,0.07)]",
              ]}
            >

              {pkg.featured && (

                <div
                  class="
                    absolute
                    -top-3
                    left-1/2
                    -translate-x-1/2
                    rounded-full
                    bg-[#5B9EB5]
                    px-4
                    py-1.5
                    text-[10px]
                    font-bold
                    uppercase
                    tracking-[0.12em]
                    text-white
                  "
                >
                  {t.popular}
                </div>

              )}


              <div>

                <p
                  class="
                    text-xs
                    font-bold
                    uppercase
                    tracking-[0.15em]
                    text-[#D99B26]
                  "
                >
                  {pkg.level}
                </p>

                <h3
                  class="
                    mt-2
                    text-2xl
                    font-bold
                    text-[#0E3846]
                  "
                >
                  {pkg.name}
                </h3>


                <p
                  class="
                    mt-4
                    min-h-[72px]
                    text-[15px]
                    leading-7
                    text-[#526B74]
                  "
                >
                  {pkg.description}
                </p>

              </div>


              <!-- PRICE -->

              <div
                class="
                  mt-6
                  border-y
                  border-[#D8E3E6]
                  py-5
                "
              >

                <div class="flex items-end gap-1.5">

                  <span
                    class="
                      text-[38px]
                      sm:text-[42px]
                      font-bold
                      tracking-tight
                      text-[#0E3846]
                    "
                  >
                    {pkg.priceMain}
                  </span>

                  <span
                    class="
                      pb-1.5
                      text-sm
                      font-semibold
                      text-[#6A838C]
                    "
                  >
                    {pkg.priceUnit}
                  </span>

                </div>


                <p
                  class="
                    mt-1
                    text-xs
                    leading-5
                    text-[#6A838C]
                  "
                >
                  {pkg.subprice}
                </p>


                <p
                  class="
                    mt-1
                    text-xs
                    font-semibold
                    text-[#0E3846]
                  "
                >
                  {t.vat}
                </p>

              </div>


              <!-- FEATURES -->

              <ul class="mt-6 space-y-3 flex-1">

                {pkg.features.map((feature) => (

                  <li
                    class="
                      flex
                      items-start
                      gap-3
                      text-[14px]
                      leading-6
                      text-[#405963]
                    "
                  >

                    <span
                      class="
                        mt-1
                        flex
                        h-5
                        w-5
                        shrink-0
                        items-center
                        justify-center
                        rounded-full
                        bg-[#E5F2F5]
                        text-[#0E3846]
                      "
                    >
                      ✓
                    </span>

                    <span>{feature}</span>

                  </li>

                ))}

              </ul>


              <!-- =================================================
                   ONBOARDING PRICE / LAUNCH OFFER
              ================================================== -->

              <div
                class="
                  mt-7
                  rounded-xl
                  border
                  border-[#E5C16D]
                  bg-[#FFF9ED]
                  p-4
                "
              >

                <p
                  class="
                    text-[11px]
                    font-bold
                    uppercase
                    tracking-[0.1em]
                    text-[#0E3846]
                  "
                >
                  {t.onboardingLabel}
                </p>


                <div
                  class="
                    mt-2
                    flex
                    items-center
                    justify-between
                    gap-3
                  "
                >

                  <span
                    class="
                      text-sm
                      font-semibold
                      text-[#6A838C]
                      line-through
                    "
                  >
                    {t.onboardingStandard}
                  </span>


                  <span
                    class="
                      rounded-full
                      bg-[#D99B26]
                      px-3
                      py-1
                      text-[10px]
                      font-bold
                      uppercase
                      tracking-[0.05em]
                      text-[#0E3846]
                    "
                  >
                    {t.launchOffer}
                  </span>

                </div>


                <p
                  class="
                    mt-3
                    text-[14px]
                    font-bold
                    leading-5
                    text-[#0E3846]
                  "
                >
                  {t.launchFree}
                </p>

              </div>


              <!-- CTA -->

              <a
                href={r.contact}
                class:list={[
                  "mt-6",
                  "inline-flex",
                  "min-h-[52px]",
                  "items-center",
                  "justify-center",
                  "rounded-xl",
                  "px-5",
                  "py-3",
                  "text-center",
                  "text-sm",
                  "font-bold",
                  "transition",

                  pkg.featured
                    ? "bg-[#0E3846] text-white hover:bg-[#164D5D]"
                    : "border-2 border-[#0E3846] text-[#0E3846] hover:bg-[#EAF4F6]",
                ]}
              >
                {t.choose}
              </a>

            </article>

          ))
        }

      </div>

    </div>

  </section>


  <!-- =====================================================
       METHOD
  ====================================================== -->

  <section
    class="
      bg-[#0E3846]
      py-10
      sm:py-12
      font-heading
    "
  >

    <div
      class="
        mx-auto
        max-w-site
        px-4
        sm:px-6
        lg:px-8
        text-center
      "
    >

      <p
        class="
          text-xs
          font-bold
          uppercase
          tracking-[0.16em]
          text-[#F3C76B]
        "
      >
        {t.methodTopper}
      </p>


      <h2
        class="
          mt-3
          text-2xl
          sm:text-3xl
          font-bold
