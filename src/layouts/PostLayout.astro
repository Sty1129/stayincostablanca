---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTA from '../components/CTA.astro';
import { brand } from '../config/brand';


/* =========================================================
   PROPS
========================================================= */

interface Props {
  title: string;
  description: string;
  date: Date;
  author?: string;
}

const {
  title,
  description,
  date,
  author = 'Stay in Costa Blanca',
} = Astro.props;


/* =========================================================
   LANGUAGE
========================================================= */

const currentLang = Astro.currentLocale || 'ro';

const lang =
  currentLang === 'en' || currentLang === 'es'
    ? currentLang
    : 'ro';


/* =========================================================
   TRANSLATIONS
========================================================= */

const translations = {
  ro: {
    home: 'Acasă',
    blog: 'Blog',

    category:
      'GHIDURI & RESURSE',

    published:
      'Publicat',

    by:
      'de',

    back:
      'ÎNAPOI LA BLOG',

    helpful:
      'Informații practice pentru proprietarii din Costa Blanca.',

    dateLocale:
      'ro-RO',

    homeHref:
      '/',

    blogHref:
      '/blog',
  },


  en: {
    home: 'Home',
    blog: 'Blog',

    category:
      'GUIDES & RESOURCES',

    published:
      'Published',

    by:
      'by',

    back:
      'BACK TO BLOG',

    helpful:
      'Practical information for property owners in Costa Blanca.',

    dateLocale:
      'en-GB',

    homeHref:
      '/en/',

    blogHref:
      '/en/blog',
  },


  es: {
    home: 'Inicio',
    blog: 'Blog',

    category:
      'GUÍAS & RECURSOS',

    published:
      'Publicado',

    by:
      'por',

    back:
      'VOLVER AL BLOG',

    helpful:
      'Información práctica para propietarios en Costa Blanca.',

    dateLocale:
      'es-ES',

    homeHref:
      '/es/',

    blogHref:
      '/es/blog',
  },
};

const t = translations[lang];


/* =========================================================
   DATE
========================================================= */

const formattedDate =
  date.toLocaleDateString(
    t.dateLocale,
    {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }
  );
---

<BaseLayout
  title={`${title} | ${brand.name}`}
  description={description}
>

  <Header slot="header" />


  <main>

    <!-- =====================================================
         ARTICLE HERO
    ====================================================== -->

    <section
      class="
        relative
        overflow-hidden
        bg-[#0E3846]
        py-12
        sm:py-16
        lg:py-20
        font-heading
      "
    >

      <!-- DECORATIVE ELEMENTS -->

      <div
        class="
          pointer-events-none
          absolute
          -right-28
          -top-28
          h-80
          w-80
          rounded-full
          bg-[#5B9EB5]/20
          blur-3xl
        "
      ></div>

      <div
        class="
          pointer-events-none
          absolute
          -bottom-32
          -left-24
          h-72
          w-72
          rounded-full
          bg-[#D99B26]/10
          blur-3xl
        "
      ></div>


      <div
        class="
          relative
          mx-auto
          max-w-site
          px-4
          sm:px-6
          lg:px-8
        "
      >

        <div
          class="
            mx-auto
            max-w-4xl
          "
        >

          <!-- =================================================
               BREADCRUMB
          ================================================== -->

          <nav
            aria-label="Breadcrumb"
            class="mb-7"
          >

            <ol
              class="
                flex
                flex-wrap
                items-center
                gap-2
                text-xs
                sm:text-sm
                font-medium
                text-[#B8D1D8]
              "
            >

              <li>
                <a
                  href={t.homeHref}
                  class="
                    transition-colors
                    hover:text-white
                  "
                >
                  {t.home}
                </a>
              </li>


              <li
                class="
                  flex
                  items-center
                  gap-2
                "
              >

                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  class="
                    h-3.5
                    w-3.5
                    text-[#D99B26]
                  "
                  aria-hidden="true"
                >
                  <path
                    d="M9 5l7 7-7 7"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>


                <a
                  href={t.blogHref}
                  class="
                    transition-colors
                    hover:text-white
                  "
                >
                  {t.blog}
                </a>

              </li>

            </ol>

          </nav>


          <!-- =================================================
               CATEGORY
          ================================================== -->

          <p
            class="
              text-xs
              sm:text-sm
              font-bold
              uppercase
              tracking-[0.17em]
              text-[#F3C76B]
            "
          >
            {t.category}
          </p>


          <!-- =================================================
               TITLE
          ================================================== -->

          <h1
            class="
              mt-4
              max-w-4xl

              text-[34px]
              sm:text-[44px]
              lg:text-[54px]

              font-bold
              leading-[1.09]
              tracking-tight

              text-white
            "
          >
            {title}
          </h1>


          <!-- =================================================
               DESCRIPTION
          ================================================== -->

          {
            description && (

              <p
                class="
                  mt-6
                  max-w-3xl

                  text-base
                  sm:text-lg

                  leading-8

                  text-[#C9DDE2]
                "
              >
                {description}
              </p>

            )
          }


          <!-- =================================================
               META
          ================================================== -->

          <div
            class="
              mt-7

              flex
              flex-wrap
              items-center

              gap-x-4
              gap-y-2

              border-t
              border-white/10

              pt-5

              text-sm
              text-[#B8D1D8]
            "
          >

            <div
              class="
                flex
                items-center
                gap-2
              "
            >

              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                class="
                  h-4
                  w-4
                  text-[#F3C76B]
                "
                aria-hidden="true"
              >
                <rect
                  x="4"
                  y="5"
                  width="16"
                  height="15"
                  rx="2"
                  stroke-width="1.7"
                />

                <path
                  d="M8 3v4M16 3v4M4 10h16"
                  stroke-width="1.7"
                  stroke-linecap="round"
                />
              </svg>


              <span>
                {t.published}
              </span>


              <time
                datetime={date.toISOString()}
                class="
                  font-semibold
                  text-white
                "
              >
                {formattedDate}
              </time>

            </div>


            <span
              class="
                hidden
                sm:inline
                h-1
                w-1
                rounded-full
                bg-[#D99B26]
              "
            ></span>


            <div>
              {t.by}
              <span
                class="
                  ml-1
                  font-semibold
                  text-white
                "
              >
                {author}
              </span>
            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- =====================================================
         ARTICLE
    ====================================================== -->

    <section
      class="
        bg-white
        py-12
        sm:py-16
        lg:py-20
        font-heading
      "
    >

      <div
        class="
          mx-auto
          max-w-site
          px-4
          sm:px-6
          lg:px-8
        "
      >

        <div
          class="
            mx-auto
            grid
            max-w-5xl

            grid-cols-1

            lg:grid-cols-[minmax(0,1fr)_220px]

            gap-12
            lg:gap-16

            items-start
          "
        >

          <!-- =================================================
               CONTENT
          ================================================== -->

          <article
            class="
              post-content
              min-w-0

              text-[17px]
              leading-[1.8]
              text-[#405963]
            "
          >
            <slot />
          </article>


          <!-- =================================================
               SIDE INFO
          ================================================== -->

          <aside
            class="
              hidden
              lg:block
              sticky
              top-28
            "
          >

            <div
              class="
                rounded-2xl

                border
                border-[#D2E1E5]

                bg-[#F7FAFA]

                p-5
              "
            >

              <div
                class="
                  flex
                  h-10
                  w-10
                  items-center
                  justify-center

                  rounded-full

                  bg-[#E3F0F3]

                  text-[#0E3846]
                "
              >

                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  class="h-5 w-5"
                  aria-hidden="true"
                >
                  <path
                    d="M5 4h10l4 4v12H5z"
                    stroke-width="1.7"
                    stroke-linejoin="round"
                  />

                  <path
                    d="M15 4v5h5M8 13h8M8 16h6"
                    stroke-width="1.7"
                    stroke-linecap="round"
                  />
                </svg>

              </div>


              <p
                class="
                  mt-4

                  text-xs
                  font-bold
                  uppercase
                  tracking-[0.14em]

                  text-[#D99B26]
                "
              >
                {t.blog}
              </p>


              <p
                class="
                  mt-2

                  text-sm
                  leading-6

                  text-[#526B74]
                "
              >
                {t.helpful}
              </p>


              <a
                href={t.blogHref}

                class="
                  mt-5

                  inline-flex
                  items-center
                  gap-2

                  text-sm
                  font-bold

                  text-[#0E3846]

                  transition-colors

                  hover:text-[#397C92]
                "
              >

                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  class="h-4 w-4"
                  aria-hidden="true"
                >
                  <path
                    d="M19 12H5m5-5l-5 5 5 5"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>

                {t.back}

              </a>

            </div>

          </aside>

        </div>


        <!-- =================================================
             BACK BUTTON MOBILE + DESKTOP
        ================================================== -->

        <div
          class="
            mx-auto
            mt-12
            max-w-5xl

            border-t
            border-[#D9E4E7]

            pt-7
          "
        >

          <a
            href={t.blogHref}

            class="
              inline-flex
              min-h-[48px]

              items-center
              justify-center

              gap-2.5

              rounded-xl

              border-2
              border-[#0E3846]

              bg-white

              px-5
              py-2.5

              text-sm
              font-bold

              text-[#0E3846]

              transition-all

              hover:bg-[#0E3846]
              hover:text-white
            "
          >

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              class="h-4 w-4"
              aria-hidden="true"
            >
              <path
                d="M19 12H5m5-5l-5 5 5 5"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>

            {t.back}

          </a>

        </div>

      </div>

    </section>


    <!-- =====================================================
         CTA
    ====================================================== -->

    <CTA />

  </main>


  <Footer slot="footer" />

</BaseLayout>


<!-- =========================================================
     MARKDOWN / BLOG CONTENT STYLING
========================================================= -->

<style is:global>

  .post-content > :first-child {
    margin-top: 0;
  }


  /* =======================================================
     PARAGRAPHS
  ======================================================= */

  .post-content p {
    margin-top: 1.35rem;
    margin-bottom: 1.35rem;
  }


  /* =======================================================
     HEADINGS
  ======================================================= */

  .post-content h2 {
    margin-top: 3.25rem;
    margin-bottom: 1.1rem;

    font-family: inherit;

    font-size: 1.75rem;
    line-height: 1.25;

    font-weight: 700;

    letter-spacing: -0.02em;

    color: #0E3846;
  }


  .post-content h3 {
    margin-top: 2.5rem;
    margin-bottom: 0.9rem;

    font-family: inherit;

    font-size: 1.35rem;
    line-height: 1.35;

    font-weight: 700;

    color: #0E3846;
  }


  .post-content h4 {
    margin-top: 2rem;
    margin-bottom: 0.75rem;

    font-size: 1.1rem;
    line-height: 1.4;

    font-weight: 700;

    color: #294A55;
  }


  /* =======================================================
     STRONG
  ======================================================= */

  .post-content strong {
    font-weight: 700;
    color: #173F4C;
  }


  /* =======================================================
     LINKS
  ======================================================= */

  .post-content a {
    color: #397C92;

    font-weight: 600;

    text-decoration: underline;
    text-decoration-color: #9FC9D4;
    text-underline-offset: 3px;

    transition:
      color 150ms ease,
      text-decoration-color 150ms ease;
  }


  .post-content a:hover {
    color: #0E3846;
    text-decoration-color: #D99B26;
  }


  /* =======================================================
     LISTS
  ======================================================= */

  .post-content ul,
  .post-content ol {
    margin-top: 1.4rem;
    margin-bottom: 1.6rem;

    padding-left: 1.4rem;
  }


  .post-content ul {
    list-style: none;
    padding-left: 0;
  }


  .post-content ul li {
    position: relative;

    margin-top: 0.7rem;

    padding-left: 1.65rem;
  }


  .post-content ul li::before {
    content: "";

    position: absolute;

    left: 0;
    top: 0.72em;

    width: 7px;
    height: 7px;

    border-radius: 999px;

    background: #D99B26;
  }


  .post-content ol {
    list-style: decimal;

    padding-left: 1.7rem;
  }


  .post-content ol li {
    margin-top: 0.7rem;

    padding-left: 0.25rem;
  }


  .post-content li::marker {
    color: #D99B26;
    font-weight: 700;
  }


  /* =======================================================
     BLOCKQUOTE
  ======================================================= */

  .post-content blockquote {
    margin-top: 2.25rem;
    margin-bottom: 2.25rem;

    border-left: 4px solid #D99B26;

    border-radius: 0 12px 12px 0;

    background: #F7FAFA;

    padding: 1.25rem 1.5rem;

    font-size: 1.05rem;
    line-height: 1.75;

    font-style: normal;

    color: #294A55;
  }


  .post-content blockquote p {
    margin: 0;
  }


  /* =======================================================
     HORIZONTAL RULE
  ======================================================= */

  .post-content hr {
    margin-top: 3rem;
    margin-bottom: 3rem;

    border: 0;
    border-top: 1px solid #D6E2E5;
  }


  /* =======================================================
     IMAGES
  ======================================================= */

  .post-content img {
    display: block;

    width: 100%;
    height: auto;

    margin-top: 2.3rem;
    margin-bottom: 2.3rem;

    border-radius: 18px;

    box-shadow:
      0 10px 30px rgba(14, 56, 70, 0.09);
  }


  /* =======================================================
     FIGURE
  ======================================================= */

  .post-content figure {
    margin-top: 2.3rem;
    margin-bottom: 2.3rem;
  }


  .post-content figure img {
    margin: 0;
  }


  .post-content figcaption {
    margin-top: 0.75rem;

    text-align: center;

    font-size: 0.82rem;
    line-height: 1.5;

    color: #71868D;
  }


  /* =======================================================
     TABLE
  ======================================================= */

  .post-content table {
    width: 100%;

    margin-top: 2.3rem;
    margin-bottom: 2.3rem;

    border-collapse: collapse;

    overflow: hidden;

    border: 1px solid #D3E1E5;

    border-radius: 12px;

    font-size: 0.92rem;
  }


  .post-content th {
    background: #0E3846;

    padding: 0.85rem 1rem;

    text-align: left;

    font-weight: 700;

    color: white;
  }


  .post-content td {
    border-top: 1px solid #DEE8EA;

    padding: 0.8rem 1rem;

    color: #405963;
  }


  .post-content tr:nth-child(even) td {
    background: #F8FBFB;
  }


  /* =======================================================
     INLINE CODE
  ======================================================= */

  .post-content code {
    border-radius: 5px;

    background: #EAF2F4;

    padding: 0.15rem 0.35rem;

    font-size: 0.9em;

    color: #0E3846;
  }


  /* =======================================================
     CODE BLOCK
  ======================================================= */

  .post-content pre {
    overflow-x: auto;

    margin-top: 2rem;
    margin-bottom: 2rem;

    border-radius: 14px;

    background: #0E3846;

    padding: 1.25rem;

    color: #F2EFE9;
  }


  .post-content pre code {
    background: transparent;

    padding: 0;

    color: inherit;
  }


  /* =======================================================
     MOBILE
  ======================================================= */

  @media (max-width: 639px) {

    .post-content {
      font-size: 16px;
      line-height: 1.78;
    }


    .post-content h2 {
      margin-top: 2.6rem;
      font-size: 1.55rem;
    }


    .post-content h3 {
      margin-top: 2.2rem;
      font-size: 1.25rem;
    }


    .post-content table {
      display: block;
      overflow-x: auto;
      white-space: nowrap;
    }

  }

</style>
